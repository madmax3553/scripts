# Dotfiles Config Management
# ─────────────────────────────────────────────────────────────────────────────

DOTFILES_CONFIG_FILE="${CONFIG_DIR}/dotfiles-custom-files"

dotfiles_load_config() {
    if [ -f "$DOTFILES_CONFIG_FILE" ]; then
        DOTFILES_CUSTOM_FILES=()
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [ -z "$line" ] || [[ "$line" == \#* ]] && continue
            DOTFILES_CUSTOM_FILES+=("$line")
        done <"$DOTFILES_CONFIG_FILE"
    fi
}

dotfiles_save_config() {
    mkdir -p "$CONFIG_DIR"
    {
        echo "# Dotfiles custom files (per-host customizations)"
        echo "# One path per line, relative to dotfiles repo root"
        echo ""
        for file in "${DOTFILES_CUSTOM_FILES[@]}"; do
            echo "$file"
        done
    } >"$DOTFILES_CONFIG_FILE"
}

show_dotfiles_config_menu() {
    local editor="${EDITOR:-nano}"

    clear
    printf 'Edit custom dotfiles list\n'
    printf 'Config file: %s\n' "$DOTFILES_CONFIG_FILE"
    printf '\nOne path per line, relative to dotfiles root.\n'
    printf 'Lines starting with # are comments.\n'
    printf '\nOpening %s...\n' "$editor"
    sleep 1

    mkdir -p "$CONFIG_DIR"

    # Create default config if doesn't exist
    if [ ! -f "$DOTFILES_CONFIG_FILE" ]; then
        dotfiles_save_config
    fi

    # Open editor
    "$editor" "$DOTFILES_CONFIG_FILE"

    # Reload config
    dotfiles_load_config

    printf '\n✓ Config updated\n'
    pause_for_user
    rescan
}

show_dotfiles_hosts() {
    local host_map_file="$CONFIG_DIR/dotfiles-hosts"

    clear
    printf 'Dotfiles Host to Branch Mapping\n'
    printf 'File: %s\n\n' "$host_map_file"

    if [ ! -f "$host_map_file" ]; then
        printf '  (No hosts mapped yet - run sync to create)\n'
    else
        printf '  HOST            BRANCH\n'
        printf '  ─────────────── ────────────────\n'
        while IFS=: read -r host branch; do
            printf '  %-15s %s\n' "$host" "$branch"
        done <"$host_map_file"
    fi

    printf '\n'
    pause_for_user
}

fetch_all_repos() {
    local total=${#paths[@]}
    local current=0

    for i in "${!paths[@]}"; do
        repo_path="${paths[$i]}"
        repo_name=$(basename "$repo_path")
        current=$((current + 1))

        if [ "$JSON_MODE" -eq 0 ]; then
            printf '[%d/%d] Fetching %s\n' "$current" "$total" "$repo_name" >&2
        fi

        set +e
        output=$(git -C "$repo_path" fetch --quiet 2>&1)
        exit_code=$?
        set -e
        if [ $exit_code -ne 0 ]; then
            statuses[$i]="fetch_failed"
            fetch_error_msgs[$i]="$output"
            {
                echo "[$(date --iso-8601=seconds)] ${repo_path}"
                echo "$output"
                echo ""
            } >>"$FETCH_LOG"
        fi
    done
}

normalize_exclude() {
    local exclude="$1"

    if [ "$exclude" = "~" ]; then
        echo "$HOME"
    elif [[ "$exclude" == "~/"* ]]; then
        echo "$HOME/${exclude#~/}"
    else
        echo "$exclude"
    fi
}

load_user_excludes() {
    USER_EXCLUDE_DIRS=()

    if [ ! -f "$EXCLUDES_FILE" ]; then
        return
    fi

    local line
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        if [ -z "$line" ] || [[ "$line" == \#* ]]; then
            continue
        fi

        USER_EXCLUDE_DIRS+=("$(normalize_exclude "$line")")
    done <"$EXCLUDES_FILE"
}

exclude_exists() {
    local exclude="$1"
    local existing

    for existing in "${EXCLUDE_DIRS[@]}" "${USER_EXCLUDE_DIRS[@]}"; do
        if [ "$existing" = "$exclude" ]; then
            return 0
        fi
    done

    return 1
}

add_user_exclude() {
    local exclude
    exclude="$(normalize_exclude "$1")"
    exclude="${exclude#"${exclude%%[![:space:]]*}"}"
    exclude="${exclude%"${exclude##*[![:space:]]}"}"

    if [ -z "$exclude" ]; then
        return 1
    fi

    if exclude_exists "$exclude"; then
        return 2
    fi

    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$exclude" >>"$EXCLUDES_FILE"
    USER_EXCLUDE_DIRS+=("$exclude")
}

remove_user_exclude() {
    local remove_index="$1"
    local new_excludes=()
    local i

    mkdir -p "$CONFIG_DIR"
    : >"$EXCLUDES_FILE"

    for i in "${!USER_EXCLUDE_DIRS[@]}"; do
        if [ "$i" -ne "$remove_index" ]; then
            printf '%s\n' "${USER_EXCLUDE_DIRS[$i]}" >>"$EXCLUDES_FILE"
            new_excludes+=("${USER_EXCLUDE_DIRS[$i]}")
        fi
    done

    USER_EXCLUDE_DIRS=("${new_excludes[@]}")
}

build_find_args() {
    FIND_ARGS=("$HOME")

    local exclude
    for exclude in "${EXCLUDE_DIRS[@]}" "${USER_EXCLUDE_DIRS[@]}"; do
        if [ -z "$exclude" ]; then
            continue
        fi

        if [[ "$exclude" = /* ]]; then
            FIND_ARGS+=(-path "$exclude" -prune -o)
        else
            FIND_ARGS+=(-path "*/$exclude" -prune -o)
        fi
    done

    FIND_ARGS+=(-name ".git" -type d -prune -print0)
}

is_valid_git_repo() {
    local repo_dir="$1"
    local repo_real
    local top_level
    local top_real

    top_level=$(git -C "$repo_dir" rev-parse --show-toplevel 2>/dev/null) || return 1
    repo_real=$(cd "$repo_dir" && pwd -P)
    top_real=$(cd "$top_level" && pwd -P)

    [ "$repo_real" = "$top_real" ]
}

emit_empty_json_summary() {
    echo '{"overall_status": "clean", "status_counts": {"clean": 0, "dirty": 0, "ahead": 0, "behind": 0, "diverged": 0, "uninitialized": 0, "fetch_failed": 0}, "repos": []}'
}

# Find all git repositories in home directory

declare -a repos
declare -a statuses
declare -a paths
declare -a fetch_error_msgs
declare -a invalid_git_dirs
declare -a invalid_repo_paths
declare -a invalid_reasons
declare -a USER_EXCLUDE_DIRS
declare -a FIND_ARGS

# Directories to exclude
EXCLUDE_DIRS=(
    ".gemini"
    ".nimble"
    ".local"
    ".cache"
    ".codex"
    ".xmake"
    ".cargo"
    ".npm"
    ".nvm"
    ".rustup"
    "node_modules"
    ".venv"
    "venv"
    ".virtualenv"
)

load_user_excludes
build_find_args
dotfiles_load_config

# Check if we should run in JSON mode (will be handled after repo scan)
JSON_MODE=0
if [ "$FIRST_ARG" = "--json-summary" ]; then
    JSON_MODE=1
fi

# Check for sync mode (handle separately from JSON)
if [ "$FIRST_ARG" = "--sync" ] || [ "$FIRST_ARG" = "-s" ]; then
    # Need to scan repos first
    :
fi

# Check for commit mode
COMMIT_MODE=0
COMMIT_TARGET=""
if [ "$FIRST_ARG" = "--commit" ]; then
    COMMIT_MODE=1
    COMMIT_TARGET="$SECOND_ARG"
fi

# Check for dotfiles sync mode
DOTFILES_MODE=0
DOTFILES_DIR="${HOME}/dotfiles"
if [ "$FIRST_ARG" = "--dotfiles" ]; then
    DOTFILES_MODE=1
fi

INTERACTIVE_MODE=1
if [ "$JSON_MODE" -eq 1 ] || [ "$FIRST_ARG" = "--sync" ] || [ "$FIRST_ARG" = "-s" ] || [ "$COMMIT_MODE" -eq 1 ] || [ "$DOTFILES_MODE" -eq 1 ]; then
    INTERACTIVE_MODE=0
fi

if [ "$INTERACTIVE_MODE" -eq 1 ] && ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive mode." >&2
    exit 1
fi

# Handle dotfiles sync mode early (before repo scan)
if [ "$DOTFILES_MODE" -eq 1 ]; then
    if [ ! -d "$DOTFILES_DIR" ]; then
        printf 'Dotfiles directory not found: %s\n' "$DOTFILES_DIR" >&2
        exit 1
    fi
    sync_dotfiles "$DOTFILES_DIR"
    exit 0
fi

if [ "$JSON_MODE" -eq 0 ]; then
    printf 'Scanning for git repositories...\n' >&2
fi

# First pass: find all repos (fast)
declare -a git_dirs
while IFS= read -r -d '' git_dir; do
    git_dirs+=("$git_dir")
done < <(find "${FIND_ARGS[@]}" 2>/dev/null)

NO_VALID_REPOS=0
total_repos=${#git_dirs[@]}

if [ "$total_repos" -eq 0 ]; then
    if [ "$JSON_MODE" -eq 1 ]; then
        emit_empty_json_summary
        exit 0
    elif [ "$INTERACTIVE_MODE" -eq 0 ]; then
        echo "No git repositories found in home directory."
        exit 0
    else
        NO_VALID_REPOS=1
    fi
fi

# Second pass: get status for each repo with progress
current=0
for git_dir in "${git_dirs[@]}"; do
    repo_dir=$(dirname "$git_dir")
    repo_name=$(basename "$repo_dir")
    current=$((current + 1))

    if [ "$JSON_MODE" -eq 0 ]; then
        printf '[%d/%d] Checking %s\n' "$current" "$total_repos" "$repo_name" >&2
    fi

    # Skip if inside another git repo
    if [[ "$repo_dir" == *"/.git/"* ]]; then
        continue
    fi

    if ! is_valid_git_repo "$repo_dir"; then
        invalid_git_dirs+=("$git_dir")
        invalid_repo_paths+=("$repo_dir")
        invalid_reasons+=("git rev-parse --show-toplevel failed or did not match this directory")
        continue
    fi

    status=$(get_repo_status "$repo_dir")

    repos+=("$repo_name")
    statuses+=("$status")
    paths+=("$repo_dir")
done

if [ ${#repos[@]} -eq 0 ]; then
    if [ "$JSON_MODE" -eq 1 ]; then
        emit_empty_json_summary
        exit 0
    elif [ "$INTERACTIVE_MODE" -eq 0 ]; then
        echo "No valid git repositories found in home directory."
        exit 0
    else
        NO_VALID_REPOS=1
    fi
fi

should_fetch=1
if [ "$DISABLE_FETCH" -eq 1 ]; then
    should_fetch=0
elif [ "$FORCE_FETCH" -eq 0 ] && [ "$FETCH_INTERVAL" -gt 0 ] && [ -f "$LAST_FETCH_FILE" ]; then
    now=$(date +%s)
    last_fetch=$(cat "$LAST_FETCH_FILE" 2>/dev/null || echo 0)
    if [ $((now - last_fetch)) -lt "$FETCH_INTERVAL" ]; then
        should_fetch=0
    fi
fi

if [ "$NO_VALID_REPOS" -eq 0 ] && [ "$should_fetch" -eq 1 ]; then
    fetch_all_repos
    date +%s >"$LAST_FETCH_FILE"
fi

# Handle JSON mode output
if [ "$JSON_MODE" -eq 1 ]; then
    overall_status=$(get_worst_status "${statuses[@]}")

    declare -A status_counts=(
        [clean]=0
        [dirty]=0
        [ahead]=0
        [behind]=0
        [diverged]=0
        [uninitialized]=0
        [fetch_failed]=0
    )
    for status in "${statuses[@]}"; do
        if [ -n "$status" ]; then
            status_counts[$status]=$((${status_counts[$status]} + 1))
        fi
    done

    json_output="{\"overall_status\": \"$overall_status\", \"status_counts\": {\"clean\": ${status_counts[clean]}, \"dirty\": ${status_counts[dirty]}, \"ahead\": ${status_counts[ahead]}, \"behind\": ${status_counts[behind]}, \"diverged\": ${status_counts[diverged]}, \"uninitialized\": ${status_counts[uninitialized]}, \"fetch_failed\": ${status_counts[fetch_failed]}}, \"repos\": ["

    first=true
    for i in "${!repos[@]}"; do
        if [ "${statuses[$i]}" != "clean" ]; then
            if [ "$first" = true ]; then
                first=false
            else
                json_output="$json_output,"
            fi

            repo_name_escaped=$(echo "${repos[$i]}" | sed 's/"/\\"/g')
            repo_path_escaped=$(echo "${paths[$i]}" | sed 's/"/\\"/g')

            json_output="$json_output{\"name\": \"$repo_name_escaped\", \"path\": \"$repo_path_escaped\", \"status\": \"${statuses[$i]}\"}"
        fi
    done

    json_output="$json_output]}"

    echo "$json_output"
    exit 0
fi

# Handle sync mode
if [ "$FIRST_ARG" = "--sync" ] || [ "$FIRST_ARG" = "-s" ]; then
    sync_repos "${paths[@]}"
    exit 0
fi

# Handle commit mode
if [ "$COMMIT_MODE" -eq 1 ]; then
    if [ -z "$COMMIT_TARGET" ] || [ "$COMMIT_TARGET" = "dirty" ]; then
        # Commit all dirty repos
        declare -a dirty_repos
        for i in "${!statuses[@]}"; do
            if [ "${statuses[$i]}" = "dirty" ]; then
                dirty_repos+=("${paths[$i]}")
            fi
        done

        if [ ${#dirty_repos[@]} -eq 0 ]; then
            echo "No dirty repositories found."
            exit 0
        fi

        commit_repos "${dirty_repos[@]}"
    else
        # Commit specific repo
        for i in "${!repos[@]}"; do
            if [ "${repos[$i]}" = "$COMMIT_TARGET" ]; then
                commit_repos "${paths[$i]}"
                exit 0
            fi
        done
        echo "Repository not found: $COMMIT_TARGET"
        exit 1
    fi
    exit 0
fi

declare -A dir_repos
declare -A dir_statuses

for i in "${!repos[@]}"; do
    parent=$(get_parent_dir "${paths[$i]}")

    if [ -z "${dir_repos[$parent]:-}" ]; then
        dir_repos[$parent]="$i"
        dir_statuses[$parent]="${statuses[$i]}"
    else
        dir_repos[$parent]="${dir_repos[$parent]},$i"
        current_worst="${dir_statuses[$parent]}"
        new_worst=$(get_worst_status "$current_worst" "${statuses[$i]}")
        dir_statuses[$parent]="$new_worst"
    fi
done

pause_for_user() {
    printf '\nPress Enter to continue...'
    read -r _ || true
}

confirm_yes_no() {
    local prompt="$1"
    local answer

    printf '%s [y/N] ' "$prompt"
    read -r answer || return 1
    [[ "$answer" =~ ^([Yy]|[Yy][Ee][Ss])$ ]]
}

rescan() {
    exec "$SCRIPT_PATH" "${ORIGINAL_ARGS[@]}"
}

run_and_rescan() {
    clear
    "$@"
    pause_for_user
    rescan
}

open_repo() {
    local repo_path="$1"

    clear
    cd "$repo_path" || exit 1

    if command -v lazygit >/dev/null 2>&1; then
        lazygit
    else
        printf 'lazygit not found. Showing git status instead.\n\n'
        git status --short --branch
        pause_for_user
    fi

    rescan
}

show_legend() {
    clear
    cat <<EOF
Status Legend

$CLEAN  Clean - No uncommitted changes, up to date with remote
$DIRTY  Dirty - Has uncommitted changes or untracked files
$AHEAD  Ahead - Local commits not pushed to remote
$BEHIND  Behind - Remote has commits not pulled locally
$DIVERGED  Diverged - Both local and remote have new commits
$UNINITIALIZED  Uninitialized - No remote branches configured
$FETCH_FAILED  Fetch Failed - Could not reach remote
EOF
    pause_for_user
}

build_main_items() {
    local group
    local group_indices
    local group_list=()
    local icon
    local repo_count
    local display

    if [ "${#paths[@]}" -gt 0 ]; then
        printf 'action\tsync_all\t🔄  Sync all repos\t-\t-\n'
        printf 'action\tcommit_dirty\t💾  Commit all dirty repos\t-\t-\n'
    fi

    if [ -d "$HOME/dotfiles" ]; then
        printf 'action\tdotfiles\t📦  Sync dotfiles (host-specific)\t-\t-\n'
        printf 'action\tdotfiles_hosts\t🖥  View host→branch mapping\t-\t-\n'
        printf 'action\tdotfiles_config\t⚙  Configure custom files list\t-\t-\n'
    fi

    if [ "${#invalid_git_dirs[@]}" -gt 0 ]; then
        printf 'action\tinvalid\t⚠  Invalid Git dirs (%d)\t-\t-\n' "${#invalid_git_dirs[@]}"
    fi

    printf 'action\texcludes\t🚫  Manage excludes\t-\t-\n'
    printf 'action\tlegend\t📖  Legend\t-\t-\n'
    printf 'action\trescan\t⟳  Rescan\t-\t-\n'

    for group in "${!dir_repos[@]}"; do
        group_list+=("$group")
    done

    if [ "${#group_list[@]}" -gt 0 ]; then
        IFS=$'\n' group_list=($(sort <<<"${group_list[*]}"))
        unset IFS
    fi

    for group in "${group_list[@]}"; do
        IFS=',' read -ra group_indices <<<"${dir_repos[$group]}"
        repo_count=${#group_indices[@]}
        icon=$(get_status_icon_plain "${dir_statuses[$group]}")
        display=$(printf '%s  %-24s %-14s %3d repos' \
            "$icon" "$group" "[${dir_statuses[$group]}]" "$repo_count")
        printf 'group\t%s\t%s\t%s\t%s\n' "$group" "$display" "$group" "${dir_statuses[$group]}"
    done
}

fzf_main_preview() {
    cat <<'EOF'
bash -c '
kind="$1"
id="$2"
path="$3"
status="$4"

if [ "$kind" = "repo" ]; then
    printf "Path: %s\nStatus: %s\n\n" "$path" "$status"
    git -C "$path" status --short --branch 2>/dev/null || true
    printf "\nRecent commits:\n"
    git -C "$path" log --oneline -5 2>/dev/null || true
    exit 0
fi

if [ "$kind" = "group" ]; then
    printf "Group: %s\nStatus: %s\n\n" "$id" "$status"
    printf "Enter opens this group.\n"
    printf "alt-s syncs this group.\n"
    printf "alt-d commits dirty repos in this group.\n"
    exit 0
fi

case "$id" in
    sync_all) echo "Pull repositories that are behind. Dirty and diverged repos are skipped." ;;
    commit_dirty) echo "Commit and push all repositories currently marked dirty." ;;
    dotfiles) echo "Sync dotfiles with per-host git branching. Auto-discovers customizations." ;;
    dotfiles_hosts) echo "View which hosts map to which git branches (reference)." ;;
    dotfiles_config) echo "Manually edit list of per-host custom files." ;;
    sync_group) echo "Pull repositories in this group that are behind. Dirty and diverged repos are skipped." ;;
    commit_group) echo "Commit and push dirty repositories in this group." ;;
    back) echo "Return to the group list." ;;
    invalid) echo "Review .git directories that failed validation and were not counted as repos." ;;
    excludes) echo "Add or remove user exclude rules stored in ~/.config/repostatus/excludes." ;;
    legend) echo "Show status icon meanings." ;;
    rescan) echo "Rerun repository discovery and status checks." ;;
esac
' _ {1} {2} {4} {5}
EOF
}

show_main_menu() {
    local header
    local preview_cmd

    header="enter: open group/select | alt-s: sync group | alt-a: sync all | alt-d: commit dirty group | alt-p: commit all dirty | alt-x: invalid | alt-e: excludes | ctrl-r: rescan"
    preview_cmd=$(fzf_main_preview)

    while true; do
        local result
        if ! result=$(build_main_items | fzf \
            --ansi \
            --height=100% \
            --layout=reverse \
            --border \
            --delimiter=$'\t' \
            --with-nth=3 \
            --expect=enter,alt-s,alt-a,alt-d,alt-p,alt-x,alt-e,ctrl-r \
            --header="$header" \
            --prompt="repos> " \
            --preview="$preview_cmd" \
            --preview-window="right,55%,border-left"); then
            clear
            exit 0
        fi

        local key
        local line
        key=$(printf '%s\n' "$result" | sed -n '1p')
        line=$(printf '%s\n' "$result" | sed -n '2p')

        if [ -z "$line" ]; then
            line="$key"
            key="enter"
        fi

        local kind
        local item_id
        local display
        local selected_path
        local selected_status
        IFS=$'\t' read -r kind item_id display selected_path selected_status <<<"$line"

        case "$key" in
        ctrl-r)
            rescan
            ;;
        alt-a)
            run_and_rescan sync_repos "${paths[@]}"
            ;;
        alt-p)
            run_commit_dirty_repos
            ;;
        alt-x)
            show_invalid_git_dirs
            ;;
        alt-e)
            show_excludes_menu
            ;;
        alt-s)
            if [ "$kind" = "group" ]; then
                run_sync_group "$item_id"
            fi
            ;;
        alt-d)
            if [ "$kind" = "group" ]; then
                run_commit_group_dirty_repos "$item_id"
            fi
            ;;
        enter | "")
            handle_main_selection "$kind" "$item_id" "$selected_path" "$selected_status"
            ;;
        esac
    done
}

handle_main_selection() {
    local kind="$1"
    local item_id="$2"
    local selected_path="$3"
    local selected_status="$4"

    if [ "$kind" = "group" ]; then
        show_group_repos "$item_id"
    fi

    case "$item_id" in
    sync_all)
        run_and_rescan sync_repos "${paths[@]}"
        ;;
    commit_dirty)
        run_commit_dirty_repos
        ;;
    dotfiles)
        clear
        sync_dotfiles "$HOME/dotfiles"
        pause_for_user
        rescan
        ;;
    dotfiles_hosts)
        show_dotfiles_hosts
        ;;
    dotfiles_config)
        show_dotfiles_config_menu
        ;;
    invalid)
        show_invalid_git_dirs
        ;;
    excludes)
        show_excludes_menu
        ;;
    legend)
        show_legend
        ;;
    rescan)
        rescan
        ;;
    esac
}

build_group_paths() {
    local group="$1"
    local -a group_indices
    local idx

    group_paths=()
    IFS=',' read -ra group_indices <<<"${dir_repos[$group]}"
    for idx in "${group_indices[@]}"; do
        group_paths+=("${paths[$idx]}")
    done
}

build_group_dirty_paths() {
    local group="$1"
    local -a group_indices
    local idx

    group_dirty_paths=()
    IFS=',' read -ra group_indices <<<"${dir_repos[$group]}"
    for idx in "${group_indices[@]}"; do
        if [ "${statuses[$idx]}" = "dirty" ]; then
            group_dirty_paths+=("${paths[$idx]}")
        fi
    done
}

run_sync_group() {
    local group="$1"
    local group_paths=()

    build_group_paths "$group"
    run_and_rescan sync_repos "${group_paths[@]}"
}

run_commit_group_dirty_repos() {
    local group="$1"
    local group_dirty_paths=()

    build_group_dirty_paths "$group"
    clear

    if [ "${#group_dirty_paths[@]}" -eq 0 ]; then
        printf 'No dirty repositories found in %s.\n' "$group"
        pause_for_user
        return
    fi

    if confirm_yes_no "Commit and push ${#group_dirty_paths[@]} dirty repos in $group?"; then
        commit_repos "${group_dirty_paths[@]}"
        pause_for_user
        rescan
    fi
}

build_group_repo_items() {
    local group="$1"
    local -a group_indices
    local idx
    local icon
    local display

    printf 'action\tsync_group\t🔄  Sync repos in %s\t-\t-\n' "$group"
    printf 'action\tcommit_group\t💾  Commit dirty repos in %s\t-\t-\n' "$group"
    printf 'action\tback\t←  Back to groups\t-\t-\n'

    IFS=',' read -ra group_indices <<<"${dir_repos[$group]}"
    for idx in "${group_indices[@]}"; do
        icon=$(get_status_icon_plain "${statuses[$idx]}")
        display=$(printf '%s  %-30s %-14s %s' \
            "$icon" "${repos[$idx]}" "[${statuses[$idx]}]" "${paths[$idx]}")
        printf 'repo\t%s\t%s\t%s\t%s\n' "$idx" "$display" "${paths[$idx]}" "${statuses[$idx]}"
    done
}

show_group_repos() {
    local group="$1"
    local header
    local preview_cmd

    header="enter: open/select | alt-s: sync selected | alt-a: sync group | alt-d: commit selected | alt-p: commit dirty group | ctrl-r: rescan | esc: groups"
    preview_cmd=$(fzf_main_preview)

    while true; do
        local result
        if ! result=$(build_group_repo_items "$group" | fzf \
            --ansi \
            --height=100% \
            --layout=reverse \
            --border \
            --delimiter=$'\t' \
            --with-nth=3 \
            --expect=enter,alt-s,alt-a,alt-d,alt-p,ctrl-r \
            --header="$header" \
            --prompt="${group}> " \
            --preview="$preview_cmd" \
            --preview-window="right,55%,border-left"); then
            return
        fi

        local key
        local line
        key=$(printf '%s\n' "$result" | sed -n '1p')
        line=$(printf '%s\n' "$result" | sed -n '2p')

        if [ -z "$line" ]; then
            line="$key"
            key="enter"
        fi

        local kind
        local item_id
        local display
        local selected_path
        local selected_status
        IFS=$'\t' read -r kind item_id display selected_path selected_status <<<"$line"

        case "$key" in
        ctrl-r)
            rescan
            ;;
        alt-a)
            run_sync_group "$group"
            ;;
        alt-p)
            run_commit_group_dirty_repos "$group"
            ;;
        alt-s)
            if [ "$kind" = "repo" ]; then
                run_and_rescan sync_repos "$selected_path"
            fi
            ;;
        alt-d)
            if [ "$kind" = "repo" ]; then
                run_commit_selected_repo "$selected_path" "$selected_status"
            fi
            ;;
        enter | "")
            if [ "$kind" = "action" ] && [ "$item_id" = "back" ]; then
                return
            fi
            handle_group_selection "$group" "$kind" "$item_id" "$selected_path" "$selected_status"
            ;;
        esac
    done
}

handle_group_selection() {
    local group="$1"
    local kind="$2"
    local item_id="$3"
    local selected_path="$4"
    local selected_status="$5"

    if [ "$kind" = "repo" ]; then
        open_repo "$selected_path"
    fi

    case "$item_id" in
    sync_group)
        run_sync_group "$group"
        ;;
    commit_group)
        run_commit_group_dirty_repos "$group"
        ;;
    back)
        return
        ;;
    esac
}

run_commit_selected_repo() {
    local repo_path="$1"
    local status="$2"
    local repo_name
    repo_name=$(basename "$repo_path")

    clear
    if [ "$status" != "dirty" ]; then
        printf '%s is not dirty.\n' "$repo_name"
        pause_for_user
        return
    fi

    if confirm_yes_no "Commit and push $repo_name?"; then
        commit_repos "$repo_path"
        pause_for_user
        rescan
    fi
}

run_commit_dirty_repos() {
    local dirty_repos=()
    local i

    for i in "${!statuses[@]}"; do
        if [ "${statuses[$i]}" = "dirty" ]; then
            dirty_repos+=("${paths[$i]}")
        fi
    done

    clear

    if [ "${#dirty_repos[@]}" -eq 0 ]; then
        echo "No dirty repositories found."
        pause_for_user
        return
    fi

    if confirm_yes_no "Commit and push ${#dirty_repos[@]} dirty repos?"; then
        commit_repos "${dirty_repos[@]}"
        pause_for_user
        rescan
    fi
}

build_exclude_items() {
    local i

    printf 'action\tadd\tAdd user exclude\n'
    printf 'action\tbuiltin\tView built-in excludes\n'

    for i in "${!USER_EXCLUDE_DIRS[@]}"; do
        printf 'exclude\t%s\tRemove: %s\n' "$i" "${USER_EXCLUDE_DIRS[$i]}"
    done
}

show_excludes_menu() {
    while true; do
        local result
        if ! result=$(build_exclude_items | fzf \
            --height=80% \
            --layout=reverse \
            --border \
            --delimiter=$'\t' \
            --with-nth=3 \
            --prompt="excludes> " \
            --header="enter: select | esc: back | file: $EXCLUDES_FILE"); then
            return
        fi

        local kind
        local item_id
        local display
        IFS=$'\t' read -r kind item_id display <<<"$result"

        case "$kind:$item_id" in
        action:add)
            add_exclude_prompt
            ;;
        action:builtin)
            show_builtin_excludes
            ;;
        exclude:*)
            remove_exclude_prompt "$item_id"
            ;;
        esac
    done
}

add_exclude_prompt() {
    local new_exclude
    local code

    clear
    printf 'Enter a directory name, absolute path, or ~/path to exclude.\n'
    printf 'Exclude: '
    read -r new_exclude || return

    if add_user_exclude "$new_exclude"; then
        printf 'Added exclude: %s\n' "$(normalize_exclude "$new_exclude")"
        pause_for_user
        rescan
    else
        code=$?
        if [ "$code" -eq 2 ]; then
            echo "That rule already exists or is covered as a built-in exclude."
        else
            echo "Exclude cannot be empty."
        fi
        pause_for_user
    fi
}

show_builtin_excludes() {
    local i

    clear
    printf 'Built-in excludes\n\n'
    for i in "${!EXCLUDE_DIRS[@]}"; do
        printf '  - %s\n' "${EXCLUDE_DIRS[$i]}"
    done
    printf '\nUser excludes file:\n%s\n' "$EXCLUDES_FILE"
    pause_for_user
}

remove_exclude_prompt() {
    local remove_index="$1"
    local remove_value="${USER_EXCLUDE_DIRS[$remove_index]}"

    clear
    if confirm_yes_no "Remove user exclude '$remove_value'?"; then
        remove_user_exclude "$remove_index"
        echo "Removed exclude."
        pause_for_user
        rescan
    fi
}

build_invalid_items() {
    local i
    local display

    for i in "${!invalid_git_dirs[@]}"; do
        display=$(printf '%-50s %s' "${invalid_repo_paths[$i]}" "${invalid_reasons[$i]}")
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$i" "$display" "${invalid_git_dirs[$i]}" "${invalid_repo_paths[$i]}" "${invalid_reasons[$i]}"
    done
}

fzf_invalid_preview() {
    cat <<'EOF'
bash -c '
git_dir="$1"
repo_dir="$2"
reason="$3"
printf "Git dir: %s\nRepo dir: %s\nReason: %s\n\n" "$git_dir" "$repo_dir" "$reason"
printf "Actions\n"
printf "  enter  open shell here\n"
printf "  alt-p  add exact path exclude\n"
printf "  alt-n  add directory-name exclude\n"
' _ {3} {4} {5}
EOF
}

show_invalid_git_dirs() {
    if [ "${#invalid_git_dirs[@]}" -eq 0 ]; then
        clear
        echo "No invalid .git directories were found during this scan."
        pause_for_user
        return
    fi

    local preview_cmd
    preview_cmd=$(fzf_invalid_preview)

    while true; do
        local result
        if ! result=$(build_invalid_items | fzf \
            --height=90% \
            --layout=reverse \
            --border \
            --delimiter=$'\t' \
            --with-nth=2 \
            --expect=enter,alt-p,alt-n \
            --prompt="invalid> " \
            --header="enter: shell | alt-p: exclude exact path | alt-n: exclude name | esc: back" \
            --preview="$preview_cmd" \
            --preview-window="right,55%,border-left"); then
            return
        fi

        local key
        local line
        key=$(printf '%s\n' "$result" | sed -n '1p')
        line=$(printf '%s\n' "$result" | sed -n '2p')

        if [ -z "$line" ]; then
            line="$key"
            key="enter"
        fi

        local index
        local display
        local git_dir
        local repo_dir
        local reason
        IFS=$'\t' read -r index display git_dir repo_dir reason <<<"$line"

        case "$key" in
        alt-p)
            add_invalid_exclude_and_rescan "$repo_dir"
            ;;
        alt-n)
            add_invalid_exclude_and_rescan "$(basename "$repo_dir")"
            ;;
        enter | "")
            clear
            cd "$repo_dir" || exit 1
            exec "${SHELL:-/bin/bash}"
            ;;
        esac
    done
}

add_invalid_exclude_and_rescan() {
    local exclude="$1"
    local code

    clear
    if add_user_exclude "$exclude"; then
        printf 'Added exclude: %s\n' "$exclude"
        pause_for_user
        rescan
    else
        code=$?
        if [ "$code" -eq 2 ]; then
            echo "That path or name is already excluded."
        else
            echo "Exclude cannot be empty."
        fi
        pause_for_user
    fi
}

show_main_menu
