get_repo_status() {
    local repo_dir="$1"
    cd "$repo_dir"

    # Refresh git index to ensure stat information is up-to-date
    # This prevents false "dirty" detection due to stale index stat entries
    git update-index --refresh >/dev/null 2>&1 || true

    # Check if there are any remote branches
    if [ -z "$(git branch -r)" ]; then
        echo "uninitialized"
        return
    fi

    # Get repo name
    local repo_name=$(basename "$repo_dir")

    # Check if there are uncommitted changes
    if ! (git diff-index --quiet HEAD -- 2>/dev/null); then
        echo "dirty"
        return
    fi

    # Check for untracked files
    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        echo "dirty"
        return
    fi

    # Check if ahead/behind/diverged from remote
    local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
    if [ -n "$upstream" ]; then
        local local_commit=$(git rev-parse @ 2>/dev/null || true)
        local remote_commit=$(git rev-parse @{u} 2>/dev/null || true)
        local base_commit=$(git merge-base @ @{u} 2>/dev/null || true)

        if [ -z "$local_commit" ] || [ -z "$remote_commit" ] || [ -z "$base_commit" ]; then
            # If any of the commits are not found, the repo is likely in a weird state
            # (e.g. empty, no upstream). We'll just call it clean and move on.
            echo "clean"
            return
        fi

        if [ "$local_commit" = "$remote_commit" ]; then
            echo "clean"
        elif [ "$local_commit" = "$base_commit" ]; then
            echo "behind"
        elif [ "$remote_commit" = "$base_commit" ]; then
            echo "ahead"
        else
            echo "diverged"
        fi
    else
        echo "clean"
    fi
}

# Plain text icons for fzf display
get_status_icon_plain() {
    case "$1" in
    clean) echo "$CLEAN" ;;
    dirty) echo "$DIRTY" ;;
    ahead) echo "$AHEAD" ;;
    behind) echo "$BEHIND" ;;
    diverged) echo "$DIVERGED" ;;
    uninitialized) echo "$UNINITIALIZED" ;;
    fetch_failed) echo "$FETCH_FAILED" ;;
    *) echo "❓" ;;
    esac
}

get_worst_status() {
    local worst="clean"
    for status in "$@"; do
        case "$status" in
        diverged)
            worst="diverged"
            break
            ;;
        fetch_failed) worst="fetch_failed" ;;
        dirty | uninitialized) [ "$worst" != "fetch_failed" ] && worst="dirty" ;;
        behind) [ "$worst" != "dirty" ] && [ "$worst" != "fetch_failed" ] && worst="behind" ;;
        ahead) [ "$worst" != "dirty" ] && [ "$worst" != "behind" ] && [ "$worst" != "fetch_failed" ] && worst="ahead" ;;
        esac
    done
    echo "$worst"
}

get_parent_dir() {
    local path="$1"
    local parent=$(dirname "$path")

    if [ "$path" = "$HOME" ]; then
        echo "~"
    elif [ "$parent" = "$HOME" ]; then
        echo "~"
    else
        # Get the first level directory under home
        local rel_path="${path#$HOME/}"
        local first_dir=$(echo "$rel_path" | cut -d'/' -f1)
        echo "~/$first_dir"
    fi
}

sync_repos() {
    local repos_to_sync=("$@")
    local synced=0
    local up_to_date=0
    local failed=()
    local skipped_dirty=()
    local skipped_diverged=()
    local total=${#repos_to_sync[@]}
    local current=0

    if [ "$total" -eq 0 ]; then
        echo "No repositories selected."
        return
    fi

    for repo_path in "${repos_to_sync[@]}"; do
        cd "$repo_path"
        local repo_name=$(basename "$repo_path")
        local status=$(get_repo_status "$repo_path")

        current=$((current + 1))
        printf '[%d/%d] Syncing %s\n' "$current" "$total" "$repo_name"

        case "$status" in
        behind)
            if git pull --quiet 2>/dev/null; then
                synced=$((synced + 1))
            else
                failed+=("$repo_name")
            fi
            ;;
        dirty)
            skipped_dirty+=("$repo_name")
            ;;
        diverged)
            skipped_diverged+=("$repo_name")
            ;;
        clean | ahead)
            up_to_date=$((up_to_date + 1))
            ;;
        esac
    done

    # Build summary
    printf '\nSummary\n'
    printf '  Synced: %d\n' "$synced"
    printf '  Already up to date: %d\n' "$up_to_date"

    # Only show problem details if there are any
    if [ ${#failed[@]} -gt 0 ] || [ ${#skipped_dirty[@]} -gt 0 ] || [ ${#skipped_diverged[@]} -gt 0 ]; then
        printf '\nIssues\n'

        if [ ${#failed[@]} -gt 0 ]; then
            printf '  Failed (%d):\n' "${#failed[@]}"
            for repo in "${failed[@]}"; do
                printf '    - %s\n' "$repo"
            done
        fi

        if [ ${#skipped_dirty[@]} -gt 0 ]; then
            printf '  Skipped - local changes (%d):\n' "${#skipped_dirty[@]}"
            for repo in "${skipped_dirty[@]}"; do
                printf '    - %s\n' "$repo"
            done
        fi

        if [ ${#skipped_diverged[@]} -gt 0 ]; then
            printf '  Skipped - diverged (%d):\n' "${#skipped_diverged[@]}"
            for repo in "${skipped_diverged[@]}"; do
                printf '    - %s\n' "$repo"
            done
        fi
    fi
}

commit_repos() {
    local repos_to_commit=("$@")
    local committed=0
    local failed=()
    local total=${#repos_to_commit[@]}
    local current=0

    if [ "$total" -eq 0 ]; then
        echo "No repositories selected."
        return
    fi

    for repo_path in "${repos_to_commit[@]}"; do
        cd "$repo_path"
        local repo_name=$(basename "$repo_path")
        local status=$(get_repo_status "$repo_path")

        current=$((current + 1))
        printf '[%d/%d] Committing %s\n' "$current" "$total" "$repo_name"

        # Only commit dirty repos
        if [ "$status" = "dirty" ]; then
            # Stage all changes
            git add -A

            # Create commit message
            local commit_msg="Update $repo_name: $(date '+%Y-%m-%d')"

            # Attempt commit
            if git commit -m "$commit_msg" >/dev/null 2>&1; then
                # Attempt push
                if git push >/dev/null 2>&1; then
                    committed=$((committed + 1))
                else
                    # Commit succeeded but push failed
                    failed+=("$repo_name (push failed)")
                fi
            else
                failed+=("$repo_name")
            fi
        fi
    done

    # Build summary
    printf '\nCommit Summary\n'
    printf '  Committed: %d\n' "$committed"

    if [ ${#failed[@]} -gt 0 ]; then
        printf '  Failed (%d):\n' "${#failed[@]}"
        for repo in "${failed[@]}"; do
            printf '    - %s\n' "$repo"
        done
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Dotfiles Sync (multi-system support with per-host customization)
# ─────────────────────────────────────────────────────────────────────────────

# Custom files that may differ per host (relative to dotfiles repo root)
# Most dotfiles should be identical across all hosts (unified look & feel).
# Only add files here if they MUST vary (e.g., hardware-specific power management).
# Default is empty - users customize as needed.
DOTFILES_CUSTOM_FILES=()

dotfiles_save_custom_files() {
    local dotfiles_dir="$1"
    local savedir="$2"
    local relpath dest

    for relpath in "${DOTFILES_CUSTOM_FILES[@]}"; do
        dest="$savedir/$relpath"
        if [ -f "$dotfiles_dir/$relpath" ]; then
            mkdir -p "$(dirname "$dest")"
            cp "$dotfiles_dir/$relpath" "$dest"
        elif [ -d "$dotfiles_dir/$relpath" ]; then
            mkdir -p "$dest"
            cp -r "$dotfiles_dir/$relpath/." "$dest/"
        fi
    done
}

dotfiles_restore_custom_files() {
    local dotfiles_dir="$1"
    local savedir="$2"
    local relpath src dest

    for relpath in "${DOTFILES_CUSTOM_FILES[@]}"; do
        src="$savedir/$relpath"
        dest="$dotfiles_dir/$relpath"
        if [ -e "$src" ]; then
            mkdir -p "$(dirname "$dest")"
            cp -r "$src" "$dest"
        fi
    done
}

dotfiles_review_custom_file() {
    local dotfiles_dir="$1"
    local relpath="$2"
    local file="$dotfiles_dir/$relpath"

    [ ! -f "$file" ] && return 0

    # Check if file exists on master
    local on_master=false
    if git -C "$dotfiles_dir" show "master:$relpath" &>/dev/null 2>&1; then
        on_master=true
    fi

    if ! $on_master; then
        printf '\n%s\n' "$relpath"
        printf '  ℹ  New custom file (not in master)\n'
        printf '  Keep this file on %s? [y/n] ' "$DOTFILES_BRANCH"
        read -r -t 30 answer || answer="y"
        if [[ "$answer" =~ ^[Nn] ]]; then
            rm -f "$file"
            printf '  ✓ Omitted\n'
        else
            printf '  ✓ Keeping\n'
        fi
        return 0
    fi

    if git -C "$dotfiles_dir" diff --quiet "master" -- "$relpath" 2>/dev/null; then
        return 0
    fi

    printf '\n%s\n' "$relpath"
    git -C "$dotfiles_dir" diff --stat "master" -- "$relpath" 2>/dev/null

    printf '  Review full diff? [y/n] '
    read -r -t 30 review || review="n"
    if [[ "$review" =~ ^[Yy] ]]; then
        printf '\n'
        git -C "$dotfiles_dir" diff "master" -- "$relpath" 2>/dev/null | head -200
        printf '\n'
    fi

    printf '  Use master (m) or keep local (k)? [m/k] '
    local choice
    while true; do
        read -r -t 30 choice || choice="k"
        case "$choice" in
        [mM])
            git -C "$dotfiles_dir" checkout "master" -- "$relpath" 2>/dev/null || true
            printf '  ✓ Using master\n'
            return 0
            ;;
        [kK])
            printf '  ✓ Keeping local\n'
            return 0
            ;;
        *)
            printf '  Enter m or k: '
            ;;
        esac
    done
}

sync_dotfiles() {
    local dotfiles_dir="$1"

    if [ ! -d "$dotfiles_dir/.git" ]; then
        printf 'Not a git repository: %s\n' "$dotfiles_dir" >&2
        return 1
    fi

    cd "$dotfiles_dir" || return 1

    local host
    host=$(hostname -s)
    DOTFILES_BRANCH="host-${host}"
    local host_map_file="$CONFIG_DIR/dotfiles-hosts"

    # Architecture: ArchyTux is master branch owner
    # Other hosts sync from master and customize only when necessary
    local primary_host="ArchyTux"

    printf '\nDotfiles Sync\n'
    printf '  Host: %s\n' "$host"
    if [ "$host" = "$primary_host" ]; then
        printf '  Role: Primary (master branch)\n'
    else
        printf '  Role: Secondary (syncs from master)\n'
    fi
    printf '  Branch: %s\n' "$DOTFILES_BRANCH"
    printf '  Directory: %s\n' "$dotfiles_dir"

    # Fetch origin
    if ! git fetch origin 2>/dev/null; then
        printf '  ⚠ Cannot fetch origin (offline?); using local master\n'
    fi

    # Stash uncommitted changes
    local stashed=0
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
        printf '  Stashing uncommitted changes...\n'
        git stash push -m "repostatus: $(date +%Y-%m-%d_%H:%M)" 2>/dev/null || true
        stashed=1
    fi

    # Update master
    printf '  Updating master...\n'
    git checkout master 2>/dev/null
    git rebase origin/master 2>/dev/null ||
        git pull --rebase origin master 2>/dev/null ||
        printf '  ⚠ Could not update master\n'

    # Create/checkout host branch
    local branch_exists=false
    git rev-parse --verify "$DOTFILES_BRANCH" &>/dev/null && branch_exists=true

    if $branch_exists; then
        printf '  Checking out existing branch: %s\n' "$DOTFILES_BRANCH"
        git checkout "$DOTFILES_BRANCH"
        # Get files that differ from master (existing customizations)
        local -a changed_files
        mapfile -t changed_files < <(git diff --name-only master 2>/dev/null)
    else
        printf '  Creating new branch: %s\n' "$DOTFILES_BRANCH"
        git checkout -b "$DOTFILES_BRANCH" master
        local changed_files=()
    fi

    # Discover local changes vs master
    printf '  Scanning for local changes...\n'
    local -a local_changes
    mapfile -t local_changes < <(git diff --name-only master 2>/dev/null)

    # Categorize files: already customized vs newly changed
    local -a already_custom
    local -a newly_changed

    for file in "${local_changes[@]}"; do
        if printf '%s\n' "${DOTFILES_CUSTOM_FILES[@]}" | grep -q "^$file$"; then
            already_custom+=("$file")
        else
            newly_changed+=("$file")
        fi
    done

    # Report status
    printf '\n  Already customized (%d files): keeping as-is\n' "${#already_custom[@]}"
    for file in "${already_custom[@]}"; do
        printf '    ✓ %s\n' "$file"
    done

    # Ask about newly changed files
    if [ ${#newly_changed[@]} -gt 0 ]; then
        printf '\n  Found local changes not in custom list (%d files):\n' "${#newly_changed[@]}"
        local new_customs=()
        for file in "${newly_changed[@]}"; do
            printf '\n  %s\n' "$file"
            git diff --stat master -- "$file" 2>/dev/null || true

            printf '  Keep local changes? [k=keep/m=use master] '
            read -r -t 30 choice || choice="m"
            case "$choice" in
            [kK])
                printf '    → Keeping as custom file\n'
                new_customs+=("$file")
                ;;
            *)
                printf '    → Syncing to master\n'
                git checkout master -- "$file" 2>/dev/null || true
                ;;
            esac
        done

        # Add new customs to list
        if [ ${#new_customs[@]} -gt 0 ]; then
            printf '\nAdding %d files to custom list...\n' "${#new_customs[@]}"
            for file in "${new_customs[@]}"; do
                DOTFILES_CUSTOM_FILES+=("$file")
            done
            dotfiles_save_config
        fi
    else
        printf '  ✓ No new local changes detected\n'
    fi

    # Update host mapping
    mkdir -p "$CONFIG_DIR"
    {
        # Read existing entries excluding this host
        grep -v "^${host}:" "$host_map_file" 2>/dev/null || true
        # Add/update current host
        printf '%s:%s\n' "$host" "$DOTFILES_BRANCH"
    } | sort -u >"$host_map_file.tmp"
    mv "$host_map_file.tmp" "$host_map_file"

    # Commit changes if any
    if ! git diff --cached --quiet 2>/dev/null || ! git diff --quiet 2>/dev/null; then
        printf '\nCommit changes? [y/n] '
        read -r -t 30 commit_ans || commit_ans="n"
        if [[ "$commit_ans" =~ ^[Yy] ]]; then
            printf 'Commit message (default: sync): '
            read -r -t 30 msg || msg=""
            msg="${msg:-sync: $(date +%Y-%m-%d)}"
            git add -A
            git commit -m "$msg"
            printf '  ✓ Committed\n'
        fi
    fi

    # Pop stash if we stashed
    if [ $stashed -eq 1 ]; then
        git stash pop 2>/dev/null || printf '  ⚠ Stash pop had conflicts; resolve manually\n'
    fi

    printf '\n✓ Dotfiles sync complete on %s\n' "$DOTFILES_BRANCH"
}

