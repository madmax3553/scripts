export DIALOGRC="$DIALOG_THEME"
trap 'rm -f "$DIALOG_THEME"' EXIT

# Colors for non-dialog output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/repostatus"
FETCH_LOG="$CACHE_DIR/fetch.log"
mkdir -p "$CACHE_DIR"
: > "$FETCH_LOG"

# Status indicators
CLEAN="🟢"
DIRTY="🟡"
AHEAD="🔵"
BEHIND="🟠"
DIVERGED="🔴"
UNINITIALIZED="⚪"
FETCH_FAILED="⛔"

# When called from waybar with --json-summary, use shorter fetch interval
# to avoid double-wait (waybar interval + script interval)
if [ "$1" = "--json-summary" ]; then
    FETCH_INTERVAL=${REPOSTATUS_FETCH_INTERVAL:-60}
else
    FETCH_INTERVAL=${REPOSTATUS_FETCH_INTERVAL:-300}
fi
FORCE_FETCH=${REPOSTATUS_FORCE_FETCH:-0}
DISABLE_FETCH=${REPOSTATUS_DISABLE_FETCH:-0}
LAST_FETCH_FILE="$CACHE_DIR/last_fetch"

get_repo_status() {
    local repo_dir="$1"
    cd "$repo_dir"

    # Check if there are any remote branches
    if [ -z "$(git branch -r)" ]; then
        echo "uninitialized"
        return
    fi

    # Get repo name
    local repo_name=$(basename "$repo_dir")

    # Check if there are uncommitted changes
    if ! (git diff-index --quiet HEAD -- 2>/dev/null); then
        echo "dirty"
        return
    fi

    # Check for untracked files
    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        echo "dirty"
        return
    fi

    # Check if ahead/behind/diverged from remote
    local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
    if [ -n "$upstream" ]; then
        local local_commit=$(git rev-parse @ 2>/dev/null || true)
        local remote_commit=$(git rev-parse @{u} 2>/dev/null || true)
        local base_commit=$(git merge-base @ @{u} 2>/dev/null || true)

        if [ -z "$local_commit" ] || [ -z "$remote_commit" ] || [ -z "$base_commit" ]; then
            # If any of the commits are not found, the repo is likely in a weird state
            # (e.g. empty, no upstream). We'll just call it clean and move on.
            echo "clean"
            return
        fi

        if [ "$local_commit" = "$remote_commit" ]; then
            echo "clean"
        elif [ "$local_commit" = "$base_commit" ]; then
            echo "behind"
        elif [ "$remote_commit" = "$base_commit" ]; then
            echo "ahead"
        else
            echo "diverged"
        fi
    else
        echo "clean"
    fi
}

get_status_icon() {
    case "$1" in
        clean)   echo -e "${GREEN}${CLEAN}${NC}" ;;
        dirty)   echo -e "${YELLOW}${DIRTY}${NC}" ;;
        ahead)   echo -e "${BLUE}${AHEAD}${NC}" ;;
        behind)  echo -e "${YELLOW}${BEHIND}${NC}" ;;
        diverged) echo -e "${RED}${DIVERGED}${NC}" ;;
        uninitialized) echo -e "${NC}${UNINITIALIZED}${NC}" ;;
        fetch_failed) echo -e "${RED}${FETCH_FAILED}${NC}" ;;
        *)       echo -e "${NC}❓${NC}" ;;
    esac
}

# Plain text icons for dialog (no ANSI colors)
get_status_icon_plain() {
    case "$1" in
        clean)   echo "$CLEAN" ;;
        dirty)   echo "$DIRTY" ;;
        ahead)   echo "$AHEAD" ;;
        behind)  echo "$BEHIND" ;;
        diverged) echo "$DIVERGED" ;;
        uninitialized) echo "$UNINITIALIZED" ;;
        fetch_failed) echo "$FETCH_FAILED" ;;
        *)       echo "❓" ;;
    esac
}

get_worst_status() {
    local worst="clean"
    for status in "$@"; do
        case "$status" in
            diverged) worst="diverged"; break ;;
            fetch_failed) worst="fetch_failed" ;;
            dirty|uninitialized) [ "$worst" != "fetch_failed" ] && worst="dirty" ;;
            behind) [ "$worst" != "dirty" ] && [ "$worst" != "fetch_failed" ] && worst="behind" ;;
            ahead) [ "$worst" != "dirty" ] && [ "$worst" != "behind" ] && [ "$worst" != "fetch_failed" ] && worst="ahead" ;;
        esac
    done
    echo "$worst"
}

get_parent_dir() {
    local path="$1"
    local parent=$(dirname "$path")
    local parent_name=$(basename "$parent")

    # Check if it's directly in home
    if [ "$parent" = "$HOME" ]; then
        echo "~/$parent_name"
    else
        # Get the first level directory under home
        local rel_path="${path#$HOME/}"
        local first_dir=$(echo "$rel_path" | cut -d'/' -f1)
        echo "~/$first_dir"
    fi
}

sync_repos() {
    local repos_to_sync=("$@")
    local synced=0
    local up_to_date=0
    local failed=()
    local skipped_dirty=()
    local skipped_diverged=()
    local total=${#repos_to_sync[@]}
    local current=0

    for repo_path in "${repos_to_sync[@]}"; do
        cd "$repo_path"
        local repo_name=$(basename "$repo_path")
        local status=$(get_repo_status "$repo_path")

        current=$((current + 1))
        percent=$((current * 100 / total))
        echo "$percent" | dialog --title "Syncing Repositories" \
            --gauge "Syncing: $repo_name" 8 60 "$percent"

        case "$status" in
            behind)
                if git pull --quiet 2>/dev/null; then
                    synced=$((synced + 1))
                else
                    failed+=("$repo_name")
                fi
                ;;
            dirty)
                skipped_dirty+=("$repo_name")
                ;;
            diverged)
                skipped_diverged+=("$repo_name")
                ;;
            clean|ahead)
                up_to_date=$((up_to_date + 1))
                ;;
        esac
    done

    # Build summary
    local summary="━━━ Summary ━━━\n"
    summary+="✓ Synced: $synced\n"
    summary+="✓ Already up to date: $up_to_date\n"

    # Only show problem details if there are any
    if [ ${#failed[@]} -gt 0 ] || [ ${#skipped_dirty[@]} -gt 0 ] || [ ${#skipped_diverged[@]} -gt 0 ]; then
        summary+="\n━━━ Issues ━━━\n"

        if [ ${#failed[@]} -gt 0 ]; then
            summary+="✗ Failed (${#failed[@]}):\n"
            for repo in "${failed[@]}"; do
                summary+="  • $repo\n"
            done
        fi

        if [ ${#skipped_dirty[@]} -gt 0 ]; then
            summary+="⊘ Skipped - local changes (${#skipped_dirty[@]}):\n"
            for repo in "${skipped_dirty[@]}"; do
                summary+="  • $repo\n"
            done
        fi

        if [ ${#skipped_diverged[@]} -gt 0 ]; then
            summary+="⊘ Skipped - diverged (${#skipped_diverged[@]}):\n"
            for repo in "${skipped_diverged[@]}"; do
                summary+="  • $repo\n"
            done
        fi
    fi

    dialog --title "Sync Complete" --msgbox "$summary" 20 50
}

commit_repos() {
    local repos_to_commit=("$@")
    local committed=0
    local failed=()
    local total=${#repos_to_commit[@]}
    local current=0
    
    # Check if auto-commit-push script exists
    local commit_script="${HOME}/.local/bin/auto-commit-push"
    if [ ! -x "$commit_script" ]; then
        dialog --title "Error" --msgbox "auto-commit-push script not found.\n\nMake sure it's installed at: $commit_script" 8 50
        return 1
    fi

    for repo_path in "${repos_to_commit[@]}"; do
        cd "$repo_path"
        local repo_name=$(basename "$repo_path")
        local status=$(get_repo_status "$repo_path")

        current=$((current + 1))
        percent=$((current * 100 / total))
        echo "$percent" | dialog --title "Committing Repositories" \
            --gauge "Committing: $repo_name" 8 60 "$percent"

        # Only commit dirty repos
        if [ "$status" = "dirty" ]; then
            if "$commit_script" --force -m "Update %s: $(date '+%Y-%m-%d')" "$repo_name" >/dev/null 2>&1; then
                committed=$((committed + 1))
            else
                failed+=("$repo_name")
            fi
        fi
    done

    # Build summary
    local summary="━━━ Commit Summary ━━━\n"
    summary+="✓ Committed: $committed\n"

    if [ ${#failed[@]} -gt 0 ]; then
        summary+="✗ Failed (${#failed[@]}):\n"
        for repo in "${failed[@]}"; do
            summary+="  • $repo\n"
        done
    fi

    dialog --title "Commit Complete" --msgbox "$summary" 12 50
}

fetch_all_repos() {
    local total=${#paths[@]}
    local current=0

    for i in "${!paths[@]}"; do
        repo_path="${paths[$i]}"
        repo_name=$(basename "$repo_path")
        current=$((current + 1))
        percent=$((current * 100 / total))

        if [ "$JSON_MODE" -eq 0 ]; then
            echo "$percent" | dialog --title "Fetching Remote Updates" \
                --gauge "Fetching: $repo_name" 8 60 "$percent"
        fi

        set +e
        output=$(git -C "$repo_path" fetch --quiet 2>&1)
        exit_code=$?
        set -e
        if [ $exit_code -ne 0 ]; then
            statuses[$i]="fetch_failed"
            fetch_error_msgs[$i]="$output"
            {
                echo "[$(date --iso-8601=seconds)] ${repo_path}"
                echo "$output"
                echo ""
            } >> "$FETCH_LOG"
        fi
    done
}

# Find all git repositories in home directory

declare -a repos
declare -a statuses
declare -a paths
declare -a fetch_error_msgs

# Directories to exclude
EXCLUDE_DIRS=(
    ".local"
    ".cache"
    ".cargo"
    ".npm"
    ".nvm"
    ".rustup"
    "node_modules"
    ".venv"
    "venv"
    ".virtualenv"
)

# Build find exclusion string
EXCLUDE_FIND=""
for dir in "${EXCLUDE_DIRS[@]}"; do
    EXCLUDE_FIND="$EXCLUDE_FIND -path '*/$dir' -prune -o"
done

# Check if we should run in JSON mode (will be handled after repo scan)
JSON_MODE=0
if [ "$1" = "--json-summary" ]; then
    JSON_MODE=1
fi

# Check for sync mode (handle separately from JSON)
if [ "$1" = "--sync" ] || [ "$1" = "-s" ]; then
    # Need to scan repos first
    :
fi

# Check for commit mode
COMMIT_MODE=0
COMMIT_TARGET=""
if [ "$1" = "--commit" ]; then
    COMMIT_MODE=1
    COMMIT_TARGET="${2:-}"
fi

# Show initial scanning message (only if not in JSON mode)
if [ "$JSON_MODE" -eq 0 ]; then
    dialog --title "Repository Status" --infobox "Scanning for git repositories..." 5 45
fi

# First pass: find all repos (fast)
declare -a git_dirs
while IFS= read -r -d '' git_dir; do
    git_dirs+=("$git_dir")
done < <(eval "find ~ $EXCLUDE_FIND -name '.git' -type d -prune -print0 2>/dev/null" | head -z -n 50)

total_repos=${#git_dirs[@]}

if [ "$total_repos" -eq 0 ]; then
    dialog --title "Repository Status" --msgbox "No git repositories found in home directory" 6 50
    clear
    exit 0
fi

# Second pass: get status for each repo with progress
current=0
for git_dir in "${git_dirs[@]}"; do
    repo_dir=$(dirname "$git_dir")

    # Skip if inside another git repo
    if [[ "$repo_dir" == *"/.git/"* ]]; then
        continue
    fi

    repo_name=$(basename "$repo_dir")
    current=$((current + 1))
    percent=$((current * 100 / total_repos))

    if [ "$JSON_MODE" -eq 0 ]; then
        echo "$percent" | dialog --title "Scanning Repositories" \
            --gauge "Checking: $repo_name" 8 60 "$percent"
    fi

    status=$(get_repo_status "$repo_dir")

    repos+=("$repo_name")
    statuses+=("$status")
    paths+=("$repo_dir")
done

if [ ${#repos[@]} -eq 0 ]; then
    dialog --title "Repository Status" --msgbox "No git repositories found in home directory" 6 50
    clear
    exit 0
fi

should_fetch=1
if [ "$DISABLE_FETCH" -eq 1 ]; then
    should_fetch=0
elif [ "$FORCE_FETCH" -eq 0 ] && [ "$FETCH_INTERVAL" -gt 0 ] && [ -f "$LAST_FETCH_FILE" ]; then
    now=$(date +%s)
    last_fetch=$(cat "$LAST_FETCH_FILE" 2>/dev/null || echo 0)
    if [ $((now - last_fetch)) -lt "$FETCH_INTERVAL" ]; then
        should_fetch=0
    fi
fi

if [ "$should_fetch" -eq 1 ]; then
    fetch_all_repos
    date +%s > "$LAST_FETCH_FILE"
fi

# Handle JSON mode output
if [ "$JSON_MODE" -eq 1 ]; then
    overall_status=$(get_worst_status "${statuses[@]}")

    declare -A status_counts=(
        [clean]=0
        [dirty]=0
        [ahead]=0
        [behind]=0
        [diverged]=0
        [uninitialized]=0
        [fetch_failed]=0
    )
    for status in "${statuses[@]}"; do
        if [ -n "$status" ]; then
            status_counts[$status]=$((${status_counts[$status]} + 1))
        fi
    done

    json_output="{\"overall_status\": \"$overall_status\", \"status_counts\": {\"clean\": ${status_counts[clean]}, \"dirty\": ${status_counts[dirty]}, \"ahead\": ${status_counts[ahead]}, \"behind\": ${status_counts[behind]}, \"diverged\": ${status_counts[diverged]}, \"uninitialized\": ${status_counts[uninitialized]}, \"fetch_failed\": ${status_counts[fetch_failed]}}, \"repos\": ["

    first=true
    for i in "${!repos[@]}"; do
        if [ "${statuses[$i]}" != "clean" ]; then
            if [ "$first" = true ]; then
                first=false
            else
                json_output="$json_output,"
            fi

            repo_name_escaped=$(echo "${repos[$i]}" | sed 's/"/\\"/g')
            repo_path_escaped=$(echo "${paths[$i]}" | sed 's/"/\\"/g')

            json_output="$json_output{\"name\": \"$repo_name_escaped\", \"path\": \"$repo_path_escaped\", \"status\": \"${statuses[$i]}\"}"
        fi
    done

    json_output="$json_output]}"

    echo "$json_output"
    exit 0
fi

# Handle sync mode
if [ "$1" = "--sync" ] || [ "$1" = "-s" ]; then
    sync_repos "${paths[@]}"
    exit 0
fi

# Handle commit mode
if [ "$COMMIT_MODE" -eq 1 ]; then
    if [ -z "$COMMIT_TARGET" ] || [ "$COMMIT_TARGET" = "dirty" ]; then
        # Commit all dirty repos
        declare -a dirty_repos
        for i in "${!statuses[@]}"; do
            if [ "${statuses[$i]}" = "dirty" ]; then
                dirty_repos+=("${paths[$i]}")
            fi
        done
        
        if [ ${#dirty_repos[@]} -eq 0 ]; then
            echo "No dirty repositories found."
            exit 0
        fi
        
        commit_repos "${dirty_repos[@]}"
    else
        # Commit specific repo
        for i in "${!repos[@]}"; do
            if [ "${repos[$i]}" = "$COMMIT_TARGET" ]; then
                commit_repos "${paths[$i]}"
                exit 0
            fi
        done
        echo "Repository not found: $COMMIT_TARGET"
        exit 1
    fi
    exit 0
fi

# Group repositories by parent directory
declare -A dir_repos
declare -A dir_statuses

for i in "${!repos[@]}"; do
    parent=$(get_parent_dir "${paths[$i]}")

    if [ -z "${dir_repos[$parent]}" ]; then
        dir_repos[$parent]="$i"
        dir_statuses[$parent]="${statuses[$i]}"
    else
        dir_repos[$parent]="${dir_repos[$parent]},$i"
        # Update worst status
        current_worst="${dir_statuses[$parent]}"
        new_worst=$(get_worst_status "$current_worst" "${statuses[$i]}")
        dir_statuses[$parent]="$new_worst"
    fi
done

# Main loop with dialog
show_main_menu() {
    while true; do
        # Build menu items for directories
        local menu_items=()
        local dir_list=()
        for dir in "${!dir_repos[@]}"; do
            dir_list+=("$dir")
        done

        # Sort directories
        IFS=$'\n' dir_list=($(sort <<<"${dir_list[*]}"))
        unset IFS

        for i in "${!dir_list[@]}"; do
            dir="${dir_list[$i]}"
            icon=$(get_status_icon_plain "${dir_statuses[$dir]}")
            repo_count=$(echo "${dir_repos[$dir]}" | tr ',' '\n' | wc -l)
            menu_items+=("$((i+1))" "$icon $dir ($repo_count repos)")
        done
         menu_items+=("S" "🔄 Sync All Repos")
         menu_items+=("C" "💾 Commit Dirty Repos")
         menu_items+=("L" "📖 Legend")

        local choice
        choice=$(dialog --title "Git Repository Status" \
            --menu "Select a directory to view repositories:" \
            20 70 14 \
            "${menu_items[@]}" \
            2>&1 >/dev/tty) || {
            clear
            exit 0
        }

         if [ "$choice" = "S" ]; then
             sync_repos "${paths[@]}"
             exec "$0"
         fi

         if [ "$choice" = "C" ]; then
             # Collect dirty repos for committing
             declare -a dirty_repos
             for i in "${!statuses[@]}"; do
                 if [ "${statuses[$i]}" = "dirty" ]; then
                     dirty_repos+=("${paths[$i]}")
                 fi
             done
             
             if [ ${#dirty_repos[@]} -eq 0 ]; then
                 dialog --title "Info" --msgbox "No dirty repositories found." 6 40
             else
                 commit_repos "${dirty_repos[@]}"
                 exec "$0"
             fi
             continue
         fi

         if [ "$choice" = "L" ]; then
             show_legend
             continue
         fi

        local selected_dir_idx=$((choice - 1))
        local selected_dir="${dir_list[$selected_dir_idx]}"

        show_repo_menu "$selected_dir"
    done
}

show_legend() {
    local legend_text="$CLEAN  Clean - No uncommitted changes, up to date with remote\n"
    legend_text+="$DIRTY  Dirty - Has uncommitted changes or untracked files\n"
    legend_text+="$AHEAD  Ahead - Local commits not pushed to remote\n"
    legend_text+="$BEHIND  Behind - Remote has commits not pulled locally\n"
    legend_text+="$DIVERGED  Diverged - Both local and remote have new commits\n"
    legend_text+="$UNINITIALIZED  Uninitialized - No remote branches configured\n"
    legend_text+="$FETCH_FAILED  Fetch Failed - Could not reach remote"

    dialog --title "Status Legend" --msgbox "$legend_text" 13 60
}

show_repo_menu() {
    local selected_dir="$1"

    while true; do
        IFS=',' read -ra repo_indices <<< "${dir_repos[$selected_dir]}"

        local menu_items=()
        for i in "${!repo_indices[@]}"; do
            idx="${repo_indices[$i]}"
            icon=$(get_status_icon_plain "${statuses[$idx]}")
            local extra_info=""
            if [ "${statuses[$idx]}" = "fetch_failed" ]; then
                extra_info=" [fetch failed]"
            fi
            menu_items+=("$((i+1))" "$icon ${repos[$idx]}$extra_info")
        done
         menu_items+=("S" "🔄 Sync all in this directory")
         menu_items+=("C" "💾 Commit all dirty in this directory")
         menu_items+=("B" "⬅ Back to directory list")

        local choice
        choice=$(dialog --title "Repos in $selected_dir" \
            --menu "Select a repository to open in lazygit:" \
            20 70 12 \
            "${menu_items[@]}" \
            2>&1 >/dev/tty) || return

         if [ "$choice" = "B" ]; then
             return
         fi

         if [ "$choice" = "S" ]; then
             declare -a repos_to_sync_in_dir
             for i in "${!repo_indices[@]}"; do
                 repos_to_sync_in_dir+=("${paths[${repo_indices[$i]}]}")
             done
             sync_repos "${repos_to_sync_in_dir[@]}"
             exec "$0"
         fi

         if [ "$choice" = "C" ]; then
             declare -a repos_to_commit_in_dir
             for i in "${!repo_indices[@]}"; do
                 idx="${repo_indices[$i]}"
                 if [ "${statuses[$idx]}" = "dirty" ]; then
                     repos_to_commit_in_dir+=("${paths[$idx]}")
                 fi
             done
             
             if [ ${#repos_to_commit_in_dir[@]} -eq 0 ]; then
                 dialog --title "Info" --msgbox "No dirty repositories in this directory." 6 50
             else
                 commit_repos "${repos_to_commit_in_dir[@]}"
                 exec "$0"
             fi
             return
         fi

        local selected_repo_idx="${repo_indices[$((choice - 1))]}"
        local selected_path="${paths[$selected_repo_idx]}"

        clear
        cd "$selected_path"

        if command -v lazygit &> /dev/null; then
            lazygit
            dialog --title "Repository Status" --infobox "Rescanning repositories..." 5 40
            exec "$0"
        else
            dialog --title "Error" --msgbox "lazygit not found.\n\nInstall with: sudo pacman -S lazygit" 8 50
        fi
    done
}

show_main_menu
