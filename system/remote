tui_mount() {
    local items name user host proto is_default
    mapfile -t items < <(tui_build_remote_list)

    if [ ${#items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No remotes configured." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Mount Remote (SSHFS)" \
        --menu "Select a remote to mount:" 20 60 10 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    entry="$(get_entry_by_name "$choice")"
    IFS=',' read -r name user host proto is_default <<<"$entry"

    local remote_path=""
    remote_path=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Remote Path" \
        --inputbox "Remote path (blank for home dir):" 8 50 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    remote_path="$(trim "$remote_path")"

    local output
    if output=$(mount_remote "$user" "$host" "$name" "$remote_path" 2>&1); then
        "$DIALOG" --msgbox "Mount successful:\n\n${output}" 10 60
    else
        "$DIALOG" --msgbox "Mount failed:\n\n${output}" 10 60
    fi
}

tui_unmount() {
    local mount_items=()
    if [[ -d "$MOUNT_DIR" ]]; then
        for dir in "$MOUNT_DIR"/*/; do
            [[ -d "$dir" ]] || continue
            dir="${dir%/}"
            local dname
            dname="$(basename "$dir")"
            if mountpoint -q "$dir" 2>/dev/null; then
                mount_items+=("$dname" "$dir")
            fi
        done
    fi

    if [ ${#mount_items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No active SSHFS mounts." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Unmount Remote" \
        --menu "Select a mount to remove:" 20 60 10 \
        "${mount_items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    "$DIALOG" --yesno "Unmount '$choice'?" 6 30
    [ $? -ne 0 ] && return

    local output
    if output=$(unmount_remote "$choice" 2>&1); then
        "$DIALOG" --msgbox "Unmount successful:\n\n${output}" 10 60
    else
        "$DIALOG" --msgbox "Unmount failed:\n\n${output}" 10 60
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Core Functions
# ─────────────────────────────────────────────────────────────────────────────

connect_remote() {
    local user="$1"
    local host="$2"
    local proto="$3"
    local target="${user}@${host}"
    local max_retries=3
    local retry_delay=2

    printf "\033c"
    echo "Remote: $target (proto: $proto)"

    run_vnc() {
        local attempt=1
        local vnc_client=""
        local tunnel_pid=""

        # Prefer remmina for scaling support, fallback to tigervnc
        if command -v remmina &>/dev/null; then
            vnc_client="remmina"
        elif command -v vncviewer &>/dev/null; then
            vnc_client="vncviewer"
        else
            echo "No VNC client found. Install remmina or tigervnc." >&2
            return 1
        fi

        cleanup_tunnel() {
            if [ -n "$tunnel_pid" ] && kill -0 "$tunnel_pid" 2>/dev/null; then
                echo "Closing SSH tunnel (PID $tunnel_pid)..."
                kill "$tunnel_pid" 2>/dev/null
            fi
        }
        trap cleanup_tunnel EXIT INT TERM

        while :; do
            echo "Starting SSH tunnel to $target (attempt ${attempt}/${max_retries})..."
            ssh -o ConnectTimeout=10 -L 5900:localhost:5900 -N "$target" &
            tunnel_pid=$!
            sleep 1

            if ! kill -0 "$tunnel_pid" 2>/dev/null; then
                echo "SSH tunnel failed for $target." >&2
                tunnel_pid=""
            else
                echo "SSH tunnel established (PID $tunnel_pid)."
                echo "Launching VNC viewer ($vnc_client)..."
                case "$vnc_client" in
                    remmina)
                        remmina -c vnc://localhost:5900
                        ;;
                    vncviewer)
                        vncviewer localhost:5900
                        ;;
                esac
                status=$?
                cleanup_tunnel
                tunnel_pid=""
                if [ $status -eq 0 ]; then
                    echo "VNC viewer exited cleanly."
                    trap - EXIT INT TERM
                    return 0
                fi
                echo "VNC viewer exited with status $status." >&2
            fi

            if [ $attempt -lt $max_retries ]; then
                echo "Retrying in ${retry_delay}s..."
                sleep "$retry_delay"
                attempt=$((attempt + 1))
                continue
            fi

            read -rp "Failed after ${max_retries} attempts. Retry? (y/N): " retry_choice
            retry_choice="$(trim "$retry_choice")"
            if [ "${retry_choice,,}" = "y" ] || [ "${retry_choice,,}" = "yes" ]; then
                attempt=1
                continue
            fi
            trap - EXIT INT TERM
            return 1
        done
    }
    run_remote_setup() {
        local attempt=1
        while :; do
            echo "Initializing remote session on $target (attempt ${attempt}/${max_retries})..."
            echo "Running ~/remote-session.sh on remote host..."
            ssh -o ConnectTimeout=10 "$target" "~/remote-session.sh"
            status=$?
            if [ $status -eq 0 ]; then
                echo "Remote session initialized."
                return 0
            fi
            echo "Remote session setup failed for $target (exit $status)." >&2

            if [ $attempt -lt $max_retries ]; then
                echo "Retrying in ${retry_delay}s..."
                sleep "$retry_delay"
                attempt=$((attempt + 1))
                continue
            fi

            read -rp "Failed after ${max_retries} attempts. Retry? (y/N): " retry_choice
            retry_choice="$(trim "$retry_choice")"
            if [ "${retry_choice,,}" = "y" ] || [ "${retry_choice,,}" = "yes" ]; then
                attempt=1
                continue
            fi
            return 1
        done
    }

    case "$proto" in
        ssh)
            ssh "$target"
            status=$?
            if [ $status -ne 0 ]; then
                echo "SSH connection failed for $target (exit $status)." >&2
                return $status
            fi
            return 0
            ;;
        vnc)
            run_vnc || return 1
            return 0
            ;;
        garchyvnc)
            run_remote_setup || return 1
            run_vnc || return 1
            return 0
            ;;
        *)
            echo "Unknown protocol: $proto" >&2
            return 1
            ;;
    esac
}

mount_remote() {
    local user="$1"
    local host="$2"
    local name="$3"
    local remote_path="${4:-}"
    local target="${user}@${host}"
    local mount_point="${MOUNT_DIR}/${name}"

    if ! command -v sshfs &>/dev/null; then
        echo "sshfs not found. Install sshfs to use mount feature." >&2
        return 1
    fi

    if mountpoint -q "$mount_point" 2>/dev/null; then
        echo "Already mounted: $mount_point"
        return 0
    fi

    if [[ ! -d "$mount_point" ]]; then
        mkdir -p "$mount_point" 2>/dev/null || sudo mkdir -p "$mount_point"
        sudo chown "$(id -un):$(id -gn)" "$mount_point" 2>/dev/null || true
    fi

    local remote_spec="${target}:"
    if [[ -n "$remote_path" ]]; then
        remote_spec="${target}:${remote_path}"
    fi

    echo "Mounting ${remote_spec} -> ${mount_point} ..."
    if sshfs "$remote_spec" "$mount_point" \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=3 \
        -o reconnect \
        -o follow_symlinks \
        -o cache_timeout=60 \
        -o attr_timeout=60; then
        echo "Mounted successfully: $mount_point"
    else
        echo "Mount failed for ${remote_spec}" >&2
        rmdir "$mount_point" 2>/dev/null || sudo rmdir "$mount_point" 2>/dev/null || true
        return 1
    fi
}

unmount_remote() {
    local name="$1"
    local mount_point="${MOUNT_DIR}/${name}"

    if ! mountpoint -q "$mount_point" 2>/dev/null; then
        echo "Not mounted: $mount_point" >&2
        return 1
    fi

    # FUSE3 uses fusermount3, fall back to fusermount
    local fmount="fusermount3"
    if ! command -v fusermount3 &>/dev/null; then
        fmount="fusermount"
    fi

    echo "Unmounting ${mount_point} ..."
    if "$fmount" -u "$mount_point" 2>/dev/null; then
        echo "Unmounted successfully: $mount_point"
        rmdir "$mount_point" 2>/dev/null || sudo rmdir "$mount_point" 2>/dev/null || true
    elif "$fmount" -uz "$mount_point" 2>/dev/null; then
        echo "Lazy unmounted (stale mount): $mount_point"
        rmdir "$mount_point" 2>/dev/null || sudo rmdir "$mount_point" 2>/dev/null || true
    else
        echo "Unmount failed for ${mount_point}" >&2
        return 1
    fi
}

list_mounts() {
    local found=0
    if [[ -d "$MOUNT_DIR" ]]; then
        for dir in "$MOUNT_DIR"/*/; do
            [[ -d "$dir" ]] || continue
            dir="${dir%/}"
            local name
            name="$(basename "$dir")"
            if mountpoint -q "$dir" 2>/dev/null; then
                echo "$name (mounted)"
                found=1
            fi
        done
    fi
    if [[ $found -eq 0 ]]; then
        echo "No active SSHFS mounts."
    fi
}

get_entry_by_name() {
    local name="$1"
    awk -F',' -v name="$name" '
        BEGIN { OFS = "," }
        /^[[:space:]]*(#|$)/ { next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 == name) { print $0; exit }
        }
    ' "$CONFIG_FILE"
}

get_default_entry() {
    awk -F',' '
        BEGIN { OFS = "," }
        /^[[:space:]]*(#|$)/ { next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($5 == "default") { print $0; exit }
        }
    ' "$CONFIG_FILE"
}

list_entries() {
    awk -F',' '
        BEGIN { OFS = "," }
        /^[[:space:]]*(#|$)/ { next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            marker = ($5 == "default") ? " *" : ""
            printf "%s%s\n", $1, marker
        }
    ' "$CONFIG_FILE"
}

set_default() {
    local name="$1"
    local tmp
    tmp="$(mktemp)"
    awk -F',' -v name="$name" '
        BEGIN { OFS = ","; found = 0 }
        /^[[:space:]]*(#|$)/ { print; next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 == name) { $5 = "default"; found = 1 }
            else { $5 = "" }
            print
        }
        END { if (!found) exit 2 }
    ' "$CONFIG_FILE" > "$tmp"

    if [ $? -ne 0 ]; then
        rm -f "$tmp"
        echo "No such remote: $name" >&2
        exit 1
    fi

    mv "$tmp" "$CONFIG_FILE"
}

add_entry() {
    local name user host proto make_default

    read -rp "Name: " name
    name="$(trim "$name")"
    if [ -z "$name" ]; then
        echo "Name is required." >&2
        exit 1
    fi

    if [ -n "$(get_entry_by_name "$name")" ]; then
        echo "Remote already exists: $name" >&2
        exit 1
    fi

    read -rp "User: " user
    user="$(trim "$user")"
    read -rp "Host: " host
    host="$(trim "$host")"

    while :; do
        read -rp "Protocol (ssh/vnc/garchyvnc): " proto
        proto="$(trim "$proto")"
        case "$proto" in
            ssh|vnc|garchyvnc) break ;;
            *) echo "Please enter 'ssh', 'vnc', or 'garchyvnc'." >&2 ;;
        esac
    done

    read -rp "Set as default? (y/N): " make_default
    make_default="$(trim "$make_default")"

    printf "%s,%s,%s,%s,%s\n" "$name" "$user" "$host" "$proto" "" >> "$CONFIG_FILE"

    if [ "${make_default,,}" = "y" ] || [ "${make_default,,}" = "yes" ]; then
        set_default "$name"
    fi
}

random_entry() {
    local user host proto
    read -rp "User: " user
    user="$(trim "$user")"
    read -rp "Host: " host
    host="$(trim "$host")"

    while :; do
        read -rp "Protocol (ssh/vnc/garchyvnc): " proto
        proto="$(trim "$proto")"
        case "$proto" in
            ssh|vnc|garchyvnc) break ;;
            *) echo "Please enter 'ssh', 'vnc', or 'garchyvnc'." >&2 ;;
        esac
    done

    connect_remote "$user" "$host" "$proto"
}

usage() {
    cat <<'EOF'
Usage: remote [options] [name]

TUI Mode (default when no arguments):
  remote              Launch interactive TUI menu

CLI Mode:
  remote <name>       Connect to a saved remote by name
  remote -l, --list   List saved remotes (default marked with *)
  remote -a, --add    Add a new remote
  remote -e, --edit <name>     Edit an existing remote
  remote -d, --default <name>  Set default remote
  remote -r, --random Ad-hoc connection (not saved)
  remote -D, --delete <name>   Delete a remote
  remote -c, --connect <name>  Connect to a saved remote
  remote -m, --mount <name> [path]  Mount remote via SSHFS (home dir by default)
  remote -u, --unmount <name>  Unmount a mounted remote
  remote --mounts              List active SSHFS mounts
  remote -h, --help   Show this help

SSHFS mounts are created under /mnt/<remote-name>.
If dialog/whiptail is not available, falls back to CLI prompts.
EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# CLI Entry Point
# ─────────────────────────────────────────────────────────────────────────────

delete_entry() {
    local name="$1"
    local tmp
    tmp="$(mktemp)"

    if [ -z "$(get_entry_by_name "$name")" ]; then
        echo "No such remote: $name" >&2
        exit 1
    fi

    awk -F',' -v name="$name" '
        /^[[:space:]]*(#|$)/ { print; next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 != name) print
        }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    echo "Deleted: $name"
}

edit_entry() {
    local name="$1"
    local entry new_name new_user new_host new_proto

    entry="$(get_entry_by_name "$name")"
    if [ -z "$entry" ]; then
        echo "No such remote: $name" >&2
        exit 1
    fi

    IFS=',' read -r old_name old_user old_host old_proto old_default <<<"$entry"

    read -rp "Name [$old_name]: " new_name
    new_name="$(trim "$new_name")"
    [ -z "$new_name" ] && new_name="$old_name"

    if [ "$new_name" != "$old_name" ] && [ -n "$(get_entry_by_name "$new_name")" ]; then
        echo "Remote already exists: $new_name" >&2
        exit 1
    fi

    read -rp "User [$old_user]: " new_user
    new_user="$(trim "$new_user")"
    [ -z "$new_user" ] && new_user="$old_user"

    read -rp "Host [$old_host]: " new_host
    new_host="$(trim "$new_host")"
    [ -z "$new_host" ] && new_host="$old_host"

    while :; do
        read -rp "Protocol (ssh/vnc/garchyvnc) [$old_proto]: " new_proto
        new_proto="$(trim "$new_proto")"
        [ -z "$new_proto" ] && new_proto="$old_proto"
        case "$new_proto" in
            ssh|vnc|garchyvnc) break ;;
            *) echo "Please enter 'ssh', 'vnc', or 'garchyvnc'." >&2 ;;
        esac
    done

    local tmp
    tmp="$(mktemp)"
    awk -F',' -v oldname="$old_name" -v newname="$new_name" -v newuser="$new_user" \
        -v newhost="$new_host" -v newproto="$new_proto" '
        BEGIN { OFS = "," }
        /^[[:space:]]*(#|$)/ { print; next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 == oldname) {
                $1 = newname
                $2 = newuser
                $3 = newhost
                $4 = newproto
            }
            print
        }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    echo "Updated: $new_name"
}

case "${1:-}" in
    -l|--list|list)
        list_entries
        ;;
    -a|--add|add)
        add_entry
        ;;
    -e|--edit|edit)
        if [ -z "$2" ]; then
            echo "Missing name to edit." >&2
            exit 1
        fi
        edit_entry "$2"
        ;;
    -d|--default|default)
        if [ -z "$2" ]; then
            echo "Missing name for default." >&2
            exit 1
        fi
        set_default "$2"
        ;;
    -D|--delete|delete)
        if [ -z "$2" ]; then
            echo "Missing name to delete." >&2
            exit 1
        fi
        delete_entry "$2"
        ;;
    -m|--mount|mount)
        if [ -z "${2:-}" ]; then
            echo "Missing name to mount." >&2
            exit 1
        fi
        entry="$(get_entry_by_name "$2")"
        if [ -z "$entry" ]; then
            echo "No such remote: $2" >&2
            exit 1
        fi
        IFS=',' read -r name user host proto is_default <<<"$entry"
        mount_remote "$user" "$host" "$name" "${3:-}"
        ;;
    -u|--unmount|unmount)
        if [ -z "${2:-}" ]; then
            echo "Missing name to unmount." >&2
            exit 1
        fi
        unmount_remote "$2"
        ;;
    --mounts|mounts)
        list_mounts
        ;;
    -r|--random|random)
        random_entry
        ;;
    -c|--connect)
        if [ -z "$2" ]; then
            echo "Missing name for connect." >&2
            exit 1
        fi
        entry="$(get_entry_by_name "$2")"
        if [ -z "$entry" ]; then
            echo "No such remote: $2" >&2
            exit 1
        fi
        IFS=',' read -r name user host proto is_default <<<"$entry"
        connect_remote "$user" "$host" "$proto"
        ;;
    "" )
        # No arguments: launch TUI if available, else show help
        if [ -n "$DIALOG" ]; then
            tui_main_menu
        else
            entry="$(get_default_entry)"
            if [ -z "$entry" ]; then
                echo "No default remote set (install 'dialog' for TUI)." >&2
                usage
                exit 1
            fi
            IFS=',' read -r name user host proto is_default <<<"$entry"
            connect_remote "$user" "$host" "$proto"
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    -*)
        echo "Unknown option: $1" >&2
        usage
        exit 1
        ;;
    *)
        entry="$(get_entry_by_name "$1")"
        if [ -z "$entry" ]; then
            echo "No such remote: $1" >&2
            usage
            exit 1
        fi
        IFS=',' read -r name user host proto is_default <<<"$entry"
        connect_remote "$user" "$host" "$proto"
        ;;
esac
