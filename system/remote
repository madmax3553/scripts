# Script: remote
# Purpose: Remote server connection manager
# Dependencies: ssh, sshfs (for mount), dialog or whiptail
# Author: groot
# Modified: 2026-04-04

set -euo pipefail
CONFIG_FILE="$HOME/.config/remotes"
MOUNT_DIR="/mnt"
TUI_ACTIVE=0

# Clear screen on exit only when TUI was active (prevents dialog artifacts)
cleanup_exit() {
    if [[ $TUI_ACTIVE -eq 1 ]]; then
        clear
    fi
}
trap cleanup_exit EXIT

mkdir -p "$(dirname "$CONFIG_FILE")"
touch "$CONFIG_FILE"

# Detect dialog tool
if command -v dialog &>/dev/null; then
    DIALOG=dialog
elif command -v whiptail &>/dev/null; then
    DIALOG=whiptail
else
    DIALOG=""
fi

trim() {
    echo "$1" | xargs
}

detect_terminal() {
    if command -v ghostty &>/dev/null; then
        echo "ghostty"
    elif command -v kitty &>/dev/null; then
        echo "kitty"
    elif command -v alacritty &>/dev/null; then
        echo "alacritty"
    elif command -v foot &>/dev/null; then
        echo "foot"
    elif command -v wezterm &>/dev/null; then
        echo "wezterm"
    elif command -v xterm &>/dev/null; then
        echo "xterm"
    else
        echo ""
    fi
}

spawn_terminal() {
    local title="$1"
    shift
    local term
    term="$(detect_terminal)"

    case "$term" in
        ghostty)
            ghostty --title="$title" -e "$@" &
            ;;
        kitty)
            kitty --title "$title" "$@" &
            ;;
        alacritty)
            alacritty --title "$title" -e "$@" &
            ;;
        foot)
            foot --title "$title" "$@" &
            ;;
        wezterm)
            wezterm start --cwd "$(pwd)" -- "$@" &
            ;;
        xterm)
            xterm -title "$title" -e "$@" &
            ;;
        *)
            return 1
            ;;
    esac
    disown
    return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# TUI Functions
# ─────────────────────────────────────────────────────────────────────────────

tui_main_menu() {
    TUI_ACTIVE=1
    while :; do
        choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
            --title "Main Menu" \
            --menu "Select an option:" 20 50 10 \
            1 "Connect to remote" \
            2 "Mount remote (SSHFS)" \
            3 "Unmount remote" \
            4 "Add new remote" \
            5 "Edit remote" \
            6 "Set default remote" \
            7 "Delete remote" \
            8 "Ad-hoc connection" \
            9 "Exit" \
            3>&1 1>&2 2>&3)

        exit_status=$?
        [ $exit_status -ne 0 ] && break

        # Temporarily disable errexit so failed actions don't kill the TUI
        set +e
        case "$choice" in
            1) tui_connect ;;
            2) tui_mount ;;
            3) tui_unmount ;;
            4) tui_add ;;
            5) tui_edit ;;
            6) tui_set_default ;;
            7) tui_delete ;;
            8) tui_adhoc ;;
            9) break ;;
        esac
        set -e
    done
    clear
}

tui_build_remote_list() {
    awk -F',' '
        /^[[:space:]]*(#|$)/ { next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            def = ($5 == "default") ? " *" : ""
            printf "%s\n%s@%s (%s)%s\n", $1, $2, $3, $4, def
        }
    ' "$CONFIG_FILE"
}

tui_connect() {
    local items name user host proto is_default
    mapfile -t items < <(tui_build_remote_list)

    if [ ${#items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No remotes configured." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Connect to Remote" \
        --menu "Select a remote:" 20 60 10 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    entry="$(get_entry_by_name "$choice")"
    IFS=',' read -r name user host proto is_default <<<"$entry"

    local target="${user}@${host}"

    case "$proto" in
        ssh)
            if spawn_terminal "SSH: ${target}" ssh "$target"; then
                "$DIALOG" --msgbox "SSH session launched in new terminal:\n${target}" 8 50
            else
                "$DIALOG" --msgbox "No terminal emulator found.\nCannot spawn SSH in new window." 8 50
            fi
            ;;
        vnc|garchyvnc)
            # VNC runs its own GUI window, run in background
            if connect_remote "$user" "$host" "$proto" 2>&1; then
                "$DIALOG" --msgbox "VNC session launched for ${target}." 7 50
            else
                "$DIALOG" --msgbox "VNC connection failed for ${target}." 7 50
            fi
            ;;
    esac
}

tui_add() {
    local name user host proto make_default

    name=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Add Remote" \
        --inputbox "Name:" 8 40 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    name="$(trim "$name")"

    if [ -z "$name" ]; then
        "$DIALOG" --msgbox "Name is required." 6 40
        return
    fi

    if [ -n "$(get_entry_by_name "$name")" ]; then
        "$DIALOG" --msgbox "Remote already exists: $name" 6 40
        return
    fi

    user=$("$DIALOG" --clear --inputbox "User:" 8 40 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    user="$(trim "$user")"

    host=$("$DIALOG" --clear --inputbox "Host:" 8 40 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    host="$(trim "$host")"

    proto=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Protocol" \
        --menu "Select protocol:" 12 40 3 \
        ssh "SSH terminal" \
        vnc "VNC (tunnel)" \
        garchyvnc "VNC with remote setup" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return

    "$DIALOG" --yesno "Set as default?" 6 30
    if [ $? -eq 0 ]; then
        make_default="yes"
    else
        make_default=""
    fi

    printf "%s,%s,%s,%s,%s\n" "$name" "$user" "$host" "$proto" "" >> "$CONFIG_FILE"

    if [ "$make_default" = "yes" ]; then
        set_default "$name"
    fi

    "$DIALOG" --msgbox "Remote '$name' added." 6 40
}

tui_set_default() {
    local items
    mapfile -t items < <(tui_build_remote_list)

    if [ ${#items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No remotes configured." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Set Default Remote" \
        --menu "Select a remote:" 20 60 10 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    set_default "$choice"
    "$DIALOG" --msgbox "'$choice' is now the default." 6 40
}

tui_delete() {
    local items
    mapfile -t items < <(tui_build_remote_list)

    if [ ${#items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No remotes configured." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Delete Remote" \
        --menu "Select a remote to delete:" 20 60 10 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    "$DIALOG" --yesno "Delete '$choice'?" 6 30
    [ $? -ne 0 ] && return

    local tmp
    tmp="$(mktemp)"
    awk -F',' -v name="$choice" '
        /^[[:space:]]*(#|$)/ { print; next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 != name) print
        }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    "$DIALOG" --msgbox "'$choice' deleted." 6 40
}

tui_edit() {
    local items name user host proto is_default
    mapfile -t items < <(tui_build_remote_list)

    if [ ${#items[@]} -eq 0 ]; then
        "$DIALOG" --msgbox "No remotes configured." 6 40
        return
    fi

    choice=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Edit Remote" \
        --menu "Select a remote to edit:" 20 60 10 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && return

    entry="$(get_entry_by_name "$choice")"
    IFS=',' read -r name user host proto is_default <<<"$entry"

    # Edit name
    new_name=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Edit Remote: $name" \
        --inputbox "Name:" 8 40 "$name" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    new_name="$(trim "$new_name")"
    [ -z "$new_name" ] && new_name="$name"

    # Check for name conflict if renamed
    if [ "$new_name" != "$name" ] && [ -n "$(get_entry_by_name "$new_name")" ]; then
        "$DIALOG" --msgbox "Remote already exists: $new_name" 6 40
        return
    fi

    # Edit user
    new_user=$("$DIALOG" --clear --inputbox "User:" 8 40 "$user" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    new_user="$(trim "$new_user")"
    [ -z "$new_user" ] && new_user="$user"

    # Edit host
    new_host=$("$DIALOG" --clear --inputbox "Host:" 8 40 "$host" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return
    new_host="$(trim "$new_host")"
    [ -z "$new_host" ] && new_host="$host"

    # Edit protocol
    new_proto=$("$DIALOG" --clear --backtitle "Remote Connection Manager" \
        --title "Protocol" \
        --default-item "$proto" \
        --menu "Select protocol:" 12 40 3 \
        ssh "SSH terminal" \
        vnc "VNC (tunnel)" \
        garchyvnc "VNC with remote setup" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && return

    # Update the entry
    local tmp
    tmp="$(mktemp)"
    awk -F',' -v oldname="$name" -v newname="$new_name" -v newuser="$new_user" \
        -v newhost="$new_host" -v newproto="$new_proto" '
        BEGIN { OFS = "," }
        /^[[:space:]]*(#|$)/ { print; next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 == oldname) {
                $1 = newname
                $2 = newuser
                $3 = newhost
                $4 = newproto
            }
            print
        }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    "$DIALOG" --msgbox "Remote '$new_name' updated." 6 40
}

