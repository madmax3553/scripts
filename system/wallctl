                local apply_choice=0
                printf "\n"
                if menu_select apply_choice \
                    "random          set a random wallpaper" \
                    "pick            choose from thumbnails" \
                    "path            enter a file path"; then
                    case "$apply_choice" in
                        1) cmd_apply random ;;
                        2) cmd_apply --pick ;;
