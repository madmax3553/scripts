cleanup() {
    local code=$?
    local _pid

    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -P $$ 2>/dev/null || true
    fi
    while read -r _pid; do
        kill "$_pid" 2>/dev/null || true
    done < <(jobs -pr 2>/dev/null || true)

    _spinner_kill 2>/dev/null

    if command -v pkill >/dev/null 2>&1; then
        pkill -KILL -P $$ 2>/dev/null || true
    fi
    while read -r _pid; do
        wait "$_pid" 2>/dev/null || true
    done < <(jobs -pr 2>/dev/null || true)

    unpin_header 2>/dev/null
    if [[ -e /dev/tty ]]; then
        stty sane </dev/tty 2>/dev/null || true
        # Reset common terminal modes (cursor, wrapping, scroll region, mouse, bracketed paste).
        printf '\033[0m\033[?25h\033[?7h\033[r\033[?1l\033[?1000l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l\033[?2004l\033[?1049l' >/dev/tty 2>/dev/null || true
    fi
    if [[ $code -eq 0 && -t 1 && $CLEAR_ON_EXIT -eq 1 ]]; then
        clear
    fi
}

