# ─────────────────────────────────────────────────────────────────────────────
# Media helpers
# ─────────────────────────────────────────────────────────────────────────────

count_media() {
    local dir="$1"
    find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
         -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' \) 2>/dev/null | wc -l
}

valid_ext() {
    [[ "$1" =~ \.(jpg|jpeg|png|webp|gif|mp4|webm)$ ]]
}

is_live_url() {
    local lower
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    [[ "$lower" =~ \.(gif|gifv|mp4|webm)(\?.*)?$ ]]
}

is_live_file() {
    local lower
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    [[ "$lower" =~ \.(gif|mp4|webm)$ ]]
}

list_pool_dirs() {
    local pool="$1"
    case "$pool" in
        current)
            printf '%s\n' "$WALLPAPER_DIR_CURRENT"
            ;;
        new)
            printf '%s\n' "$WALLPAPER_DIR_NEW"
            ;;
        current+new|new+current)
            printf '%s\n' "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_NEW"
            ;;
        current+old|old+current)
            printf '%s\n' "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_OLD"
            ;;
        new+old|old+new)
            printf '%s\n' "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_OLD"
            ;;
        current+new+old|current+old+new|new+current+old|new+old+current|old+current+new|old+new+current)
            printf '%s\n' "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_OLD"
            ;;
        old)
            printf '%s\n' "$WALLPAPER_DIR_OLD"
            ;;
        *)
            printf '%s\n' "$WALLPAPER_DIR_CURRENT"
            ;;
    esac
}

pool_dir() {
    case "$1" in
        new) printf '%s\n' "$WALLPAPER_DIR_NEW" ;;
        current) printf '%s\n' "$WALLPAPER_DIR_CURRENT" ;;
        old) printf '%s\n' "$WALLPAPER_DIR_OLD" ;;
        *) return 1 ;;
    esac
}

get_dimensions() {
    local file="$1"
    local dims
    dims=$(identify -ping -format '%w %h' "$file" 2>/dev/null || true)
    if [[ "$dims" =~ ^[0-9]+[[:space:]][0-9]+$ ]]; then
        printf '%s\n' "$dims"
    else
        printf '0 0\n'
    fi
}

get_video_dimensions() {
    local file="$1"
    local dims
    if ! command -v ffprobe >/dev/null 2>&1; then
        printf '0 0\n'
        return 0
    fi
    dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height \
           -of csv=s=x:p=0 "$file" 2>/dev/null || true)
    if [[ "$dims" =~ ^[0-9]+x[0-9]+$ ]]; then
        printf '%s\n' "${dims/x/ }"
    else
        printf '0 0\n'
    fi
}

get_media_dimensions() {
    local file="$1"
    if is_live_file "$file"; then
        get_video_dimensions "$file"
    else
        get_dimensions "$file"
    fi
}

is_selectable_wallpaper() {
    local file="$1"
    local w h
    read -r w h <<< "$(get_media_dimensions "$file")"
    (( w >= MIN_WIDTH && h >= MIN_HEIGHT )) || return 1
    if (( LANDSCAPE_ONLY == 1 )); then
        (( w >= h )) || return 1
    fi
    return 0
}

pick_random_wallpaper() {
    local pool="$1"
    local dir file
    local candidates=()

    while IFS= read -r dir; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r -d '' file; do
            if is_selectable_wallpaper "$file"; then
                candidates+=("$file")
            fi
        done < <(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
                      -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \
                      -o -iname '*.mp4' -o -iname '*.webm' \) -print0)
    done < <(list_pool_dirs "$pool")

    if (( ${#candidates[@]} == 0 )); then
        return 1
    fi
    printf '%s\n' "${candidates[$RANDOM % ${#candidates[@]}]}"
}

warn_if_over_limit() {
    local count
    count=$(count_media "$WALLPAPER_DIR_CURRENT")
    if (( count > MAX_CURRENT_WARN )); then
        print_warn "current has $count wallpapers (limit warning: $MAX_CURRENT_WARN)"
    fi
}

duplicate_count() {
    python3 - "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_OLD" <<'PY'
import hashlib, sys
from pathlib import Path
dirs=[Path(p) for p in sys.argv[1:]]
hashes={}
dups=0
for d in dirs:
    if not d.exists():
        continue
    for f in d.iterdir():
        if not f.is_file():
            continue
        h=hashlib.sha256(f.read_bytes()).hexdigest()
        if h in hashes:
            dups+=1
        else:
            hashes[h]=f
print(dups)
PY
}

duplicate_report() {
    local dups
    dups=$(duplicate_count)
    if (( dups > 0 )); then
        print_warn "detected $dups duplicate file(s) across current/new/old"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Hash tracking
# ─────────────────────────────────────────────────────────────────────────────

purge_seen_hash_log() {
    [[ -f "$SEEN_HASH_LOG" ]] || return 0
    python3 - "$SEEN_HASH_LOG" "$HASH_RETENTION_DAYS" <<'PY'
import time, sys
from pathlib import Path

path = Path(sys.argv[1])
days = int(sys.argv[2])
cutoff = int(time.time()) - (days * 86400)

rows = []
for line in path.read_text(errors='ignore').splitlines():
    parts = line.split('\t', 2)
    if len(parts) < 2:
        continue
    try:
        ts = int(parts[0])
    except ValueError:
        continue
    if ts >= cutoff:
        rows.append((ts, parts[1], parts[2] if len(parts) > 2 else ''))

latest = {}
for ts, h, src in rows:
    prev = latest.get(h)
    if prev is None or ts > prev[0]:
        latest[h] = (ts, src)

out = sorted(((ts, h, src) for h, (ts, src) in latest.items()), key=lambda x: x[0])
with path.open('w') as f:
    for ts, h, src in out:
        f.write(f"{ts}\t{h}\t{src}\n")
PY
}

hash_seen_recent() {
    local hash="$1"
    [[ -f "$SEEN_HASH_LOG" ]] || return 1
    awk -F '\t' -v h="$hash" '$2 == h { found=1; exit } END { exit(found ? 0 : 1) }' "$SEEN_HASH_LOG"
}

record_seen_hash() {
    local hash="$1"
    local src="$2"
    printf '%s\t%s\t%s\n' "$(date +%s)" "$hash" "$src" >> "$SEEN_HASH_LOG"
}

build_hash_cache() {
    : > "$STATE_DIR/hashes.txt"
    find "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_OLD" \
         -maxdepth 1 -type f -print0 2>/dev/null | while IFS= read -r -d '' file; do
        sha256sum "$file"
    done >> "$STATE_DIR/hashes.txt" || true
}

# ─────────────────────────────────────────────────────────────────────────────
# Download engine
# ─────────────────────────────────────────────────────────────────────────────

download_image() {
    local url="$1"
    local base name out w h hash
    base=$(basename "${url%%\?*}")
    if [[ "$base" == *.gifv ]]; then
        url="${url%.gifv}.mp4"
        base="${base%.gifv}.mp4"
    fi
    [[ -z "$base" ]] && return 1
    name=$(printf '%s' "$base" | tr -cd '[:alnum:]._-')
    valid_ext "${name,,}" || return 1
    out="$WALLPAPER_DIR_NEW/$name"

    if [[ -f "$out" ]]; then
        return 1
    fi
    if ! curl -L --fail --max-time "$FETCH_TIMEOUT" -A "$USER_AGENT" -sS "$url" -o "$out"; then
        rm -f "$out"
        return 1
    fi

    read -r w h <<< "$(get_media_dimensions "$out")"
    if (( w < MIN_WIDTH || h < MIN_HEIGHT )); then
        rm -f "$out"
        return 1
    fi
    if (( LANDSCAPE_ONLY == 1 && h > w )); then
        rm -f "$out"
        return 1
    fi

    hash=$(sha256sum "$out" | awk '{print $1}')
    if grep -q "^$hash " "$STATE_DIR/hashes.txt" 2>/dev/null; then
        print_warn "duplicate skipped: $name"
        rm -f "$out"
        return 1
    fi
    if hash_seen_recent "$hash"; then
        print_warn "seen recently skipped: $name"
        rm -f "$out"
        return 1
    fi
    printf '%s %s\n' "$hash" "$out" >> "$STATE_DIR/hashes.txt"
    record_seen_hash "$hash" "$url"
    return 0
}

github_urls_for_source() {
    local source="$1"
    local repo path_ref path ref api

    [[ "$source" == *:* ]] || return 0
    repo="${source%%:*}"
    path_ref="${source#*:}"
    path="$path_ref"
    ref=""

    if [[ "$path_ref" == *"@"* ]]; then
        path="${path_ref%@*}"
        ref="${path_ref##*@}"
    fi

    api="https://api.github.com/repos/${repo}/contents/${path}"
    if [[ -n "$ref" ]]; then
        api="${api}?ref=${ref}"
    fi

    curl -A "$USER_AGENT" -sS "$api" | jq -r \
        'if type=="array" then .[] | select(.type=="file") | .download_url // empty else empty end'
}

