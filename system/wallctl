purge_trash() {
    if [[ -d "$TRASH_DIR" ]]; then
        local count
        count=$(find "$TRASH_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
        rm -rf "${TRASH_DIR:?}"/*
        if (( count > 0 )); then
            print_info "purged $count file(s) from trash"
        fi
    fi
}

cmd_trash() {
    load_config
    local action="${1:-list}"
    case "$action" in
        --list|list)
            clear
            print_groot_logo
            print_header "trash"
            if [[ -d "$TRASH_DIR" ]]; then
                local count
                count=$(find "$TRASH_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
                print_info "$count file(s) in trash"
                find "$TRASH_DIR" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort
            else
                print_info "trash is empty"
            fi
            ;;
        --purge|purge)
            clear
            print_groot_logo
            print_header "trash"
            purge_trash
            ;;
        *)
            die "Usage: $SCRIPT_NAME trash [--list|--purge]"
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard renderer (shared by menu + status)
# ─────────────────────────────────────────────────────────────────────────────

render_dashboard() {
    local new_count current_count old_count trash_count dups saver_state

    new_count=$(count_media "$WALLPAPER_DIR_NEW")
    current_count=$(count_media "$WALLPAPER_DIR_CURRENT")
    old_count=$(count_media "$WALLPAPER_DIR_OLD")
    trash_count=$(find "$TRASH_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
    dups=$(duplicate_count)

    if screensaver_is_running; then
        saver_state="on"
    else
        saver_state="off"
    fi

    printf "\n"
    printf "  ${BOLD}%-20s${RESET} %-6s" "inbox (new)" "$new_count"
    if (( new_count > 0 )); then
        printf "  ${DIM}unreviewed downloads${RESET}"
    fi
    printf "\n"

    printf "  ${BOLD}%-20s${RESET} %-6s" "active (current)" "$current_count"
    if (( current_count > MAX_CURRENT_WARN )); then
        printf "  ${YELLOW}over limit (%s)${RESET}" "$MAX_CURRENT_WARN"
    fi
    printf "\n"

    printf "  ${BOLD}%-20s${RESET} %-6s\n" "archive (old)" "$old_count"

    if (( dups > 0 )); then
        printf "  ${BOLD}%-20s${RESET} %-6s  ${YELLOW}run dedupe${RESET}\n" "duplicates" "$dups"
    fi

    if (( trash_count > 0 )); then
        printf "  ${DIM}%-20s %-6s${RESET}\n" "trash" "$trash_count"
    fi

    printf "\n"
    printf "  ${BOLD}%-20s${RESET} %-6s  %s, %ss, pool: %s\n" \
           "screensaver" "$saver_state" "$SCREENSAVER_MODE" "$SCREENSAVER_INTERVAL" "$SCREENSAVER_POOL"
    printf "  ${BOLD}%-20s${RESET} %-6s  pool: %s\n" \
           "rotation" "on" "$ROTATION_POOL"
    printf "\n"

    # Return values for suggested action
    DASH_NEW_COUNT="$new_count"
    DASH_CURRENT_COUNT="$current_count"
    DASH_DUPS="$dups"
}

suggest_action() {
    local suggestion=""
    if (( DASH_NEW_COUNT > 0 )); then
        suggestion="review $DASH_NEW_COUNT inbox wallpapers"
    elif (( DASH_DUPS > 0 )); then
        suggestion="run dedupe to clean $DASH_DUPS duplicate(s)"
    elif (( DASH_CURRENT_COUNT > MAX_CURRENT_WARN )); then
        suggestion="archive: current ($DASH_CURRENT_COUNT) is over limit ($MAX_CURRENT_WARN)"
    elif (( DASH_NEW_COUNT == 0 )); then
        suggestion="download new wallpapers"
    fi

    if [[ -n "$suggestion" ]]; then
        printf "  ${CYAN}-> suggested: %s${RESET}\n\n" "$suggestion"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_fetch
# ─────────────────────────────────────────────────────────────────────────────

cmd_fetch() {
    local limit="$FETCH_LIMIT"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit)
                [[ $# -ge 2 ]] || die "--limit requires a numeric value"
                [[ "$2" =~ ^[0-9]+$ ]] || die "--limit must be numeric"
                limit="$2"
                shift 2
                ;;
            *) die "Unknown fetch flag: $1" ;;
        esac
    done

    require_commands curl jq identify sha256sum
    load_config
    clear
    print_groot_logo
    print_header "download wallpapers"
    if (( ${#GITHUB_SOURCES[@]} > 0 )); then
        TOTAL_STEPS=6
    else
        TOTAL_STEPS=5
    fi
    STEP=0
    print_step "prepare directories and duplicate hash cache"
    purge_seen_hash_log
    purge_trash
    build_hash_cache

    local imported=0 imported_live=0 imported_static=0 processed=0
    local url
    local target="$limit"
    local target_live target_static
    local wallhaven_batch reddit_batch

    target_live=$(( target * LIVE_RATIO / 100 ))
    target_static=$(( target - target_live ))

    if (( target > 0 && target_live == 0 && LIVE_RATIO > 0 )); then
        target_live=1
        target_static=$(( target - 1 ))
    fi

    if (( target_live > target )); then
        target_live=$target
        target_static=0
    fi

    print_step "fetch wallhaven themed wallpapers"
    local q urls
    wallhaven_batch=$(( limit * 3 ))
    (( wallhaven_batch < 15 )) && wallhaven_batch=15
    for q in "${KEYWORDS[@]}"; do
        (( imported >= target )) && break
        spinner_tick "wallhaven: $q ($imported/$target)"
        urls=$(curl -A "$USER_AGENT" -sS \
            "https://wallhaven.cc/api/v1/search?q=${q}&categories=111&purity=${WALLHAVEN_PURITY}&sorting=${WALLHAVEN_SORT}&atleast=${MIN_WIDTH}x${MIN_HEIGHT}" \
            | jq -r '.data[].path' | head -n "$wallhaven_batch")
        while IFS= read -r url; do
            (( imported >= target )) && break
            [[ -z "$url" ]] && continue
            local live=0
            is_live_url "$url" && live=1
            if (( live == 1 && imported_live >= target_live )); then
                continue
            fi
            if (( live == 0 && imported_static >= target_static )); then
                continue
            fi
            processed=$((processed + 1))
            spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
            if download_image "$url"; then
                imported=$((imported + 1))
                if (( live == 1 )); then
                    imported_live=$((imported_live + 1))
                else
                    imported_static=$((imported_static + 1))
                fi
            fi
        done <<< "$urls"
    done
    spinner_clear

    print_step "fetch reddit themed wallpapers"
    local sub reddit_urls
    reddit_batch=$(( limit * 3 ))
    (( reddit_batch < 20 )) && reddit_batch=20
    for sub in "${REDDIT_SUBS[@]}"; do
        (( imported >= target )) && break
        spinner_tick "reddit: r/$sub ($imported/$target)"
        # Extract image/video URLs from reddit listings
        reddit_urls=$(curl -A "$USER_AGENT" -sS \
            "https://www.reddit.com/r/${sub}/top.json?t=month&limit=${reddit_batch}" \
            | jq -r '
                .data.children[].data |
                (
                    .url_overridden_by_dest // .url,
                    (.media?.reddit_video?.fallback_url // empty),
                    (.preview?.reddit_video_preview?.fallback_url // empty)
                )
            ' 2>/dev/null \
            | grep -Ei '\.(jpg|jpeg|png|webp|gif|gifv|mp4|webm)(\?.*)?$' \
            | sed 's/\?.*$//' \
            || true)
        while IFS= read -r url; do
            (( imported >= target )) && break
            [[ -z "$url" ]] && continue
            local live=0
            is_live_url "$url" && live=1
            if (( live == 1 && imported_live >= target_live )); then
                continue
            fi
            if (( live == 0 && imported_static >= target_static )); then
                continue
            fi
            processed=$((processed + 1))
            spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
            if download_image "$url"; then
                imported=$((imported + 1))
                if (( live == 1 )); then
                    imported_live=$((imported_live + 1))
                else
                    imported_static=$((imported_static + 1))
                fi
            fi
        done <<< "$reddit_urls"
    done
    spinner_clear

    if (( ${#GITHUB_SOURCES[@]} > 0 )); then
        print_step "fetch github wallpaper repos"
        if (( imported >= target )); then
            print_info "github skipped (target already met)"
        else
            local source gh_urls
            for source in "${GITHUB_SOURCES[@]}"; do
                (( imported >= target )) && break
                spinner_tick "github: $source ($imported/$target)"
                gh_urls=$(github_urls_for_source "$source" \
                    | grep -Ei '\.(jpg|jpeg|png|webp|gif|mp4|webm)$' || true)
                while IFS= read -r url; do
                    (( imported >= target )) && break
                    [[ -z "$url" ]] && continue
                    local live=0
                    is_live_url "$url" && live=1
                    if (( live == 1 && imported_live >= target_live )); then
                        continue
                    fi
                    if (( live == 0 && imported_static >= target_static )); then
                        continue
                    fi
                    processed=$((processed + 1))
                    spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
                    if download_image "$url"; then
                        imported=$((imported + 1))
                        if (( live == 1 )); then
                            imported_live=$((imported_live + 1))
                        else
                            imported_static=$((imported_static + 1))
                        fi
                    fi
                done <<< "$gh_urls"
            done
        fi
        spinner_clear
    fi

    print_step "fill remaining slots"
    if (( imported < target )); then
        for q in "${KEYWORDS[@]}"; do
            (( imported >= target )) && break
            urls=$(curl -A "$USER_AGENT" -sS \
                "https://wallhaven.cc/api/v1/search?q=${q}&categories=111&purity=${WALLHAVEN_PURITY}&sorting=${WALLHAVEN_SORT}&atleast=${MIN_WIDTH}x${MIN_HEIGHT}" \
                | jq -r '.data[].path' | head -n "$wallhaven_batch")
            while IFS= read -r url; do
                (( imported >= target )) && break
                [[ -z "$url" ]] && continue
                processed=$((processed + 1))
                spinner_tick "fill: $imported/$target"
                if download_image "$url"; then
                    imported=$((imported + 1))
                    if is_live_url "$url"; then
                        imported_live=$((imported_live + 1))
                    else
                        imported_static=$((imported_static + 1))
                    fi
                fi
            done <<< "$urls"
        done
        spinner_clear
    else
        print_info "fill skipped (target already met)"
    fi

    print_step "report status and warnings"
    print_success "imported $imported/$target wallpaper(s) to inbox (live $imported_live, static $imported_static)"
    if (( imported_live < target_live )); then
        print_warn "live target not fully met (wanted $target_live, got $imported_live)"
    fi
    duplicate_report
    warn_if_over_limit
    log "fetch completed: imported=$imported"
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_triage (review)
# ─────────────────────────────────────────────────────────────────────────────

triage_action_tty() {
    local action
    printf "\naction: " >&2
    read -r -n1 action
    printf "\n" >&2
    printf '%s' "$action"
}

triage_undo() {
    if (( ${#UNDO_ACTIONS[@]} == 0 )); then
        print_warn "nothing to undo"
        sleep 1
        return 1
    fi

    local last_idx=$(( ${#UNDO_ACTIONS[@]} - 1 ))
    local action="${UNDO_ACTIONS[$last_idx]}"
    local src="${UNDO_SRC_PATHS[$last_idx]}"
    local dst="${UNDO_DST_PATHS[$last_idx]}"

    case "$action" in
        keep|archive|delete)
            if [[ -f "$dst" ]]; then
                mv "$dst" "$src"
                print_success "undo $action: $(basename "$src") restored"
            else
                print_warn "undo failed: destination file missing"
                sleep 1
                return 1
            fi
            ;;
    esac

    unset 'UNDO_ACTIONS[last_idx]'
    unset 'UNDO_SRC_PATHS[last_idx]'
    unset 'UNDO_DST_PATHS[last_idx]'
    sleep 1
    return 0
}

cmd_triage() {
    require_commands identify chafa
    load_config
    require_tty "review"
    local source_pool="$REVIEW_POOL"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pool)
                [[ $# -ge 2 ]] || die "--pool requires: new|current|old"
                case "$2" in
                    new|n) source_pool="new" ;;
                    current|c) source_pool="current" ;;
                    old|o) source_pool="old" ;;
                    *) die "Invalid review pool: $2" ;;
                esac
                shift 2
                ;;
            *)
                die "Unknown triage flag: $1"
                ;;
        esac
    done
    local source_dir
    source_dir=$(pool_dir "$source_pool") || die "Invalid review pool: $source_pool"

    # Reset undo stack
    UNDO_ACTIONS=()
    UNDO_SRC_PATHS=()
    UNDO_DST_PATHS=()

    clear
    print_groot_logo
    print_header "review ($source_pool)"

    shopt -s nullglob
    local files=("$source_dir"/*)
    shopt -u nullglob

    if (( ${#files[@]} == 0 )); then
        print_info "no files in $source_pool"
        return 0
    fi

    local kept=0 moved_old=0 deleted=0 skipped=0 idx=1 total=${#files[@]} quit_requested=0
    local file w h size action media_type
    while (( idx <= total )); do
        file="${files[$((idx - 1))]}"

        if [[ ! -f "$file" ]]; then
            idx=$((idx + 1))
            continue
        fi

        read -r w h <<< "$(get_media_dimensions "$file")"
        size=$(du -h "$file" | awk '{print $1}')
        if is_live_file "$file"; then
            media_type="live"
        else
            media_type="static"
        fi

        while :; do
            clear
            print_groot_logo
            printf "${BOLD}${MAGENTA}[${idx}/${total}]${RESET} %s\n" "$(basename "$file")"
            printf "%sx%s | %s | %s\n\n" "$w" "$h" "$size" "$media_type"

            # Primary keys
            printf "  ${DIM}<-/${RESET}${LIGHT_MAGENTA}h${RESET} back    "
            printf "${DIM}->${RESET}/${CYAN}l${RESET} next    "
            printf "${GREEN}Enter${RESET} keep    "
            printf "${MAGENTA}a${RESET} archive    "
            printf "${RED}d${RESET} delete    "
            printf "${YELLOW}q${RESET} quit\n"
            printf "  ${DIM}?=more keys${RESET}\n\n"

            if ! is_live_file "$file"; then
                chafa -f symbols -s 80x24 "$file" || true
            else
                printf "  ${DIM}[live wallpaper - press v to preview]${RESET}\n"
            fi

            action=$(triage_action_tty)

            case "$action" in
                # Enter key (empty read from -n1)
                "")
                    if [[ "$source_pool" != "current" ]]; then
                        mv "$file" "$WALLPAPER_DIR_CURRENT/"
                        UNDO_ACTIONS+=("keep")
                        UNDO_SRC_PATHS+=("$file")
                        UNDO_DST_PATHS+=("$WALLPAPER_DIR_CURRENT/$(basename "$file")")
                    fi
                    kept=$((kept + 1))
                    idx=$((idx + 1))
                    break
                    ;;
                k|K)
                    if [[ "$source_pool" != "current" ]]; then
                        mv "$file" "$WALLPAPER_DIR_CURRENT/"
                        UNDO_ACTIONS+=("keep")
                        UNDO_SRC_PATHS+=("$file")
                        UNDO_DST_PATHS+=("$WALLPAPER_DIR_CURRENT/$(basename "$file")")
                    fi
                    kept=$((kept + 1))
                    idx=$((idx + 1))
                    break
                    ;;
                a|A|j|J|o|O)
                    if [[ "$source_pool" != "old" ]]; then
                        mv "$file" "$WALLPAPER_DIR_OLD/"
                        UNDO_ACTIONS+=("archive")
                        UNDO_SRC_PATHS+=("$file")
                        UNDO_DST_PATHS+=("$WALLPAPER_DIR_OLD/$(basename "$file")")
                    fi
                    moved_old=$((moved_old + 1))
                    idx=$((idx + 1))
                    break
                    ;;
                d|D|x|X)
                    # Soft-delete: move to trash instead of rm
                    local trash_name="${source_pool}__$(basename "$file")"
                    mv "$file" "$TRASH_DIR/$trash_name"
                    UNDO_ACTIONS+=("delete")
                    UNDO_SRC_PATHS+=("$file")
                    UNDO_DST_PATHS+=("$TRASH_DIR/$trash_name")
                    deleted=$((deleted + 1))
                    idx=$((idx + 1))
                    break
                    ;;
                l|L|s|S)
                    skipped=$((skipped + 1))
                    idx=$((idx + 1))
                    break
                    ;;
                h|H|b|B|p|P)
                    if (( idx > 1 )); then
                        idx=$((idx - 1))
                        break
                    else
                        print_warn "already at first image"
                        sleep 1
                    fi
                    ;;
                v|V)
                    if is_live_file "$file"; then
                        if command -v mpv >/dev/null 2>&1; then
                            mpv --loop --no-audio --really-quiet "$file" 2>/dev/null || true
                        else
                            print_warn "mpv not installed for video preview"
                            sleep 1
                        fi
                    else
                        open_image_viewer "$file"
                    fi
                    ;;
                t|T)
                    if command -v nsxiv >/dev/null 2>&1; then
                        print_info "thumbnails: move, press m to mark, then q to return"
                        sleep 1
                        local new_idx
                        if new_idx=$(thumbnail_pick_index "$idx" "${files[@]}"); then
                            idx="$new_idx"
                            file="${files[$((idx - 1))]}"
                            read -r w h <<< "$(get_media_dimensions "$file")"
                            size=$(du -h "$file" | awk '{print $1}')
                        fi
                    else
                        print_warn "nsxiv not installed for thumbnail mode"
                        sleep 1
                    fi
                    ;;
                u|U)
                    triage_undo || true
                    ;;
                i|I)
                    local fhash
                    fhash=$(sha256sum "$file" | awk '{print $1}')
                    printf "\n${BOLD}file info${RESET}\n"
                    printf "  path: %s\n" "$file"
                    printf "  hash: %s\n" "$fhash"
                    printf "  dims: %sx%s\n" "$w" "$h"
                    printf "  size: %s\n" "$size"
                    printf "  type: %s\n" "$media_type"
                    printf "\nPress Enter..."
                    read -r _
                    ;;
                ?)
                    printf "\n${BOLD}extended keys${RESET}\n"
                    printf "  ${BLUE}v${RESET}  open in viewer        "
                    printf "${LIGHT_BLUE}t${RESET}  thumbnail grid (nsxiv)\n"
                    printf "  ${LIGHT_GREEN}u${RESET}  undo last action      "
                    printf "${CYAN}i${RESET}  file info (hash, source)\n"
                    printf "\nPress Enter..."
                    read -r _
                    ;;
                q|Q)
                    quit_requested=1
                    break
                    ;;
                *)
                    print_warn "unknown key (press ? for help)"
                    sleep 1
                    ;;
            esac
        done

        if (( quit_requested == 1 )); then
            break
        fi
    done

    clear
    print_groot_logo
    if (( quit_requested == 1 )); then
        print_header "review aborted"
    else
        print_header "review summary"
    fi
    print_success "kept: $kept"
    print_info "archived: $moved_old"
    print_info "deleted (in trash): $deleted"
    print_info "skipped: $skipped"
    duplicate_report
    warn_if_over_limit
    log "triage completed: kept=$kept old=$moved_old deleted=$deleted skipped=$skipped"
}

