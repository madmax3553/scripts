# Cache the chafa format after first detection
CHAFA_FMT=""
detect_chafa_format() {
    if [[ -n "$CHAFA_FMT" ]]; then
        printf '%s\n' "$CHAFA_FMT"
        return 0
    fi

    # Kitty graphics protocol: ghostty, kitty, WezTerm
    case "${TERM_PROGRAM:-}:${TERM:-}" in
        ghostty:*|kitty:*|WezTerm:*)
            CHAFA_FMT="kitty"
            ;;
        *:*kitty*|*:*ghostty*)
            CHAFA_FMT="kitty"
            ;;
    esac

    # Sixel support: foot, mlterm, xterm (if compiled with sixel)
    if [[ -z "$CHAFA_FMT" ]]; then
        case "${TERM_PROGRAM:-}:${TERM:-}" in
            *:foot*|mlterm:*|*:xterm*)
                CHAFA_FMT="sixels"
                ;;
        esac
    fi

    # Fallback to symbols
    : "${CHAFA_FMT:=symbols}"
    printf '%s\n' "$CHAFA_FMT"
}

# ─────────────────────────────────────────────────────────────────────────────
# Side-by-side column helpers (ANSI-aware)
# ─────────────────────────────────────────────────────────────────────────────

strip_ansi() {
    # Remove ANSI escape sequences for visible-length calculation
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/\x1b\[[?][0-9]*[a-zA-Z]//g'
}

visible_len() {
    # Return visible character count of a string (stripping ANSI codes)
    local stripped
    stripped=$(printf '%s' "$1" | strip_ansi)
    printf '%s\n' "${#stripped}"
}

pad_to_width() {
    # Print a line then pad with spaces to reach target visible width
    local line="$1" target="$2"
    local vlen
    vlen=$(visible_len "$line")
    printf '%s' "$line"
    local pad=$(( target - vlen ))
    if (( pad > 0 )); then
        printf '%*s' "$pad" ""
    fi
}

merge_columns() {
    # Merge two multi-line strings side-by-side
    # $1 = left text, $2 = right text, $3 = left column width, $4 = separator
    local left_text="$1" right_text="$2"
    local left_width="${3:-44}" sep="${4:-  }"

    local -a left_lines=() right_lines=()
    while IFS= read -r line; do
        left_lines+=("$line")
    done <<< "$left_text"
    while IFS= read -r line; do
        right_lines+=("$line")
    done <<< "$right_text"

    local max=${#left_lines[@]}
    if (( ${#right_lines[@]} > max )); then
        max=${#right_lines[@]}
    fi

    local i
    for (( i = 0; i < max; i++ )); do
        local l="${left_lines[$i]:-}"
        local r="${right_lines[$i]:-}"
        if [[ -n "$r" ]]; then
            pad_to_width "$l" "$left_width"
            printf '%s%s\n' "$sep" "$r"
        else
            printf '%s\n' "$l"
        fi
    done
}

