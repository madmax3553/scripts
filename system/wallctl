        print_section "Advanced"
        printf "  15) hash retention       %sd\n" "$HASH_RETENTION_DAYS"
        printf "  16) archive age          %sd\n" "$ARCHIVE_AGE_DAYS"
        printf "  17) archive batch        %s\n" "$ARCHIVE_BATCH"
        printf "  18) user agent           %s\n" "$USER_AGENT"

        printf "\n"
        printf "  e) edit config file    s) save    q) quit\n\n"
        printf "choice: "
        local choice value
        read -r choice
        case "$choice" in
            1)
                printf "min width: "
                read -r value
                if [[ "$value" =~ ^[0-9]+$ ]]; then
                    MIN_WIDTH="$value"
                    printf "min height: "
                    read -r value
                    [[ "$value" =~ ^[0-9]+$ ]] && MIN_HEIGHT="$value" || print_warn "invalid number"
                else
                    print_warn "invalid number"
                fi
                ;;
            2)
                printf "landscape only (yes/no): "
                read -r value
                case "$value" in
                    yes|y|1) LANDSCAPE_ONLY=1 ;;
                    no|n|0) LANDSCAPE_ONLY=0 ;;
                    *) print_warn "invalid input" ;;
                esac
                ;;
            3)
                printf "keywords (space-separated): "
                read -r value
                [[ -n "$value" ]] && read -ra KEYWORDS <<< "$value"
                ;;
            4)
                printf "reddit subs (space-separated): "
                read -r value
                [[ -n "$value" ]] && read -ra REDDIT_SUBS <<< "$value"
                ;;
            5)
                printf "github sources (repo:path[@ref], space-separated): "
                read -r value
                [[ -n "$value" ]] && read -ra GITHUB_SOURCES <<< "$value"
                ;;
            6)
                printf "fetch limit: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && FETCH_LIMIT="$value" || print_warn "invalid number"
                ;;
            7)
                printf "live ratio (0-100): "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 0 && value <= 100 )) && LIVE_RATIO="$value" || print_warn "invalid ratio"
                ;;
            8)
                printf "rotation pool (current/current+new/current+old/current+new+old): "
                read -r value
                case "$value" in
                    current|current+new|current+old|current+new+old) ROTATION_POOL="$value" ;;
                    *) print_warn "invalid pool" ;;
                esac
                ;;
            9)
                printf "review source (new/current/old): "
                read -r value
                case "$value" in
                    new|current|old) REVIEW_POOL="$value" ;;
                    *) print_warn "invalid pool" ;;
                esac
                ;;
            10)
                printf "current warn threshold: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && MAX_CURRENT_WARN="$value" || print_warn "invalid number"
                ;;
            11)
                printf "screensaver pool (current/current+new/current+old/current+new+old): "
                read -r value
                case "$value" in
                    current|current+new|current+old|current+new+old) SCREENSAVER_POOL="$value" ;;
                    *) print_warn "invalid pool" ;;
                esac
                ;;
            12)
                printf "screensaver delay seconds: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )) && SCREENSAVER_INTERVAL="$value" || print_warn "invalid seconds"
                ;;
            13)
                printf "screensaver mode (overlay/wallpaper): "
                read -r value
                case "$value" in
                    overlay|wallpaper) SCREENSAVER_MODE="$value" ;;
                    *) print_warn "invalid mode" ;;
                esac
                ;;
            14)
                printf "viewer command (empty=auto): "
                read -r value
                WALLCTL_VIEWER="$value"
                ;;
            15)
                printf "hash retention days: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )) && HASH_RETENTION_DAYS="$value" || print_warn "invalid days"
                ;;
            16)
                printf "archive age days: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )) && ARCHIVE_AGE_DAYS="$value" || print_warn "invalid days"
                ;;
            17)
                printf "archive batch size: "
                read -r value
                [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 )) && ARCHIVE_BATCH="$value" || print_warn "invalid number"
                ;;
            18)
                printf "user agent: "
                read -r value
                [[ -n "$value" ]] && USER_AGENT="$value"
                ;;
            e|E)
                ${EDITOR:-nano} "$CONFIG_FILE"
                load_config
                ;;
            s|S)
                write_config
                print_success "saved $CONFIG_FILE"
                sleep 1
                break
                ;;
            q|Q)
                break
                ;;
            *)
                print_warn "unknown option"
                sleep 1
                ;;
        esac
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_menu (pipeline dashboard)
# ─────────────────────────────────────────────────────────────────────────────

cmd_menu() {
    IN_MENU=1
    load_config
    require_tty "menu"

    local choice
    while :; do
        printf '\033[?25h'
        clear
        print_groot_logo
        print_header "wallctl"
        render_dashboard

        printf "  1) download           fetch new wallpapers\n"
        printf "  2) review             triage inbox (%s pending)\n" "$DASH_NEW_COUNT"
        printf "  3) archive            move aging wallpapers to old\n"
        printf "  4) dedupe             find/remove duplicates\n"
        printf "  5) screensaver        start | stop | toggle\n"
        printf "  6) apply              set a wallpaper now\n"
        printf "  7) config             edit settings\n"
        printf "  h) help   q) quit\n"
        printf "\n"
        suggest_action
        printf "choice: "
        read -r choice

        case "$choice" in
            1|download|fetch)
                cmd_fetch
                ;;
            2|review|triage)
                cmd_triage --pool "$REVIEW_POOL"
                ;;
            3|archive)
                cmd_archive
                ;;
            4|dedupe)
                cmd_dedupe
                ;;
            5|screensaver|ss)
                printf "  1) start  2) stop  3) toggle  4) status\n"
                printf "  choice: "
                local ss_choice
                read -r ss_choice
                case "$ss_choice" in
                    1|start) cmd_screensaver start ;;
                    2|stop) cmd_screensaver stop ;;
                    3|toggle) cmd_screensaver toggle ;;
                    4|status) cmd_screensaver status ;;
                    *) print_warn "invalid screensaver action" ; sleep 1 ;;
                esac
                ;;
            6|apply)
                printf "  1) random  2) pick from thumbnails  3) enter path\n"
                printf "  choice: "
                local apply_choice
                read -r apply_choice
                case "$apply_choice" in
                    1|random) cmd_apply random ;;
                    2|pick) cmd_apply --pick ;;
                    3|path)
                        printf "  path: "
                        local apply_path
                        read -r apply_path
                        cmd_apply "$apply_path"
                        ;;
                    *) print_warn "invalid apply action" ; sleep 1 ;;
                esac
                ;;
            7|config)
                cmd_config
                ;;
            h|H|help)
                clear
                print_groot_logo
                usage
                printf "\nPress Enter to return to menu..."
                read -r _
                ;;
            q|quit)
                break
                ;;
            *)
                print_warn "unknown option"
                sleep 1
                ;;
        esac
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# Usage / help
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
wallctl - wallpaper workflow manager

Usage:
  $SCRIPT_NAME [command] [options]

Commands:
  menu                          Interactive menu (default)
  fetch [--limit N]             Download into inbox (new pool)
  triage [--pool new|current|old]
                                Review wallpapers one at a time
  apply [file|random|--pick]    Set a wallpaper immediately
  archive [--apply] [--age-days N] [--batch N] [--max-current N]
                                Move aging wallpapers to old pool
  status                        Show pool counts and runtime state
  list [new|current|old|all]    List files by pool
  dedupe [--apply]              Find or remove exact duplicate files
  migrate [--dry-run] [--to-new|--to-current]
                                Move loose wallpapers into a pool
  trash [--list|--purge]        View or empty the soft-delete trash
  config                        Edit runtime configuration
  screensaver {start|stop|toggle|status}
                                Control pseudo-screensaver loop
  help                          Show this help

Review keys:
  Enter=keep  a=archive  d=delete  h=back  l=next  q=quit  ?=more

Config:
  $CONFIG_FILE

Pool meanings:
  new     = unreviewed inbox
  current = active rotation set
  old     = resting / archived set
EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-menu}"
    if [[ $# -gt 0 ]]; then
        shift
    fi

    if [[ "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        CLEAR_ON_EXIT=0
        NO_PAUSE=1
    fi

    if [[ "$cmd" == "menu" && ( ! -t 0 || ! -t 1 ) ]]; then
        usage
        exit 1
    fi

    case "$cmd" in
        menu) cmd_menu "$@" ;;
        fetch|download) cmd_fetch "$@" ;;
        triage|review) cmd_triage "$@" ;;
        apply) cmd_apply "$@" ;;
        archive) cmd_archive "$@" ;;
        status) cmd_status "$@" ;;
        list) cmd_list "$@" ;;
        dedupe) cmd_dedupe "$@" ;;
        migrate) cmd_migrate "$@" ;;
        trash) cmd_trash "$@" ;;
        config) cmd_config "$@" ;;
        screensaver) cmd_screensaver "$@" ;;
        screensaver-start) cmd_screensaver start ;;
        screensaver-stop) cmd_screensaver stop ;;
        help|-h|--help) usage ;;
        *) die "Unknown command: $cmd" ;;
    esac

    maybe_pause
}

main "$@"
