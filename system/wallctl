                local ss_choice=0
                printf "\n"
                if menu_select ss_choice \
                    "start" \
                    "stop" \
                    "toggle" \
                    "status"; then
                    case "$ss_choice" in
                        1) cmd_screensaver start ;;
                        2) cmd_screensaver stop ;;
                        3) cmd_screensaver toggle ;;
