cmd_migrate() {
    load_config
    local dry_run=0
    local target_pool="new"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=1
                shift
                ;;
            --to-new)
                target_pool="new"
                shift
                ;;
            --to-current)
                target_pool="current"
                shift
                ;;
            *)
                die "Unknown migrate flag: $1"
                ;;
        esac
    done

    local moved=0 removed_dupes=0 renamed=0
    local file target hash1 hash2 base name ext n
    local destination_dir="$WALLPAPER_DIR_NEW"
    [[ "$target_pool" == "current" ]] && destination_dir="$WALLPAPER_DIR_CURRENT"

    shopt -s nullglob
    for file in "$WALLPAPER_DIR_BASE"/*.{jpg,jpeg,png,webp,gif,mp4,webm}; do
        [[ -f "$file" ]] || continue
        base=$(basename "$file")
        target="$destination_dir/$base"

        if [[ -f "$target" ]]; then
            hash1=$(sha256sum "$file" | awk '{print $1}')
            hash2=$(sha256sum "$target" | awk '{print $1}')
            if [[ "$hash1" == "$hash2" ]]; then
                if (( dry_run == 0 )); then
                    rm -f "$file"
                fi
                removed_dupes=$((removed_dupes + 1))
                continue
            fi
            name="${base%.*}"
            ext="${base##*.}"
            n=1
            while [[ -e "$destination_dir/${name}-legacy-${n}.${ext}" ]]; do
                n=$((n + 1))
            done
            target="$destination_dir/${name}-legacy-${n}.${ext}"
            renamed=$((renamed + 1))
        fi

        if (( dry_run == 0 )); then
            mv "$file" "$target"
        fi
        moved=$((moved + 1))
    done
    shopt -u nullglob

    clear
    print_groot_logo
    print_header "migrate summary"
    if (( dry_run == 1 )); then
        print_info "dry-run only; no files moved"
    fi
    print_success "would move to $target_pool: $moved"
    print_info "duplicate loose files removed: $removed_dupes"
    print_info "renamed on collision: $renamed"
    print_info "tip: use --to-new for quick review queue"
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_archive
# ─────────────────────────────────────────────────────────────────────────────

cmd_archive() {
    load_config
    local age_days="$ARCHIVE_AGE_DAYS"
    local batch="$ARCHIVE_BATCH"
    local max_current="$MAX_CURRENT_WARN"
    local dry_run=1

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --age-days)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--age-days requires a number"
                age_days="$2"
                shift 2
                ;;
            --batch)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--batch requires a number"
                batch="$2"
                shift 2
                ;;
            --max-current)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--max-current requires a number"
                max_current="$2"
                shift 2
                ;;
            --apply)
                dry_run=0
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            *)
                die "Unknown archive flag: $1"
                ;;
        esac
    done

    clear
    print_groot_logo
    print_header "archive"

    local current_count moved=0
    current_count=$(count_media "$WALLPAPER_DIR_CURRENT")
    local cutoff_epoch
    cutoff_epoch=$(( $(date +%s) - (age_days * 86400) ))

    print_info "policy: age > ${age_days}d, batch ${batch}, max-current ${max_current}"
    print_info "current pool: $current_count wallpapers"

    # Collect candidates sorted by mtime (oldest first)
    local candidates=()
    while IFS= read -r -d '' file; do
        local mtime
        mtime=$(stat -c '%Y' "$file" 2>/dev/null || echo 0)
        if (( mtime < cutoff_epoch )) || (( current_count > max_current )); then
            candidates+=("$file")
        fi
    done < <(find "$WALLPAPER_DIR_CURRENT" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
                  -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \
                  -o -iname '*.mp4' -o -iname '*.webm' \) -printf '%T@\t%p\0' \
              | sort -z -t$'\t' -k1,1n | cut -z -f2-)

    if (( ${#candidates[@]} == 0 )); then
        print_success "nothing to archive"
        return 0
    fi

    local file
    for file in "${candidates[@]}"; do
        (( moved >= batch )) && break
        local bname
        bname=$(basename "$file")
        if (( dry_run == 1 )); then
            printf "  would move: %s\n" "$bname"
        else
            mv "$file" "$WALLPAPER_DIR_OLD/"
            printf "  moved: %s\n" "$bname"
        fi
        moved=$((moved + 1))
    done

    if (( dry_run == 1 )); then
        print_info "dry-run: would archive $moved file(s)"
        print_info "use: $SCRIPT_NAME archive --apply"
    else
        print_success "archived $moved file(s) to old"
        log "archive completed: moved=$moved"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_apply (quick-set wallpaper)
# ─────────────────────────────────────────────────────────────────────────────

kill_live_wallpaper() {
    # Kill any running mpvpaper instances
    if command -v mpvpaper >/dev/null 2>&1; then
        pkill -x mpvpaper 2>/dev/null || true
    fi
}

set_wallpaper() {
    local file="$1"
    if is_live_file "$file"; then
        # Live wallpaper via mpvpaper
        if ! command -v mpvpaper >/dev/null 2>&1; then
            die "mpvpaper required for live wallpapers (install: paru -S mpvpaper)"
        fi
        kill_live_wallpaper
        # Get focused monitor
        local monitor
        monitor=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name' 2>/dev/null || echo "eDP-1")
        mpvpaper -o "no-audio loop" "$monitor" "$file" &
        disown
        print_success "live wallpaper set: $(basename "$file") (mpvpaper on $monitor)"
    else
        # Static wallpaper via swww
        if ! command -v swww >/dev/null 2>&1; then
            die "swww required for static wallpapers"
        fi
        kill_live_wallpaper
        swww img "$file" --transition-type wipe --transition-duration 1 >/dev/null 2>&1 || true
        print_success "wallpaper set: $(basename "$file")"
    fi
}

cmd_apply() {
    load_config
    local mode="random"
    local target_file=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pick)
                mode="pick"
                shift
                ;;
            random)
                mode="random"
                shift
                ;;
            *)
                if [[ -f "$1" ]]; then
                    mode="file"
                    target_file="$1"
                else
                    die "File not found: $1"
                fi
                shift
                ;;
        esac
    done

    clear
    print_groot_logo
    print_header "apply wallpaper"

    case "$mode" in
        file)
            set_wallpaper "$target_file"
            ;;
        pick)
            if ! command -v nsxiv >/dev/null 2>&1; then
                die "nsxiv required for --pick mode"
            fi
            local picked
            shopt -s nullglob
            local pool_files=("$WALLPAPER_DIR_CURRENT"/*)
            shopt -u nullglob
            if (( ${#pool_files[@]} == 0 )); then
                die "no wallpapers in current pool"
            fi
            picked=$(nsxiv -t -o "${pool_files[@]}" 2>/dev/null | head -n1 || true)
            if [[ -z "$picked" ]]; then
                print_info "no wallpaper selected"
                return 0
            fi
            set_wallpaper "$picked"
            ;;
        random)
            local wallpaper
            if ! wallpaper=$(pick_random_wallpaper "$ROTATION_POOL"); then
                die "no wallpapers available in pool: $ROTATION_POOL"
            fi
            set_wallpaper "$wallpaper"
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_screensaver
# ─────────────────────────────────────────────────────────────────────────────

screensaver_loop_wallpaper() {
    local wallpaper
    while :; do
        if wallpaper=$(pick_random_wallpaper "$SCREENSAVER_POOL"); then
            set_wallpaper "$wallpaper"
        fi
        sleep "$SCREENSAVER_INTERVAL"
    done
}

build_screensaver_filelist() {
    local dir file
    : > "$SCREENSAVER_LIST_FILE"
    while IFS= read -r dir; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r -d '' file; do
            if is_selectable_wallpaper "$file"; then
                printf '%s\n' "$file" >> "$SCREENSAVER_LIST_FILE"
            fi
        done < <(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
                      -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \
                      -o -iname '*.mp4' -o -iname '*.webm' \) -print0)
    done < <(list_pool_dirs "$SCREENSAVER_POOL")
}

start_overlay_screensaver() {
    if ! command -v mpv >/dev/null 2>&1; then
        print_warn "mpv not found for overlay mode"
        return 1
    fi

    build_screensaver_filelist
    if [[ ! -s "$SCREENSAVER_LIST_FILE" ]]; then
        return 1
    fi

    local shuffled
    shuffled=$(shuf "$SCREENSAVER_LIST_FILE")
    if [[ -z "$shuffled" ]]; then
        return 1
    fi

    # mpv handles both images and video natively
    # --image-display-duration controls how long each image shows
    # videos play to completion then advance
    mpv --fullscreen --loop-playlist --no-audio --really-quiet \
        --image-display-duration="$SCREENSAVER_INTERVAL" \
        --playlist=<(printf '%s\n' "$shuffled") >/dev/null 2>&1 &
    printf '%s:mpv\n' "$!" > "$LOCK_FILE"
    return 0
}

cmd_screensaver() {
    load_config
    local action="${1:-}"
    case "$action" in
        start)
            if screensaver_is_running; then
                print_info "screensaver already running"
                return 0
            fi
            if [[ "$SCREENSAVER_MODE" == "overlay" ]]; then
                if start_overlay_screensaver; then
                    print_success "screensaver overlay started (mpv)"
                else
                    print_warn "overlay mode unavailable; falling back to wallpaper mode"
                    if ! command -v swww >/dev/null 2>&1; then
                        die "swww required for wallpaper screensaver mode"
                    fi
                    screensaver_loop_wallpaper &
                    printf '%s:swww\n' "$!" > "$LOCK_FILE"
                    print_success "screensaver wallpaper loop started"
                fi
            else
                if ! command -v swww >/dev/null 2>&1; then
                    die "swww required for wallpaper screensaver mode"
                fi
                screensaver_loop_wallpaper &
                printf '%s:swww\n' "$!" > "$LOCK_FILE"
                print_success "screensaver wallpaper loop started"
            fi
            ;;
        stop)
            if screensaver_is_running; then
                local pid lock_type
                pid=$(awk -F: '{print $1}' "$LOCK_FILE" 2>/dev/null || true)
                lock_type=$(awk -F: '{print $2}' "$LOCK_FILE" 2>/dev/null || true)
                kill "$pid" 2>/dev/null || true
                # Also clean up any spawned mpv/mpvpaper processes
                case "$lock_type" in
                    mpv)
                        # Kill the specific mpv overlay if it's still around
                        pkill -P "$pid" 2>/dev/null || true
                        ;;
                    swww)
                        # Wallpaper loop may have spawned mpvpaper for live files
                        kill_live_wallpaper
                        ;;
                esac
                rm -f "$LOCK_FILE"
                rm -f "$SCREENSAVER_LIST_FILE"
                print_success "screensaver stopped"
            else
                print_info "screensaver not running"
            fi
            ;;
        toggle)
            if screensaver_is_running; then
                cmd_screensaver stop
            else
                cmd_screensaver start
            fi
            ;;
        status)
            if screensaver_is_running; then
                local lock_type
                lock_type=$(screensaver_lock_type || echo "unknown")
                print_info "screensaver: on (pool=$SCREENSAVER_POOL mode=$SCREENSAVER_MODE engine=$lock_type delay=${SCREENSAVER_INTERVAL}s)"
            else
                print_info "screensaver: off (pool=$SCREENSAVER_POOL mode=$SCREENSAVER_MODE delay=${SCREENSAVER_INTERVAL}s)"
            fi
            ;;
        *)
            die "Usage: $SCRIPT_NAME screensaver {start|stop|toggle|status}"
            ;;
    esac
}

