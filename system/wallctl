cleanup() {
    local code=$?
    printf '\033[?25h' >&2
    if [[ $code -eq 0 && -t 1 && $CLEAR_ON_EXIT -eq 1 ]]; then
        clear
    fi
}

trap cleanup EXIT INT TERM

log() {
    mkdir -p "$CACHE_DIR"
    printf "[%s] %s\n" "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

print_step() {
    STEP=$((STEP + 1))
    printf "${BOLD}${MAGENTA}[%d/%d]${RESET} %s\n" "$STEP" "$TOTAL_STEPS" "$1"
}

SPINNER_STATE=0
spinner_tick() {
    [[ -t 1 ]] || return 0
    local msg="$1"
    local frames='|/-\\'
    local ch="${frames:SPINNER_STATE:1}"
    SPINNER_STATE=$(( (SPINNER_STATE + 1) % 4 ))
    printf "\r${CYAN}[%s]${RESET} %s" "$ch" "$msg"
}

spinner_clear() {
    [[ -t 1 ]] || return 0
    printf "\r\033[K\033[?25h"
}

