# Get real terminal column count via /dev/tty (immune to scroll regions,
# piped stdout, and command substitution).
_term_cols() {
    local _l _c
    if read -r _l _c < <(stty size </dev/tty 2>/dev/null); then
        printf '%s' "$_c"
    else
        printf '80'
    fi
}

_term_lines() {
    local _l _c
    if read -r _l _c < <(stty size </dev/tty 2>/dev/null); then
        printf '%s' "$_l"
    else
        printf '24'
    fi
}

_now_ms() {
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
        local _s _us
        _s=${EPOCHREALTIME%.*}
        _us=${EPOCHREALTIME#*.}
        _us=${_us:0:3}
        while (( ${#_us} < 3 )); do
            _us+="0"
        done
        printf '%d' "$((10#${_s} * 1000 + 10#${_us}))"
    else
        date +%s000
    fi
}

_sleep_ms() {
    local ms=${1:-0}
    (( ms > 0 )) || return 0
    local sec=$(( ms / 1000 ))
    local rem=$(( ms % 1000 ))
    sleep "${sec}.$(printf '%03d' "$rem")"
}

# ── Background cylon spinner ─────────────────────────────────────────────────
# The spinner runs as a background subprocess with its own render loop at
# ~15 fps.  The main process communicates via a tmpfile for the label and
# a FIFO for commands (start/stop/cancel/quit).
#
# API (unchanged for callers):
#   spinner_tick "msg"          — start/update the spinner label
#   spinner_cancelled && break  — check if user pressed q/Esc
#   spinner_clear               — stop animation, show idle track
#   spinner_idle                — draw idle track (no background process)

_spinner_render_bar() {
    # Build and render one frame of the cylon bar.
    # Reads/writes SPINNER_STATE and SPINNER_DIR from the subprocess env.
    local pos=$SPINNER_STATE
    local bar="" i dist
    for (( i = 0; i < SPINNER_BAR_W; i++ )); do
        dist=$(( pos - i ))
        (( dist < 0 )) && dist=$(( -dist )) || true
        case "$dist" in
            0) bar+="\033[1m\033[0;36m█\033[0m" ;;
            1) bar+="\033[0;36m▄\033[0m" ;;
            2) bar+="\033[2m\033[0;36m_\033[0m" ;;
            3) bar+="\033[2m.\033[0m" ;;
            *) bar+=" " ;;
        esac
    done

    # Advance position, bounce at edges
    if (( SPINNER_DIR == 1 )); then
        SPINNER_STATE=$(( pos + 1 ))
        if (( SPINNER_STATE >= SPINNER_BAR_W )); then
            SPINNER_STATE=$(( SPINNER_BAR_W - 2 ))
            SPINNER_DIR=-1
        fi
    else
        SPINNER_STATE=$(( pos - 1 ))
        if (( SPINNER_STATE < 0 )); then
            SPINNER_STATE=1
            SPINNER_DIR=1
        fi
    fi

    # Position and render
    local cols
    read -r _ cols < <(stty size </dev/tty 2>/dev/null) || cols=80
    local bar_col=$(( cols - SPINNER_BAR_W ))
    (( bar_col < 1 )) && bar_col=1 || true
    local widget_col=$(( cols - SPINNER_WIDTH ))
    (( widget_col < 1 )) && widget_col=1 || true

    # Read current label from shared file
    local msg=""
    [[ -f "$1" ]] && msg=$(<"$1") || true
    local label_w=$(( SPINNER_WIDTH - SPINNER_BAR_W - 2 ))
    (( label_w < 4 )) && label_w=4 || true
    (( ${#msg} > label_w )) && msg="${msg:0:$((label_w - 3))}..." || true
    local label
    printf -v label "%-${label_w}s" "$msg"

    printf '\033[?25l\0337' >/dev/tty 2>/dev/null || return 0
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$SPINNER_WIDTH" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '\033[2m%s\033[0m ' "$label" >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$bar_col" >/dev/tty 2>/dev/null
    printf '%b' "$bar" >/dev/tty 2>/dev/null
    printf '\0338' >/dev/tty 2>/dev/null
}

_spinner_render_cancelled() {
    local cols
    read -r _ cols < <(stty size </dev/tty 2>/dev/null) || cols=80
    local bar_col=$(( cols - SPINNER_BAR_W ))
    (( bar_col < 1 )) && bar_col=1 || true
    local widget_col=$(( cols - SPINNER_WIDTH ))
    (( widget_col < 1 )) && widget_col=1 || true
    local label_w=$(( SPINNER_WIDTH - SPINNER_BAR_W - 2 ))
    (( label_w < 4 )) && label_w=4 || true
    local cancel_label
    printf -v cancel_label "%-${label_w}s" "cancelled"
    # Build dim gradient block bar in yellow for cancelled state
    local dead_bar="" _i _edge
    for (( _i = 0; _i < SPINNER_BAR_W; _i++ )); do
        _edge=$_i
        (( (SPINNER_BAR_W - 1 - _i) < _edge )) && _edge=$(( SPINNER_BAR_W - 1 - _i )) || true
        case "$_edge" in
            0) dead_bar+="░" ;;
            1) dead_bar+="▒" ;;
            2) dead_bar+="▓" ;;
            *) dead_bar+="█" ;;
        esac
    done
    printf '\0337' >/dev/tty 2>/dev/null || return 0
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$SPINNER_WIDTH" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '\033[1;33m%s\033[0m ' "$cancel_label" >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$bar_col" >/dev/tty 2>/dev/null
    printf '\033[2;33m%s\033[0m' "$dead_bar" >/dev/tty 2>/dev/null
    printf '\0338' >/dev/tty 2>/dev/null
}

# The background loop.  Runs in a subshell, communicates via FIFO + tmpfile.
_spinner_loop() {
    local fifo="$1" msg_file="$2" cancel_file="$3"
    local running=0
    SPINNER_STATE=0
    SPINNER_DIR=1

    # Keep FIFO open read/write so read timeouts work without blocking on open.
    exec 9<>"$fifo" || return 0

    while true; do
        # Check FIFO for commands (non-blocking)
        local cmd=""
        if read -r -t 0.06 -u 9 cmd 2>/dev/null; then
            case "$cmd" in
                start)  running=1 ;;
                stop)   running=0; SPINNER_STATE=0; SPINNER_DIR=1 ;;
                cancel) printf '1' > "$cancel_file"; _spinner_render_cancelled; running=0 ;;
                quit)   break ;;
            esac
        fi

        # Check for cancel key (non-blocking) while running
        if (( running )); then
            local _key=""
            if read -rsn1 -t 0.005 _key </dev/tty 2>/dev/null; then
                case "$_key" in
                    q|Q|$'\x1b')
                        printf '1' > "$cancel_file"
                        _spinner_render_cancelled
                        running=0
                        ;;
                esac
            fi
        fi

        # Render frame
        if (( running )); then
            _spinner_render_bar "$msg_file"
        fi
    done

    exec 9>&-
    exec 9<&-
}

# Start the background spinner process
_spinner_ensure_bg() {
    [[ -n "$SPINNER_PID" ]] && kill -0 "$SPINNER_PID" 2>/dev/null && return 0

    SPINNER_FIFO=$(mktemp -u)
    mkfifo "$SPINNER_FIFO"
    SPINNER_MSG_FILE=$(mktemp)
    SPINNER_CANCEL_FILE=$(mktemp)
    printf '0' > "$SPINNER_CANCEL_FILE"

    _spinner_loop "$SPINNER_FIFO" "$SPINNER_MSG_FILE" "$SPINNER_CANCEL_FILE" &
    SPINNER_PID=$!
}

_spinner_send() {
    [[ -n "$SPINNER_PID" ]] || return 0
    kill -0 "$SPINNER_PID" 2>/dev/null || return 0
    [[ -n "$SPINNER_FIFO" && -p "$SPINNER_FIFO" ]] || return 0
    printf '%s\n' "$1" > "$SPINNER_FIFO" 2>/dev/null || true
}

_spinner_kill() {
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    [[ -n "$SPINNER_FIFO" ]] && rm -f "$SPINNER_FIFO" 2>/dev/null || true
    [[ -n "$SPINNER_MSG_FILE" ]] && rm -f "$SPINNER_MSG_FILE" 2>/dev/null || true
    [[ -n "${SPINNER_CANCEL_FILE:-}" ]] && rm -f "$SPINNER_CANCEL_FILE" 2>/dev/null || true
    SPINNER_FIFO=""
    SPINNER_MSG_FILE=""
    SPINNER_CANCEL_FILE=""
}

# ── Public API (same interface as before) ─────────────────────────────────────

spinner_tick() {
    [[ -e /dev/tty ]] || return 0
    local now
    now=$(_now_ms)
    if (( SPINNER_ACTIVE )) && (( now - SPINNER_LAST_DRAW_MS < SPINNER_MIN_FRAME_MS )); then
        return 0
    fi

    # Ensure cancel state file exists for spinner_cancelled checks.
    if [[ -z "${SPINNER_CANCEL_FILE:-}" || ! -f "$SPINNER_CANCEL_FILE" ]]; then
        SPINNER_CANCEL_FILE=$(mktemp)
        printf '0' > "$SPINNER_CANCEL_FILE"
    fi

    # Poll cancel keys during long loops.
    local _key=""
    if read -rsn1 -t 0.001 _key </dev/tty 2>/dev/null; then
        case "$_key" in
            q|Q|$'\x1b')
                printf '1' > "$SPINNER_CANCEL_FILE"
                _spinner_render_cancelled
                SPINNER_CANCELLED=1
                return 0
                ;;
        esac
    fi

    if (( ! SPINNER_ACTIVE )); then
        SPINNER_ACTIVE=1
        SPINNER_STARTED_MS=$now
        SPINNER_PULSES=0
        SPINNER_STATE=0
        SPINNER_DIR=1
        _spinner_render_idle
        SPINNER_LAST_DRAW_MS=$now
        return 0
    fi

    _spinner_render_cylon
    SPINNER_LAST_DRAW_MS=$now
}

_spinner_render_idle() {
    local cols
    cols=$(_term_cols)
    local bar_col=$(( cols - SPINNER_BAR_W ))
    (( bar_col < 1 )) && bar_col=1 || true
    local widget_col=$(( cols - SPINNER_WIDTH ))
    (( widget_col < 1 )) && widget_col=1 || true

    local lead_w=$(( SPINNER_WIDTH - SPINNER_BAR_W ))
    (( lead_w < 0 )) && lead_w=0 || true

    # Build a dim gradient block bar: ░▒▓██...██▓▒░
    local track="" i edge
    for (( i = 0; i < SPINNER_BAR_W; i++ )); do
        edge=$i
        (( (SPINNER_BAR_W - 1 - i) < edge )) && edge=$(( SPINNER_BAR_W - 1 - i )) || true
        case "$edge" in
            0) track+="░" ;;
            1) track+="▒" ;;
            2) track+="▓" ;;
            *) track+="█" ;;
        esac
    done

    printf '\0337' >/dev/tty 2>/dev/null || return 0
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$SPINNER_WIDTH" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$lead_w" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$bar_col" >/dev/tty 2>/dev/null
    printf '%b' "${DIM}\033[0;36m${track}${RESET}" >/dev/tty 2>/dev/null
    printf '\0338' >/dev/tty 2>/dev/null
}

_spinner_render_cylon() {
    local pos=$SPINNER_STATE
    local bar="" i dist edge base

    for (( i = 0; i < SPINNER_BAR_W; i++ )); do
        edge=$i
        (( (SPINNER_BAR_W - 1 - i) < edge )) && edge=$(( SPINNER_BAR_W - 1 - i )) || true
        case "$edge" in
            0) base="░" ;;
            1) base="▒" ;;
            2) base="▓" ;;
            *) base="█" ;;
        esac

        dist=$(( pos - i ))
        (( dist < 0 )) && dist=$(( -dist )) || true
        case "$dist" in
            0) bar+="\033[1m\033[0;36m█\033[0m" ;;
            1) bar+="\033[0;36m▓\033[0m" ;;
            2) bar+="\033[0;36m▒\033[0m" ;;
            3) bar+="\033[0;36m░\033[0m" ;;
            *) bar+="\033[2m\033[0;36m${base}\033[0m" ;;
        esac
    done

    if (( SPINNER_DIR == 1 )); then
        SPINNER_STATE=$(( pos + 1 ))
        if (( SPINNER_STATE >= SPINNER_BAR_W )); then
            SPINNER_STATE=$(( SPINNER_BAR_W - 2 ))
            SPINNER_DIR=-1
            SPINNER_PULSES=$((SPINNER_PULSES + 1))
        fi
    else
        SPINNER_STATE=$(( pos - 1 ))
        if (( SPINNER_STATE < 0 )); then
            SPINNER_STATE=1
            SPINNER_DIR=1
            SPINNER_PULSES=$((SPINNER_PULSES + 1))
        fi
    fi

    local cols
    cols=$(_term_cols)
    local bar_col=$(( cols - SPINNER_BAR_W ))
    (( bar_col < 1 )) && bar_col=1 || true
    local widget_col=$(( cols - SPINNER_WIDTH ))
    (( widget_col < 1 )) && widget_col=1 || true

    local lead_w=$(( SPINNER_WIDTH - SPINNER_BAR_W ))
    (( lead_w < 0 )) && lead_w=0 || true

    printf '\033[?25l\0337' >/dev/tty 2>/dev/null || return 0
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$SPINNER_WIDTH" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$widget_col" >/dev/tty 2>/dev/null
    printf '%*s' "$lead_w" '' >/dev/tty 2>/dev/null
    printf '\033[%d;%dH' "$SPINNER_ROW" "$bar_col" >/dev/tty 2>/dev/null
    printf '%b' "$bar" >/dev/tty 2>/dev/null
    printf '\0338' >/dev/tty 2>/dev/null
}

spinner_idle() {
    [[ -e /dev/tty ]] || return 0
    SPINNER_ACTIVE=0
    SPINNER_PULSES=0
    _spinner_render_idle
    SPINNER_LAST_DRAW_MS=$(_now_ms)
}

spinner_clear() {
    [[ -e /dev/tty ]] || return 0
    local mode="${1:-normal}"
    if (( SPINNER_ACTIVE )); then
        if [[ "$mode" != "fast" ]]; then
            local now elapsed wait_ms

            while (( SPINNER_PULSES < SPINNER_MIN_PULSES )); do
                _sleep_ms "$SPINNER_MIN_FRAME_MS"
                _spinner_render_cylon
            done

            now=$(_now_ms)
            elapsed=$(( now - SPINNER_STARTED_MS ))
            wait_ms=$(( SPINNER_MIN_ACTIVE_MS - elapsed ))
            _sleep_ms "$wait_ms"
        fi
        SPINNER_ACTIVE=0
    fi
    SPINNER_CANCELLED=0
    [[ -n "${SPINNER_CANCEL_FILE:-}" && -f "$SPINNER_CANCEL_FILE" ]] && printf '0' > "$SPINNER_CANCEL_FILE" || true
    printf '\033[?25h' >/dev/tty 2>/dev/null
    spinner_idle
}

spinner_cancelled() {
    [[ -f "${SPINNER_CANCEL_FILE:-}" ]] || return 1
    local val
    val=$(<"$SPINNER_CANCEL_FILE") || true
    if [[ "$val" == "1" ]]; then
        SPINNER_CANCELLED=1
        return 0
    fi
    return 1
}

# ── Scroll region pinning ────────────────────────────────────────────────────
# After drawing the logo + header, call pin_header to freeze those rows.
# Content printed after this scrolls only within the area below.
# Call unpin_header (or clear) before a full redraw.

HEADER_PINNED=0

pin_header() {
    [[ -t 1 ]] || return 0
    local rows
    rows=$(_term_lines)
    local pin_rows=${1:-$((SPINNER_ROW))}    # freeze rows 1..pin_rows
    # Set scroll region to pin_rows+1 .. bottom
    printf '\033[%d;%dr' "$((pin_rows + 1))" "$rows" >/dev/tty 2>/dev/null || return 0
    # Move cursor to first scrollable row
    printf '\033[%d;1H' "$((pin_rows + 1))" >/dev/tty 2>/dev/null
    HEADER_PINNED=1
}

unpin_header() {
    [[ -t 1 ]] || return 0
    (( HEADER_PINNED )) || return 0
    local rows
    rows=$(_term_lines)
    # Reset scroll region to full terminal
    printf '\033[1;%dr' "$rows" >/dev/tty 2>/dev/null || return 0
    HEADER_PINNED=0
}

# ── Combined screen redraw ───────────────────────────────────────────────────
# Replaces the common  clear && print_groot_logo && print_header "..."
# pattern.  Unpins scroll region, clears, draws logo + header, then
# re-pins so content scrolls underneath.

draw_screen() {
    local title="${1:-}"
    unpin_header
    # Clear kitty graphics protocol images before clearing screen
    kitten icat --clear >/dev/tty 2>/dev/null || true
    clear
    print_groot_logo
    [[ -n "$title" ]] && print_header "$title" || true
    pin_header
    spinner_idle
}

