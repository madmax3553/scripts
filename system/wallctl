screensaver_is_running() {
    if [[ ! -f "$LOCK_FILE" ]]; then
        return 1
    fi
    local pid
    pid=$(awk -F: '{print $1}' "$LOCK_FILE" 2>/dev/null || true)
    if [[ -z "$pid" ]]; then
        rm -f "$LOCK_FILE"
        return 1
    fi
    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    # Stale PID -- clean up
    rm -f "$LOCK_FILE"
    return 1
