screensaver_is_running() {
    if [[ ! -f "$LOCK_FILE" ]]; then
        return 1
    fi
    local pid
    pid=$(awk -F: '{print $1}' "$LOCK_FILE" 2>/dev/null || true)
    if [[ -z "$pid" ]]; then
        rm -f "$LOCK_FILE"
        return 1
    fi
    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    # Stale PID -- clean up
    rm -f "$LOCK_FILE"
    return 1
}

screensaver_lock_type() {
    [[ -f "$LOCK_FILE" ]] || return 1
    awk -F: '{print $2}' "$LOCK_FILE" 2>/dev/null || printf 'unknown\n'
}

resolve_viewer() {
    if [[ -n "$WALLCTL_VIEWER" ]] && command -v "$WALLCTL_VIEWER" >/dev/null 2>&1; then
        printf '%s\n' "$WALLCTL_VIEWER"
        return 0
    fi
    local candidate
    for candidate in nomacs nsxiv imv sxiv feh pqiv xdg-open; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

thumbnail_pick_index() {
    local current_idx="$1"
    shift
    local picked
    picked=$(nsxiv -t -n "$current_idx" -o "$@" 2>/dev/null | head -n1 || true)
    [[ -n "$picked" ]] || return 1

    local i=1 f
    for f in "$@"; do
        if [[ "$f" == "$picked" ]]; then
            printf '%s\n' "$i"
            return 0
        fi
        i=$((i + 1))
    done
    return 1
}

open_image_viewer() {
    local file="$1"
    local viewer
    viewer=$(resolve_viewer) || {
        print_warn "no viewer found (install nsxiv/imv or set WALLCTL_VIEWER)"
        sleep 1
        return 1
    }

    spinner_clear
    printf '\033[?25h'
    case "$viewer" in
        xdg-open)
            xdg-open "$file" >/dev/null 2>&1 &
            print_info "opened in default app: $(basename "$file")"
            sleep 1
            ;;
        *)
            "$viewer" "$file"
            ;;
    esac
    return 0
}

