# ─────────────────────────────────────────────────────────────────────────────
# cmd_dedupe
# ─────────────────────────────────────────────────────────────────────────────

cmd_dedupe() {
    load_config
    local apply=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply)
                apply=1
                shift
                ;;
            *)
                die "Unknown dedupe flag: $1"
                ;;
        esac
    done

    local report
    report=$(python3 - "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_OLD" <<'PY'
import hashlib
import sys
from pathlib import Path

pool_order = {"current": 0, "old": 1, "new": 2, "other": 9}
paths = [Path(p) for p in sys.argv[1:]]
rows = []
for p in paths:
    pool = p.name
    if not p.exists():
        continue
    for f in p.iterdir():
        if f.is_file():
            h = hashlib.sha256(f.read_bytes()).hexdigest()
            rows.append((h, pool, str(f)))

groups = {}
for h, pool, full in rows:
    groups.setdefault(h, []).append((pool, full))

dup_groups = [g for g in groups.values() if len(g) > 1]
dup_groups.sort(key=lambda g: (pool_order.get(g[0][0], 9), g[0][1]))

print(f"GROUPS\t{len(dup_groups)}")
for i, g in enumerate(dup_groups, 1):
    g.sort(key=lambda t: (pool_order.get(t[0], 9), len(t[1]), t[1]))
    keep = g[0]
    print(f"GROUP\t{i}\t{len(g)}")
    print(f"KEEP\t{keep[0]}\t{keep[1]}")
    for item in g[1:]:
        print(f"DROP\t{item[0]}\t{item[1]}")
PY
)

    clear
    print_groot_logo
    print_header "dedupe"

    local groups=0 dropped=0
    local line kind a b
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        IFS=$'\t' read -r kind a b <<< "$line"
        case "$kind" in
            GROUPS)
                groups="$a"
                print_info "duplicate groups: $groups"
                ;;
            GROUP)
                print_info "group $a (files: $b)"
                ;;
            KEEP)
                printf "  keep: [%s] %s\n" "$a" "$b"
                ;;
            DROP)
                if (( apply == 1 )); then
                    if rm -f "$b"; then
                        printf "  drop: [%s] %s\n" "$a" "$b"
                        dropped=$((dropped + 1))
                    else
                        print_warn "failed to remove: $b"
                    fi
                else
                    printf "  drop: [%s] %s\n" "$a" "$b"
                fi
                ;;
        esac
    done <<< "$report"

    if (( groups == 0 )); then
        print_success "no duplicates found"
    elif (( apply == 1 )); then
        print_success "removed duplicate files: $dropped"
    else
        print_info "dry-run only; use: $SCRIPT_NAME dedupe --apply"
    fi
}

