# ─────────────────────────────────────────────────────────────────────────────
# cmd_dedupe
# ─────────────────────────────────────────────────────────────────────────────

cmd_dedupe() {
    load_config
    local apply=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply)
                apply=1
                shift
                ;;
            *)
                die "Unknown dedupe flag: $1"
                ;;
        esac
    done

    spinner_tick "scanning for duplicates"
    local report
    report=$(python3 - "$WALLPAPER_DIR_NEW" "$WALLPAPER_DIR_CURRENT" "$WALLPAPER_DIR_OLD" <<'PY'
import hashlib
import sys
from pathlib import Path

pool_order = {"current": 0, "old": 1, "new": 2, "other": 9}
paths = [Path(p) for p in sys.argv[1:]]
rows = []
for p in paths:
    pool = p.name
    if not p.exists():
        continue
    for f in p.iterdir():
        if f.is_file():
            h = hashlib.sha256(f.read_bytes()).hexdigest()
            rows.append((h, pool, str(f)))

groups = {}
for h, pool, full in rows:
    groups.setdefault(h, []).append((pool, full))

dup_groups = [g for g in groups.values() if len(g) > 1]
dup_groups.sort(key=lambda g: (pool_order.get(g[0][0], 9), g[0][1]))

print(f"GROUPS\t{len(dup_groups)}")
for i, g in enumerate(dup_groups, 1):
    g.sort(key=lambda t: (pool_order.get(t[0], 9), len(t[1]), t[1]))
    keep = g[0]
    print(f"GROUP\t{i}\t{len(g)}")
    print(f"KEEP\t{keep[0]}\t{keep[1]}")
    for item in g[1:]:
        print(f"DROP\t{item[0]}\t{item[1]}")
PY
)
    spinner_clear

    draw_screen "dedupe"

    local groups=0 dropped=0
    local line kind a b
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        IFS=$'\t' read -r kind a b <<< "$line"
        case "$kind" in
            GROUPS)
                groups="$a"
                print_info "duplicate groups: $groups"
                ;;
            GROUP)
                print_info "group $a (files: $b)"
                ;;
            KEEP)
                printf "  keep: [%s] %s\n" "$a" "$b"
                ;;
            DROP)
                if (( apply == 1 )); then
                    if rm -f "$b"; then
                        printf "  drop: [%s] %s\n" "$a" "$b"
                        dropped=$((dropped + 1))
                    else
                        print_warn "failed to remove: $b"
                    fi
                else
                    printf "  drop: [%s] %s\n" "$a" "$b"
                fi
                ;;
        esac
    done <<< "$report"

    if (( groups == 0 )); then
        print_success "no duplicates found"
    elif (( apply == 1 )); then
        print_success "removed duplicate files: $dropped"
    else
        print_info "dry-run only; use: $SCRIPT_NAME dedupe --apply"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_migrate
# ─────────────────────────────────────────────────────────────────────────────

cmd_migrate() {
    load_config
    local dry_run=0
    local target_pool="new"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=1
                shift
                ;;
            --to-new)
                target_pool="new"
                shift
                ;;
            --to-current)
                target_pool="current"
                shift
                ;;
            *)
                die "Unknown migrate flag: $1"
                ;;
        esac
    done

    local moved=0 removed_dupes=0 renamed=0
    local file target hash1 hash2 base name ext n
    local destination_dir="$WALLPAPER_DIR_NEW"
    [[ "$target_pool" == "current" ]] && destination_dir="$WALLPAPER_DIR_CURRENT" || true

    shopt -s nullglob
    local -a migrate_files=("$WALLPAPER_DIR_BASE"/*.{jpg,jpeg,png,webp,gif,mp4,webm})
    shopt -u nullglob
    local migrate_total=${#migrate_files[@]}
    local migrate_idx=0

    for file in "${migrate_files[@]}"; do
        [[ -f "$file" ]] || continue
        spinner_cancelled && break
        migrate_idx=$((migrate_idx + 1))
        base=$(basename "$file")
        spinner_tick "migrate $migrate_idx/$migrate_total: $base"
        target="$destination_dir/$base"

        if [[ -f "$target" ]]; then
            hash1=$(sha256sum "$file" | awk '{print $1}')
            hash2=$(sha256sum "$target" | awk '{print $1}')
            if [[ "$hash1" == "$hash2" ]]; then
                if (( dry_run == 0 )); then
                    rm -f "$file"
                fi
                removed_dupes=$((removed_dupes + 1))
                continue
            fi
            name="${base%.*}"
            ext="${base##*.}"
            n=1
            while [[ -e "$destination_dir/${name}-legacy-${n}.${ext}" ]]; do
                n=$((n + 1))
            done
            target="$destination_dir/${name}-legacy-${n}.${ext}"
            renamed=$((renamed + 1))
        fi

        if (( dry_run == 0 )); then
            mv "$file" "$target"
        fi
        moved=$((moved + 1))
    done
    spinner_clear

    draw_screen "migrate summary"
    if (( dry_run == 1 )); then
        print_info "dry-run only; no files moved"
    fi
    print_success "would move to $target_pool: $moved"
    print_info "duplicate loose files removed: $removed_dupes"
    print_info "renamed on collision: $renamed"
    print_info "tip: use --to-new for quick review queue"
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_archive
# ─────────────────────────────────────────────────────────────────────────────

cmd_archive() {
    load_config
    local age_days="$ARCHIVE_AGE_DAYS"
    local batch="$ARCHIVE_BATCH"
    local max_current="$MAX_CURRENT_WARN"
    local dry_run=1

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --age-days)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--age-days requires a number"
                age_days="$2"
                shift 2
                ;;
            --batch)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--batch requires a number"
                batch="$2"
                shift 2
                ;;
            --max-current)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--max-current requires a number"
                max_current="$2"
                shift 2
                ;;
            --apply)
                dry_run=0
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            *)
                die "Unknown archive flag: $1"
                ;;
        esac
    done

    draw_screen "archive"

    local current_count moved=0
    current_count=$(count_media "$WALLPAPER_DIR_CURRENT")
    local cutoff_epoch
    cutoff_epoch=$(( $(date +%s) - (age_days * 86400) ))

    print_info "policy: age > ${age_days}d, batch ${batch}, max-current ${max_current}"
    print_info "current pool: $current_count wallpapers"

    # Collect candidates sorted by mtime (oldest first)
    local candidates=()
    local scan_idx=0
    spinner_tick "scanning candidates"
    while IFS= read -r -d '' file; do
        spinner_cancelled && break
        scan_idx=$((scan_idx + 1))
        local mtime
        mtime=$(stat -c '%Y' "$file" 2>/dev/null || echo 0)
        spinner_tick "scanning $scan_idx: $(basename "$file")"
        if (( mtime < cutoff_epoch )) || (( current_count > max_current )); then
            candidates+=("$file")
        fi
    done < <(find "$WALLPAPER_DIR_CURRENT" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
                  -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \
                  -o -iname '*.mp4' -o -iname '*.webm' \) -printf '%T@\t%p\0' \
              | sort -z -t$'\t' -k1,1n | cut -z -f2-)
    spinner_clear

    if (( ${#candidates[@]} == 0 )); then
        print_success "nothing to archive"
        return 0
    fi

    local file
    local archive_total=${#candidates[@]}
    (( archive_total > batch )) && archive_total=$batch || true
    for file in "${candidates[@]}"; do
        (( moved >= batch )) && break || true
        spinner_cancelled && break
        local bname
        bname=$(basename "$file")
        spinner_tick "archiving $((moved + 1))/$archive_total: $bname"
        if (( dry_run == 1 )); then
            printf "  would move: %s\n" "$bname"
        else
            mv "$file" "$WALLPAPER_DIR_OLD/"
            printf "  moved: %s\n" "$bname"
        fi
        moved=$((moved + 1))
    done
    spinner_clear

    if (( dry_run == 1 )); then
        print_info "dry-run: would archive $moved file(s)"
        print_info "use: $SCRIPT_NAME archive --apply"
    else
        print_success "archived $moved file(s) to old"
        log "archive completed: moved=$moved"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_apply (quick-set wallpaper)
# ─────────────────────────────────────────────────────────────────────────────

kill_live_wallpaper() {
    # Kill any running mpvpaper instances
    if command -v mpvpaper >/dev/null 2>&1; then
        pkill -x mpvpaper 2>/dev/null || true
    fi
}

set_wallpaper() {
    local file="$1"
    if is_live_file "$file"; then
        # Live wallpaper via mpvpaper
        if ! command -v mpvpaper >/dev/null 2>&1; then
            die "mpvpaper required for live wallpapers (install: paru -S mpvpaper)"
        fi
        kill_live_wallpaper
        # Get focused monitor
        local monitor
        monitor=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name' 2>/dev/null || echo "eDP-1")
        mpvpaper -o "no-audio loop" "$monitor" "$file" &
        disown
        print_success "live wallpaper set: $(basename "$file") (mpvpaper on $monitor)"
    else
        # Static wallpaper via swww
        if ! command -v swww >/dev/null 2>&1; then
            die "swww required for static wallpapers"
        fi
        kill_live_wallpaper
        swww img "$file" --transition-type wipe --transition-duration 1 >/dev/null 2>&1 || true
        print_success "wallpaper set: $(basename "$file")"
    fi
}

get_current_wallpaper() {
    # Try swww query first (most reliable when daemon is running)
    if command -v swww >/dev/null 2>&1; then
        local swww_out
        swww_out=$(swww query 2>/dev/null || true)
        if [[ -n "$swww_out" ]]; then
            local path
            path=$(printf '%s\n' "$swww_out" | head -n1 | sed 's/.*image: //')
            if [[ -n "$path" && -f "$path" ]]; then
                printf '%s\n' "$path"
                return 0
            fi
        fi
    fi

    # Fallback: check swww cache files directly
    local swww_cache="${XDG_CACHE_HOME:-$HOME/.cache}/swww"
    if [[ -d "$swww_cache" ]]; then
        local monitor_file path
        for monitor_file in "$swww_cache"/*; do
            [[ -f "$monitor_file" ]] || continue
            path=$(awk '{print $2}' "$monitor_file" 2>/dev/null || true)
            if [[ -n "$path" && -f "$path" ]]; then
                printf '%s\n' "$path"
                return 0
            fi
        done
    fi

    # Fallback: check for running mpvpaper
    if command -v mpvpaper >/dev/null 2>&1; then
        local mpv_path
        mpv_path=$(ps -eo args= 2>/dev/null | grep -m1 '[m]pvpaper' | awk '{print $NF}' || true)
        if [[ -n "$mpv_path" && -f "$mpv_path" ]]; then
            printf '%s\n' "$mpv_path"
            return 0
        fi
    fi

    return 1
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_remove (soft-delete current wallpaper)
# ─────────────────────────────────────────────────────────────────────────────

cmd_remove() {
    load_config
    local force=0
    local no_replace=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)
                force=1
                shift
                ;;
            --no-replace)
                no_replace=1
                shift
                ;;
            *)
                die "Unknown remove flag: $1\nUsage: $SCRIPT_NAME remove [-y|--yes] [--no-replace]"
                ;;
        esac
    done

    draw_screen "remove current wallpaper"

    local current_wp
    if ! current_wp=$(get_current_wallpaper); then
        die "could not detect current wallpaper (is swww or mpvpaper running?)"
    fi

    local bname
    bname=$(basename "$current_wp")

    # Determine which pool the wallpaper belongs to
    local pool="unknown"
    local wp_dir
    wp_dir=$(dirname "$current_wp")
    case "$wp_dir" in
        "$WALLPAPER_DIR_CURRENT") pool="current" ;;
        "$WALLPAPER_DIR_NEW")     pool="new" ;;
        "$WALLPAPER_DIR_OLD")     pool="old" ;;
    esac

    # Show wallpaper info
    printf "\n"
    print_info "file: $bname"
    print_info "path: $current_wp"
    print_info "pool: $pool"
    local size
    size=$(du -h "$current_wp" | awk '{print $1}')
    print_info "size: $size"

    # Show a preview if it's a static wallpaper and chafa is available
    if ! is_live_file "$current_wp" && command -v chafa >/dev/null 2>&1; then
        printf "\n"
        spinner_tick "rendering preview"
        chafa -f "$(detect_chafa_format)" -s 60x18 "$current_wp" || true
        spinner_clear
        printf "\n"
    fi

    # Confirm unless --yes
    if (( force == 0 )); then
        if [[ -t 0 && -t 1 ]]; then
            printf "\n${BOLD}${RED}soft-delete this wallpaper?${RESET} [y/N] "
            local confirm
            read -r confirm
            case "$confirm" in
                y|Y|yes|YES) ;;
                *) print_info "cancelled"; return 0 ;;
            esac
        else
            die "confirmation required (use -y to skip in non-interactive mode)"
        fi
    fi

    # Soft-delete: move to trash
    local trash_name="${pool}__${bname}"
    mkdir -p "$TRASH_DIR"
    mv "$current_wp" "$TRASH_DIR/$trash_name"
    print_success "trashed: $bname"
    log "remove: trashed $current_wp -> $TRASH_DIR/$trash_name"

    # Set a new random wallpaper unless --no-replace
    if (( no_replace == 0 )); then
        local new_wp
        if new_wp=$(pick_random_wallpaper "$ROTATION_POOL"); then
            set_wallpaper "$new_wp"
        else
            print_warn "no replacement wallpaper available in pool: $ROTATION_POOL"
        fi
    else
        print_info "skipped replacement (--no-replace)"
    fi

    print_info "restore with: $SCRIPT_NAME trash (file is in soft-delete trash)"
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_browse (inline thumbnail grid browser)
# ─────────────────────────────────────────────────────────────────────────────

BROWSE_COLS=3
BROWSE_ROWS=3
BROWSE_THUMB_W=30
BROWSE_THUMB_H=10
declare -A BROWSE_THUMB_CACHE_PATH=()
declare -A BROWSE_THUMB_CACHE_MTIME=()

browse_calc_layout() {
    # Dynamically size thumbnails to fill the terminal.
    local term_cols term_lines
    term_cols=$(_term_cols)
    term_lines=$(_term_lines)

    # Pick column count by terminal width
    if (( term_cols >= 240 )); then
        BROWSE_COLS=4
    elif (( term_cols >= 160 )); then
        BROWSE_COLS=3
    else
        BROWSE_COLS=2
    fi

    # Thumbnail width: fill columns evenly (leave 2-char gap between columns)
    local gap=2
    BROWSE_THUMB_W=$(( (term_cols - gap * (BROWSE_COLS - 1)) / BROWSE_COLS ))
    (( BROWSE_THUMB_W < 20 )) && BROWSE_THUMB_W=20 || true
    (( BROWSE_THUMB_W > 120 )) && BROWSE_THUMB_W=120 || true

    # Available height for grid content.  The pinned header (logo + header
    # + spinner) occupies the top SPINNER_ROW rows.  Below that we have a
    # status line (~2 lines) and footer keybinds (~2 lines).
    local overhead=$(( SPINNER_ROW + 4 ))
    local available=$(( term_lines - overhead ))
    (( available < 10 )) && available=10 || true

    # Pick row count: prefer 3, drop to 2 or 1 if thumbs would be too short.
    # Each row costs thumb_h + 2 (filename label + gap line).
    BROWSE_ROWS=3
    BROWSE_THUMB_H=$(( (available - BROWSE_ROWS * 2) / BROWSE_ROWS ))

    if (( BROWSE_THUMB_H < 8 )); then
        BROWSE_ROWS=2
        BROWSE_THUMB_H=$(( (available - BROWSE_ROWS * 2) / BROWSE_ROWS ))
    fi

    if (( BROWSE_THUMB_H < 8 )); then
        BROWSE_ROWS=1
        BROWSE_THUMB_H=$(( available - 2 ))
    fi

    (( BROWSE_THUMB_H < 8 )) && BROWSE_THUMB_H=8 || true
    (( BROWSE_THUMB_H > 40 )) && BROWSE_THUMB_H=40 || true
}

browse_render_page() {
    # Args: page per_page total total_pages marked_str cursor_local files...
    # cursor_local = page-local index of cursor (-1 = no cursor)
    local page="$1" per_page="$2" total="$3" total_pages="$4" marked_str="$5" cursor_local="$6"
    shift 6
    local -a files=("$@")

    local start=$(( (page - 1) * per_page ))
    local end=$(( start + per_page ))
    (( end > total )) && end=$total || true

    # Collect files for this page
    local -a page_files=()
    local i
    for (( i = start; i < end; i++ )); do
        page_files+=("${files[$i]}")
    done

    if (( ${#page_files[@]} == 0 )); then
        print_info "no images on this page"
        return
    fi

    # Grid geometry used for both label-first paint and image placement.
    local grid_top=$(( SPINNER_ROW + 3 ))   # 0-based row where first thumb goes
    local gap=2
    local cell_w=$(( BROWSE_THUMB_W + gap ))
    local cell_h=$(( BROWSE_THUMB_H + 2 ))  # thumb + label + gap

    # Resolve thumbnails (video -> cached frame, images pass through).
    # Run thumbnail extraction in small parallel batches for responsiveness.
    local -a thumb_paths=()
    local -a thumb_names=()
    local -a thumb_marks=()
    local -a page_mtimes=()
    local page_count=${#page_files[@]}
    local thumb_jobs=4
    if command -v nproc >/dev/null 2>&1; then
        thumb_jobs=$(nproc 2>/dev/null || echo 4)
        (( thumb_jobs < 2 )) && thumb_jobs=2 || true
        (( thumb_jobs > 8 )) && thumb_jobs=8 || true
    fi
    (( thumb_jobs > page_count )) && thumb_jobs=$page_count || true
    (( thumb_jobs < 1 )) && thumb_jobs=1 || true

    # Paint labels first so UI appears immediately, then fill images.
    for (( i = 0; i < page_count; i++ )); do
        local f="${page_files[$i]}"
        local bname
        bname=$(basename "$f")
        local global_idx=$(( start + i ))
        local mark=""
        if [[ "|${marked_str}|" == *"|${global_idx}|"* ]]; then
            mark="*"
        fi
        thumb_paths+=("")
        thumb_names+=("$bname")
        thumb_marks+=("$mark")

        local col_idx=$(( i % BROWSE_COLS ))
        local row_idx=$(( i / BROWSE_COLS ))
        local x=$(( col_idx * cell_w ))
        local y=$(( grid_top + row_idx * cell_h ))
        local label_y=$(( y + BROWSE_THUMB_H ))
        local is_cursor=0
        (( i == cursor_local )) && is_cursor=1 || true

        local prefix=""
        if (( is_cursor )); then
            prefix="▸ "
        else
            prefix="  "
        fi
        if [[ -n "$mark" ]]; then
            prefix+="✓ "
        fi
        local label="${prefix}$((i + 1))) ${bname}"
        (( ${#label} > BROWSE_THUMB_W )) && label="${label:0:$((BROWSE_THUMB_W - 3))}..." || true

        printf '\033[%d;%dH' "$((label_y + 1))" "$((x + 1))" >/dev/tty 2>/dev/null
        if (( is_cursor )) && [[ -n "$mark" ]]; then
            printf '%b' "\033[7m${BOLD}${CYAN}${label}${RESET}" >/dev/tty 2>/dev/null
        elif (( is_cursor )); then
            printf '%b' "\033[7m${BOLD}${label}${RESET}" >/dev/tty 2>/dev/null
        elif [[ -n "$mark" ]]; then
            printf '%b' "${BOLD}${CYAN}${label}${RESET}" >/dev/tty 2>/dev/null
        else
            printf '%b' "${DIM}${label}${RESET}" >/dev/tty 2>/dev/null
        fi
    done

    local thumb_tmp
    thumb_tmp=$(mktemp -d)
    local -a _thumb_pids=()
    local _running=0
    local _done=0
    local _cancelled=0

    spinner_tick "loading thumbnails"
    for (( i = 0; i < page_count; i++ )); do
        if spinner_cancelled; then
            _cancelled=1
            break
        fi

        local f="${page_files[$i]}"
        local f_mtime
        f_mtime=$(stat -c '%Y' "$f" 2>/dev/null || echo 0)
        page_mtimes[$i]="$f_mtime"
        # Reuse resolved thumbnail in this browse session when file mtime matches.
        if [[ "${BROWSE_THUMB_CACHE_MTIME[$f]:-}" == "$f_mtime" ]]; then
            local cached_thumb="${BROWSE_THUMB_CACHE_PATH[$f]:-}"
            if [[ -n "$cached_thumb" && "$cached_thumb" != "__NONE__" && -f "$cached_thumb" ]]; then
                thumb_paths[$i]="$cached_thumb"
            fi
            _done=$((_done + 1))
            spinner_tick "loading thumbnails"
            continue
        fi

        # Static images don't need thumbnail generation; avoid background job overhead.
        if ! is_live_file "$f"; then
            thumb_paths[$i]="$f"
            BROWSE_THUMB_CACHE_PATH[$f]="$f"
            BROWSE_THUMB_CACHE_MTIME[$f]="$f_mtime"
            _done=$((_done + 1))
            spinner_tick "loading thumbnails"
            continue
        fi

        while (( _running >= thumb_jobs )); do
            local _reaped=0 _j _pid
            for _j in "${!_thumb_pids[@]}"; do
                _pid="${_thumb_pids[$_j]}"
                [[ -n "$_pid" ]] || continue
                if ! kill -0 "$_pid" 2>/dev/null; then
                    wait "$_pid" 2>/dev/null || true
                    unset '_thumb_pids[_j]'
                    _running=$((_running - 1))
                    _done=$((_done + 1))
                    spinner_tick "loading thumbnails"
                    _reaped=1
                fi
            done
            if (( !_reaped )); then
                spinner_tick "loading thumbnails"
                if spinner_cancelled; then
                    _cancelled=1
                    break
                fi
                _sleep_ms 40
            fi
        done
        (( _cancelled )) && break

        (
            local _thumb
            _thumb=$(get_thumbnail "$f") || true
            if [[ -n "$_thumb" && -f "$_thumb" ]]; then
                printf '%s' "$_thumb" > "${thumb_tmp}/${i}.path"
            else
                : > "${thumb_tmp}/${i}.path"
            fi
        ) &
        _thumb_pids+=("$!")
        _running=$((_running + 1))
    done

    if (( _cancelled )); then
        local _pid
        for _pid in "${_thumb_pids[@]}"; do
            kill "$_pid" 2>/dev/null || true
        done
    fi

    while (( _running > 0 )); do
        local _reaped=0 _j _pid
        for _j in "${!_thumb_pids[@]}"; do
            _pid="${_thumb_pids[$_j]}"
            [[ -n "$_pid" ]] || continue
            if ! kill -0 "$_pid" 2>/dev/null; then
                wait "$_pid" 2>/dev/null || true
                unset '_thumb_pids[_j]'
                _running=$((_running - 1))
                _done=$((_done + 1))
                spinner_tick "loading thumbnails"
                _reaped=1
            fi
        done
        if (( !_reaped )); then
            spinner_tick "loading thumbnails"
            if spinner_cancelled; then
                for _pid in "${_thumb_pids[@]}"; do
                    [[ -n "$_pid" ]] && kill "$_pid" 2>/dev/null || true
                done
            fi
            _sleep_ms 40
        fi
    done

    for (( i = 0; i < page_count; i++ )); do
        local f="${page_files[$i]}"
        local f_mtime="${page_mtimes[$i]:-0}"
        local _thumb_path=""
        [[ -f "${thumb_tmp}/${i}.path" ]] && _thumb_path=$(<"${thumb_tmp}/${i}.path") || true
        if [[ -z "${thumb_paths[$i]}" && -n "$_thumb_path" && -f "$_thumb_path" ]]; then
            thumb_paths[$i]="$_thumb_path"
            BROWSE_THUMB_CACHE_PATH[$f]="$_thumb_path"
            BROWSE_THUMB_CACHE_MTIME[$f]="$f_mtime"
        elif [[ -z "${thumb_paths[$i]}" ]]; then
            BROWSE_THUMB_CACHE_PATH[$f]="__NONE__"
            BROWSE_THUMB_CACHE_MTIME[$f]="$f_mtime"
        fi
    done
    rm -rf "$thumb_tmp" 2>/dev/null || true
    spinner_clear fast

    # Render images using kitten icat --place for pixel-perfect positioning.
    # --place WxH@X,Y  (0-based cell coords from top-left of terminal)

    local count=${#thumb_paths[@]}
    for (( i = 0; i < count; i++ )); do
        spinner_cancelled && break
        local col_idx=$(( i % BROWSE_COLS ))
        local row_idx=$(( i / BROWSE_COLS ))

        local x=$(( col_idx * cell_w ))
        local y=$(( grid_top + row_idx * cell_h ))

        local thumb="${thumb_paths[$i]}"
        if [[ -n "$thumb" ]]; then
            kitten icat --place "${BROWSE_THUMB_W}x${BROWSE_THUMB_H}@${x}x${y}" \
                        --scale-up --transfer-mode=stream \
                        "$thumb" </dev/tty >/dev/tty 2>/dev/null || true
        fi
    done

    # Move cursor below the grid so subsequent output doesn't overlap
    local bottom=$(( grid_top + BROWSE_ROWS * cell_h ))
    printf '\033[%d;1H' "$((bottom + 1))" >/dev/tty 2>/dev/null
}

# Repaint a single cell's label in-place (no full redraw).
# Args: local_idx is_cursor is_marked filename
# Requires BROWSE_COLS, BROWSE_THUMB_W, BROWSE_THUMB_H, SPINNER_ROW to be set.
browse_update_label() {
    local idx="$1" is_cursor="$2" is_marked="$3" bname="$4"

    local gap=2
    local cell_w=$(( BROWSE_THUMB_W + gap ))
    local cell_h=$(( BROWSE_THUMB_H + 2 ))
    local grid_top=$(( SPINNER_ROW + 3 ))

    local col_idx=$(( idx % BROWSE_COLS ))
    local row_idx=$(( idx / BROWSE_COLS ))
    local x=$(( col_idx * cell_w ))
    local y=$(( grid_top + row_idx * cell_h ))
    local label_y=$(( y + BROWSE_THUMB_H ))

    local prefix=""
    if (( is_cursor )); then
        prefix="▸ "
    else
        prefix="  "
    fi
    if (( is_marked )); then
        prefix+="✓ "
    fi
    local label="${prefix}$((idx + 1))) ${bname}"
    (( ${#label} > BROWSE_THUMB_W )) && label="${label:0:$((BROWSE_THUMB_W - 3))}..." || true

    # Pad label to full cell width to overwrite old content
    local pad_len=$(( BROWSE_THUMB_W - ${#label} ))
    (( pad_len < 0 )) && pad_len=0 || true
    local padding=""
    printf -v padding "%*s" "$pad_len" ""

    printf '\033[%d;%dH' "$((label_y + 1))" "$((x + 1))" >/dev/tty 2>/dev/null
    if (( is_cursor )) && (( is_marked )); then
        printf '%b' "\033[7m${BOLD}${CYAN}${label}${RESET}${padding}" >/dev/tty 2>/dev/null
    elif (( is_cursor )); then
        printf '%b' "\033[7m${BOLD}${label}${RESET}${padding}" >/dev/tty 2>/dev/null
    elif (( is_marked )); then
        printf '%b' "${BOLD}${CYAN}${label}${RESET}${padding}" >/dev/tty 2>/dev/null
    else
        printf '%b' "${DIM}${label}${RESET}${padding}" >/dev/tty 2>/dev/null
    fi
}

cmd_browse() {
    require_commands kitten
    load_config
    require_tty "browse"

    local pool="current"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pool)
                [[ $# -ge 2 ]] || die "--pool requires: new|current|old"
                case "$2" in
                    new|n) pool="new" ;;
                    current|c) pool="current" ;;
                    old|o) pool="old" ;;
                    *) die "Invalid browse pool: $2" ;;
                esac
                shift 2
                ;;
            *)
                die "Unknown browse flag: $1"
                ;;
        esac
    done

    local source_dir
    source_dir=$(pool_dir "$pool") || die "Invalid pool: $pool"

    browse_refresh() {
        shopt -s nullglob
        files=("$source_dir"/*)
        shopt -u nullglob
        total=${#files[@]}
    }

    local -a files=()
    local total=0
    browse_refresh

    if (( total == 0 )); then
        draw_screen "browse ($pool)"
        print_info "no files in $pool"
        return 0
    fi

    local per_page total_pages
    local page=1
    local marked=""
    local cursor=0  # global index of cursor position
    local need_full_redraw=1
    local browse_bootstrapped=0
    local last_per_page=0

    # Helper: check if global index is in marked string
    _is_marked() {
        [[ "|${marked}|" == *"|${1}|"* ]]
    }

    # Helper: update labels after cursor moves (avoids full redraw when on same page)
    _grid_update_cursor() {
        if (( cursor == old_cursor )); then
            return 0
        fi
        if (( cursor / per_page + 1 == page )); then
            local old_local=$(( old_cursor - page_start ))
            local new_local=$(( cursor - page_start ))
            local old_m=0 new_m=0
            _is_marked "$old_cursor" && old_m=1 || true
            _is_marked "$cursor" && new_m=1 || true
            browse_update_label "$old_local" 0 "$old_m" "$(basename "${files[$old_cursor]}")"
            browse_update_label "$new_local" 1 "$new_m" "$(basename "${files[$cursor]}")"
        else
            need_full_redraw=1
        fi
    }

    # Helper: repaint status line and footer after mark count changes
    _grid_update_mark_ui() {
        local mc
        mc=$(browse_mark_count)
        local status_row=$(( SPINNER_ROW + 1 ))
        local grid_top=$(( SPINNER_ROW + 3 ))
        local cell_h=$(( BROWSE_THUMB_H + 2 ))
        local footer_row=$(( grid_top + BROWSE_ROWS * cell_h + 2 ))

        # Save cursor to restore position after status/footer repaint
        printf '\0337' >/dev/tty 2>/dev/null

        # Repaint status line
        printf '\033[%d;1H\033[2K' "$status_row" >/dev/tty 2>/dev/null
        printf '%b' "${BOLD}${MAGENTA}  browse${RESET} ${DIM}($pool)${RESET}  " >/dev/tty 2>/dev/null
        printf '%b' "${DIM}page $page/$total_pages  |  $total wallpapers${RESET}" >/dev/tty 2>/dev/null
        if (( mc > 0 )); then
            printf '%b' "  ${BOLD}${CYAN}[$mc marked]${RESET}" >/dev/tty 2>/dev/null
        fi

        # Disable auto-wrap to prevent scroll when writing at bottom of scroll region
        printf '\033[?7l' >/dev/tty 2>/dev/null
        # Repaint footer line
        printf '\033[%d;1H\033[2K' "$footer_row" >/dev/tty 2>/dev/null
        printf '%b' "  ${DIM}hjkl${RESET}/arrows navigate  " >/dev/tty 2>/dev/null
        printf '%b' "${CYAN}space${RESET} mark  " >/dev/tty 2>/dev/null
        printf '%b' "${GREEN}enter${RESET} expand  " >/dev/tty 2>/dev/null
        if (( mc > 0 )); then
            printf '%b' "${MAGENTA}A${RESET} archive  ${RED}D${RESET} delete  " >/dev/tty 2>/dev/null
        fi
        printf '%b' "${YELLOW}q${RESET} quit" >/dev/tty 2>/dev/null
        # Re-enable auto-wrap and restore cursor
        printf '\033[?7h' >/dev/tty 2>/dev/null
        printf '\0338' >/dev/tty 2>/dev/null
    }

    # Reuse mark helpers (same pattern as triage)
    browse_toggle_mark() {
        local idx="$1"
        if [[ "|${marked}|" == *"|${idx}|"* ]]; then
            local new_marked="" entry
            IFS='|' read -ra _m_arr <<< "$marked"
            for entry in "${_m_arr[@]}"; do
                [[ "$entry" == "$idx" ]] && continue
                [[ -z "$entry" ]] && continue
                new_marked="${new_marked:+${new_marked}|}${entry}"
            done
            marked="$new_marked"
        else
            marked="${marked:+${marked}|}${idx}"
        fi
    }

    browse_mark_count() {
        if [[ -z "$marked" ]]; then echo 0; return; fi
        local count=0
        IFS='|' read -ra _m_arr <<< "$marked"
        for entry in "${_m_arr[@]}"; do
            [[ -n "$entry" ]] && count=$((count + 1)) || true
        done
        echo "$count"
    }

    browse_bulk_action() {
        local action="$1"
        local mc
        mc=$(browse_mark_count)
        if (( mc == 0 )); then print_warn "no items marked"; sleep 1; return; fi

        local action_label
        case "$action" in
            archive) action_label="archive (move to old)" ;;
            delete) action_label="delete (move to trash)" ;;
            apply) action_label="apply (set wallpaper)" ;;
        esac
        printf "\n  ${BOLD}%s${RESET} %d marked wallpapers? ${DIM}[y/N]${RESET} " "$action_label" "$mc"
        local yn
        read -rsn1 yn
        printf "\n"
        [[ "$yn" == "y" || "$yn" == "Y" ]] || return

        IFS='|' read -ra _m_arr <<< "$marked"
        local -a sorted_indices=()
        for entry in "${_m_arr[@]}"; do
            [[ -n "$entry" ]] && sorted_indices+=("$entry") || true
        done
        IFS=$'\n' sorted_indices=($(sort -rn <<< "${sorted_indices[*]}")); unset IFS

        local processed=0
        for idx in "${sorted_indices[@]}"; do
            spinner_cancelled && break
            if (( idx < total )) && [[ -f "${files[$idx]}" ]]; then
                processed=$((processed + 1))
                spinner_tick "$action $processed/$mc"
                local f="${files[$idx]}"
                local bname
                bname=$(basename "$f")
                case "$action" in
                    archive)
                        if [[ "$pool" != "old" ]]; then
                            mv "$f" "$WALLPAPER_DIR_OLD/"
                            log "browse: archived $f"
                        fi
                        ;;
                    delete)
                        local trash_name="${pool}__${bname}"
                        mkdir -p "$TRASH_DIR"
                        mv "$f" "$TRASH_DIR/$trash_name"
                        log "browse: trashed $f"
                        ;;
                    apply)
                        set_wallpaper "$f"
                        ;;
                esac
            fi
        done
        spinner_clear

        marked=""
        browse_refresh
        printf "  ${GREEN}done${RESET}: %s %d items\n" "$action" "$mc"
        sleep 1
    }

    while :; do
        # Recalculate layout (handles terminal resize)
        browse_calc_layout
        per_page=$(( BROWSE_COLS * BROWSE_ROWS ))
        if (( !browse_bootstrapped || per_page != last_per_page )); then
            need_full_redraw=1
        fi
        last_per_page=$per_page
        total_pages=$(( (total + per_page - 1) / per_page ))
        (( total_pages < 1 )) && total_pages=1 || true
        (( page > total_pages )) && page=$total_pages || true

        if (( total == 0 )); then
            draw_screen "browse ($pool)"
            print_info "pool is empty"
            break
        fi

        # Clamp cursor
        (( cursor >= total )) && cursor=$((total - 1)) || true
        (( cursor < 0 )) && cursor=0 || true

        # Check if cursor moved to a different page
        local new_page=$(( cursor / per_page + 1 ))
        if (( new_page != page )); then
            page=$new_page
            need_full_redraw=1
        fi

        if (( need_full_redraw )); then
            local cursor_local=$(( cursor - (page - 1) * per_page ))
            local status_row=$(( SPINNER_ROW + 1 ))
            local grid_top_r=$(( SPINNER_ROW + 3 ))
            local cell_h_r=$(( BROWSE_THUMB_H + 2 ))
            local footer_row_r=$(( grid_top_r + BROWSE_ROWS * cell_h_r + 2 ))

            if (( !browse_bootstrapped )); then
                draw_screen
                browse_bootstrapped=1
            else
                kitten icat --clear >/dev/tty 2>/dev/null || true
                printf '\033[?7l' >/dev/tty 2>/dev/null
                local _r
                for (( _r = status_row; _r <= footer_row_r; _r++ )); do
                    printf '\033[%d;1H\033[2K' "$_r" >/dev/tty 2>/dev/null
                done
                printf '\033[?7h' >/dev/tty 2>/dev/null
            fi

            _grid_update_mark_ui
            browse_render_page "$page" "$per_page" "$total" "$total_pages" "$marked" "$cursor_local" "${files[@]}"
            need_full_redraw=0
        fi

        local key
        IFS= read -rsn1 key

        # Save old cursor for label updates
        local old_cursor=$cursor
        local page_start=$(( (page - 1) * per_page ))

        case "$key" in
            $'\x1b')
                local seq1 seq2
                read -rsn1 -t 0.05 seq1 || true
                read -rsn1 -t 0.05 seq2 || true
                case "$seq1$seq2" in
                    '[A') # Up
                        if (( cursor - BROWSE_COLS >= 0 )); then
                            cursor=$((cursor - BROWSE_COLS))
                        fi
                        ;;
                    '[B') # Down
                        if (( cursor + BROWSE_COLS < total )); then
                            cursor=$((cursor + BROWSE_COLS))
                        fi
                        ;;
                    '[D') # Left
                        (( cursor > 0 )) && cursor=$((cursor - 1)) || true
                        ;;
                    '[C') # Right
                        (( cursor < total - 1 )) && cursor=$((cursor + 1)) || true
                        ;;
                esac
                _grid_update_cursor
                ;;
            h)
                (( cursor > 0 )) && cursor=$((cursor - 1)) || true
                _grid_update_cursor
                ;;
            l)
                (( cursor < total - 1 )) && cursor=$((cursor + 1)) || true
                _grid_update_cursor
                ;;
            k)
                if (( cursor - BROWSE_COLS >= 0 )); then
                    cursor=$((cursor - BROWSE_COLS))
                fi
                _grid_update_cursor
                ;;
            j)
                if (( cursor + BROWSE_COLS < total )); then
                    cursor=$((cursor + BROWSE_COLS))
                fi
                _grid_update_cursor
                ;;
            ' ')
                # Toggle mark on cursor
                browse_toggle_mark "$cursor"
                # Update current label to show mark state
                local cur_local=$(( cursor - page_start ))
                local cur_m=0
                _is_marked "$cursor" && cur_m=1 || true
                # Advance cursor for rapid marking
                if (( cursor < total - 1 )); then
                    # Repaint old position (now not cursor)
                    browse_update_label "$cur_local" 0 "$cur_m" "$(basename "${files[$cursor]}")"
                    cursor=$((cursor + 1))
                    if (( cursor / per_page + 1 == page )); then
                        local new_local=$(( cursor - page_start ))
                        local new_m=0
                        _is_marked "$cursor" && new_m=1 || true
                        browse_update_label "$new_local" 1 "$new_m" "$(basename "${files[$cursor]}")"
                    else
                        need_full_redraw=1
                    fi
                else
                    # Last item, just update in place
                    browse_update_label "$cur_local" 1 "$cur_m" "$(basename "${files[$cursor]}")"
                fi
                # Update status line and footer to reflect mark count change
                if (( ! need_full_redraw )); then
                    _grid_update_mark_ui
                fi
                ;;
            ''|$'\n')
                # Enter: expand detail view for cursor item
                local detail_idx=$cursor
                local detail_back=0
                while (( detail_idx >= 0 && detail_idx < total )); do
                    local file="${files[$detail_idx]}"
                    if [[ ! -f "$file" ]]; then
                        break
                    fi

                    local w h size media_type
                    read -r w h <<< "$(get_media_dimensions "$file")"
                    size=$(du -h "$file" | awk '{print $1}')
                    if is_live_file "$file"; then
                        media_type="live"
                    else
                        media_type="static"
                    fi

                    local is_marked=""
                    if [[ "|${marked}|" == *"|${detail_idx}|"* ]]; then
                        is_marked="yes"
                    fi

                    draw_screen
                    printf '%b' "${BOLD}${MAGENTA}[$((detail_idx + 1))/$total]${RESET} $(basename "$file")"
                    if [[ -n "$is_marked" ]]; then
                        printf '%b' "  ${BOLD}${CYAN}[MARKED]${RESET}"
                    fi
                    printf "\n"
                    printf "%sx%s | %s | %s\n\n" "$w" "$h" "$size" "$media_type"

                    printf '%b' "  ${DIM}h${RESET} prev  ${DIM}l${RESET} next  "
                    printf '%b' "${CYAN}space${RESET} mark  "
                    printf '%b' "${GREEN}enter${RESET} apply  "
                    printf '%b' "${MAGENTA}a${RESET} archive  ${RED}d${RESET} delete  "
                    printf '%b' "${DIM}v${RESET} view  "
                    printf '%b' "${YELLOW}q${RESET} grid\n\n"

                    # Show preview
                    local thumb
                    spinner_tick "generating thumbnail"
                    thumb=$(get_thumbnail "$file") || true
                    if [[ -n "$thumb" && -f "$thumb" ]]; then
                        spinner_tick "rendering preview"
                        chafa -f "$(detect_chafa_format)" -s 80x24 "$thumb" || true
                        spinner_clear
                    else
                        spinner_clear
                        printf '%b' "  ${DIM}[no preview available]${RESET}\n"
                    fi

                    local action
                    printf "\naction: "
                    read -r -n1 action
                    printf "\n"

                    case "$action" in
                        ""|$'\n')
                            # Enter = apply as wallpaper
                            set_wallpaper "$file"
                            sleep 1
                            ;;
                        a|A)
                            if [[ "$pool" != "old" ]]; then
                                local bname
                                bname=$(basename "$file")
                                mv "$file" "$WALLPAPER_DIR_OLD/"
                                print_success "archived: $bname"
                                log "browse: archived $file"
                                browse_refresh
                                (( detail_idx >= total )) && break || true
                            else
                                print_info "already in old pool"
                                sleep 1
                            fi
                            ;;
                        d|D|x|X)
                            local bname
                            bname=$(basename "$file")
                            local trash_name="${pool}__${bname}"
                            mkdir -p "$TRASH_DIR"
                            mv "$file" "$TRASH_DIR/$trash_name"
                            print_success "trashed: $bname"
                            log "browse: trashed $file"
                            browse_refresh
                            (( detail_idx >= total )) && break || true
                            ;;
                        l|L)
                            (( detail_idx < total - 1 )) && detail_idx=$((detail_idx + 1)) || true
                            ;;
                        h|H)
                            (( detail_idx > 0 )) && detail_idx=$((detail_idx - 1)) || true
                            ;;
                        ' '|m|M)
                            browse_toggle_mark "$detail_idx"
                            ;;
                        v|V)
                            if is_live_file "$file"; then
                                if command -v mpv >/dev/null 2>&1; then
                                    mpv --loop --no-audio --really-quiet "$file" 2>/dev/null || true
                                else
                                    print_warn "mpv not installed for video preview"
                                    sleep 1
                                fi
                            else
                                open_image_viewer "$file"
                            fi
                            ;;
                        q|Q|$'\x1b')
                            detail_back=1
                            break
                            ;;
                        *)
                            ;;
                    esac
                done

                # Return cursor to where detail view ended up
                if (( detail_back )); then
                    cursor=$detail_idx
                fi
                (( cursor >= total )) && cursor=$((total > 0 ? total - 1 : 0)) || true
                need_full_redraw=1
                ;;
            [1-9])
                # Quick-jump: number selects slot on current page
                local slot=$((key))
                local jump_idx=$(( (page - 1) * per_page + slot - 1 ))
                if (( jump_idx < total && jump_idx != cursor )); then
                    cursor=$jump_idx
                    _grid_update_cursor
                fi
                ;;
            a|A)
                browse_bulk_action "archive"
                need_full_redraw=1
                ;;
            d|D)
                browse_bulk_action "delete"
                need_full_redraw=1
                ;;
            q|Q) break ;;
            *)
                ;;
        esac
    done
}

cmd_apply() {
    load_config
    local mode="random"
    local target_file=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pick)
                mode="pick"
                shift
                ;;
            random)
                mode="random"
                shift
                ;;
            *)
                if [[ -f "$1" ]]; then
                    mode="file"
                    target_file="$1"
                else
                    die "File not found: $1"
                fi
                shift
                ;;
        esac
    done

    draw_screen "apply wallpaper"

    case "$mode" in
        file)
            spinner_tick "applying wallpaper"
            set_wallpaper "$target_file"
            spinner_clear
            ;;
        pick)
            if ! command -v nsxiv >/dev/null 2>&1; then
                die "nsxiv required for --pick mode"
            fi
            local picked
            shopt -s nullglob
            local pool_files=("$WALLPAPER_DIR_CURRENT"/*)
            shopt -u nullglob
            if (( ${#pool_files[@]} == 0 )); then
                die "no wallpapers in current pool"
            fi
            picked=$(nsxiv -t -o "${pool_files[@]}" 2>/dev/null | head -n1 || true)
            if [[ -z "$picked" ]]; then
                print_info "no wallpaper selected"
                return 0
            fi
            spinner_tick "applying wallpaper"
            set_wallpaper "$picked"
            spinner_clear
            ;;
        random)
            spinner_tick "picking random wallpaper"
            local wallpaper
            if ! wallpaper=$(pick_random_wallpaper "$ROTATION_POOL"); then
                die "no wallpapers available in pool: $ROTATION_POOL"
            fi
            spinner_tick "applying wallpaper"
            set_wallpaper "$wallpaper"
            spinner_clear
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_screensaver
# ─────────────────────────────────────────────────────────────────────────────

screensaver_loop_wallpaper() {
    local wallpaper
    while :; do
        if wallpaper=$(pick_random_wallpaper "$SCREENSAVER_POOL"); then
            set_wallpaper "$wallpaper"
        fi
        sleep "$SCREENSAVER_INTERVAL"
    done
}

build_screensaver_filelist() {
    local dir file
    : > "$SCREENSAVER_LIST_FILE"
    spinner_tick "building file list"
    while IFS= read -r dir; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r -d '' file; do
            spinner_cancelled && break
            spinner_tick "checking $(basename "$file")"
            if is_selectable_wallpaper "$file"; then
                printf '%s\n' "$file" >> "$SCREENSAVER_LIST_FILE"
            fi
        done < <(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
                      -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \
                      -o -iname '*.mp4' -o -iname '*.webm' \) -print0)
    done < <(list_pool_dirs "$SCREENSAVER_POOL")
    spinner_clear
}

start_overlay_screensaver() {
    if ! command -v mpv >/dev/null 2>&1; then
        print_warn "mpv not found for overlay mode"
        return 1
    fi

    build_screensaver_filelist
    if [[ ! -s "$SCREENSAVER_LIST_FILE" ]]; then
        return 1
    fi

    local shuffled
    shuffled=$(shuf "$SCREENSAVER_LIST_FILE")
    if [[ -z "$shuffled" ]]; then
        return 1
    fi

    # mpv handles both images and video natively
    # --image-display-duration controls how long each image shows
    # videos play to completion then advance
    mpv --fullscreen --loop-playlist --no-audio --really-quiet \
        --image-display-duration="$SCREENSAVER_INTERVAL" \
        --playlist=<(printf '%s\n' "$shuffled") >/dev/null 2>&1 &
    printf '%s:mpv\n' "$!" > "$LOCK_FILE"
    return 0
}

cmd_screensaver() {
    load_config
    draw_screen "screensaver"
    local action="${1:-}"
    case "$action" in
        start)
            if screensaver_is_running; then
                print_info "screensaver already running"
                return 0
            fi
            if [[ "$SCREENSAVER_MODE" == "overlay" ]]; then
                if start_overlay_screensaver; then
                    print_success "screensaver overlay started (mpv)"
                else
                    print_warn "overlay mode unavailable; falling back to wallpaper mode"
                    if ! command -v swww >/dev/null 2>&1; then
                        die "swww required for wallpaper screensaver mode"
                    fi
                    screensaver_loop_wallpaper &
                    printf '%s:swww\n' "$!" > "$LOCK_FILE"
                    print_success "screensaver wallpaper loop started"
                fi
            else
                if ! command -v swww >/dev/null 2>&1; then
                    die "swww required for wallpaper screensaver mode"
                fi
                screensaver_loop_wallpaper &
                printf '%s:swww\n' "$!" > "$LOCK_FILE"
                print_success "screensaver wallpaper loop started"
            fi
            ;;
        stop)
            if screensaver_is_running; then
                local pid lock_type
                pid=$(awk -F: '{print $1}' "$LOCK_FILE" 2>/dev/null || true)
                lock_type=$(awk -F: '{print $2}' "$LOCK_FILE" 2>/dev/null || true)
                kill "$pid" 2>/dev/null || true
                # Also clean up any spawned mpv/mpvpaper processes
                case "$lock_type" in
                    mpv)
                        # Kill the specific mpv overlay if it's still around
                        pkill -P "$pid" 2>/dev/null || true
                        ;;
                    swww)
                        # Wallpaper loop may have spawned mpvpaper for live files
                        kill_live_wallpaper
                        ;;
                esac
                rm -f "$LOCK_FILE"
                rm -f "$SCREENSAVER_LIST_FILE"
                print_success "screensaver stopped"
            else
                print_info "screensaver not running"
            fi
            ;;
        toggle)
            if screensaver_is_running; then
                cmd_screensaver stop
            else
                cmd_screensaver start
            fi
            ;;
        status)
            if screensaver_is_running; then
                local lock_type
                lock_type=$(screensaver_lock_type || echo "unknown")
                print_info "screensaver: on (pool=$SCREENSAVER_POOL mode=$SCREENSAVER_MODE engine=$lock_type delay=${SCREENSAVER_INTERVAL}s)"
            else
                print_info "screensaver: off (pool=$SCREENSAVER_POOL mode=$SCREENSAVER_MODE delay=${SCREENSAVER_INTERVAL}s)"
            fi
            ;;
        *)
            die "Usage: $SCRIPT_NAME screensaver {start|stop|toggle|status}"
            ;;
    esac
}

