                spinner_tick "scanning trash"
                local count
                count=$(find "$TRASH_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
                spinner_clear
                print_info "$count file(s) in trash"
                find "$TRASH_DIR" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort
            else
                print_info "trash is empty"
            fi
            ;;
        --purge|purge)
            draw_screen "trash"
            purge_trash
            ;;
        *)
            die "Usage: $SCRIPT_NAME trash [--list|--purge]"
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Interactive menu selector (arrow keys / j,k / number keys)
# ─────────────────────────────────────────────────────────────────────────────

# menu_select RESULT_VAR label1 label2 ...
#   Renders a navigable menu, returns the 1-based index in RESULT_VAR.
#   Returns 0 on selection, 1 on quit.
#   Supports: arrow up/down, j/k, number keys (instant), Enter, q to quit.
menu_select() {
    local _result_var="$1"
    shift
    local -a items=("$@")
    local count=${#items[@]}
    local sel=0

    # Hide cursor
    printf '\033[?25l'

    # Print all items (initial render)
    local i
    for (( i = 0; i < count; i++ )); do
        if (( i == sel )); then
            printf "  \033[7m ${items[$i]} \033[0m\n"
        else
            printf "   ${items[$i]}\n"
        fi
    done
    # Hint line
    printf "\n  ${DIM}j/k or arrows to move, Enter to select, q to quit${RESET}\n"

    while :; do
        # Read a single key
        local key
        IFS= read -rsn1 key

        local prev_sel=$sel

        case "$key" in
            # Arrow keys: ESC [ A/B
            $'\x1b')
                local seq1 seq2
                read -rsn1 -t 0.05 seq1 || true
                read -rsn1 -t 0.05 seq2 || true
                case "$seq1$seq2" in
                    '[A') (( sel > 0 )) && sel=$((sel - 1)) ;;           # up
                    '[B') (( sel < count - 1 )) && sel=$((sel + 1)) ;;   # down
                esac
                ;;
            j|J) (( sel < count - 1 )) && sel=$((sel + 1)) ;;
            k|K) (( sel > 0 )) && sel=$((sel - 1)) ;;
            # Enter
            "")
                printf '\033[?25h'
                eval "$_result_var=$((sel + 1))"
                return 0
                ;;
            q|Q)
                printf '\033[?25h'
                eval "$_result_var=0"
                return 1
                ;;
            # Number keys: instant select
            [1-9])
                local num=$((key))
                if (( num >= 1 && num <= count )); then
                    printf '\033[?25h'
                    # Redraw to show selection before acting
                    sel=$((num - 1))
                    printf '\033[%dA' "$((count + 2))"
                    for (( i = 0; i < count; i++ )); do
                        printf '\033[2K\r'
                        if (( i == sel )); then
                            printf "  \033[7m ${items[$i]} \033[0m\n"
                        else
                            printf "   ${items[$i]}\n"
                        fi
                    done
                    printf '\033[2K\r\n\033[2K\r'
                    eval "$_result_var=$num"
                    return 0
                fi
                ;;
        esac

        # Redraw only if selection changed
        if (( prev_sel != sel )); then
            # Move cursor up to top of menu (count items + 2 for hint)
            printf '\033[%dA' "$((count + 2))"
            for (( i = 0; i < count; i++ )); do
                printf '\033[2K\r'
                if (( i == sel )); then
                    printf "  \033[7m ${items[$i]} \033[0m\n"
                else
                    printf "   ${items[$i]}\n"
                fi
            done
            # Redraw hint
            printf "\033[2K\r\n\033[2K\r  ${DIM}j/k or arrows to move, Enter to select, q to quit${RESET}\n"
        fi
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard renderer (shared by menu + status)
# ─────────────────────────────────────────────────────────────────────────────

render_dashboard() {
    local new_count current_count old_count trash_count saver_state

    new_count=$(count_media "$WALLPAPER_DIR_NEW")
    current_count=$(count_media "$WALLPAPER_DIR_CURRENT")
    old_count=$(count_media "$WALLPAPER_DIR_OLD")
    trash_count=$(find "$TRASH_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)

    if screensaver_is_running; then
        saver_state="on"
    else
        saver_state="off"
    fi

    # Build left column (pool stats + runtime info)
    local left=""
    left+="$(printf "  ${BOLD}%-20s${RESET} %-6s" "inbox (new)" "$new_count")"
    if (( new_count > 0 )); then
        left+="$(printf "  ${DIM}unreviewed${RESET}")"
    fi
    left+=$'\n'

    left+="$(printf "  ${BOLD}%-20s${RESET} %-6s" "active (current)" "$current_count")"
    if (( current_count > MAX_CURRENT_WARN )); then
        left+="$(printf "  ${YELLOW}over limit${RESET}")"
    fi
    left+=$'\n'

    left+="$(printf "  ${BOLD}%-20s${RESET} %-6s" "archive (old)" "$old_count")"
    left+=$'\n'

    if (( trash_count > 0 )); then
        left+="$(printf "  ${DIM}%-20s %-6s${RESET}" "trash" "$trash_count")"
        left+=$'\n'
    fi

    left+=$'\n'
    left+="$(printf "  ${BOLD}%-20s${RESET} %-6s  %s, %ss" \
           "screensaver" "$saver_state" "$SCREENSAVER_MODE" "$SCREENSAVER_INTERVAL")"
    left+=$'\n'
    left+="$(printf "  ${BOLD}%-20s${RESET} %-6s  pool: %s" \
           "rotation" "on" "$ROTATION_POOL")"

    # Build right column (current wallpaper preview)
    local right="" current_wp=""
    if command -v chafa >/dev/null 2>&1; then
        current_wp=$(get_current_wallpaper 2>/dev/null || true)
        if [[ -n "$current_wp" && -f "$current_wp" ]] && ! is_live_file "$current_wp"; then
            local wp_name
            wp_name=$(basename "$current_wp")
            # Truncate long filenames
            if (( ${#wp_name} > 28 )); then
                wp_name="${wp_name:0:25}..."
            fi
            right="$(printf " ${DIM}now playing${RESET}")"
            right+=$'\n'
            spinner_tick "rendering preview"
            right+="$(chafa -f "$(detect_chafa_format)" -s 28x8 "$current_wp" 2>/dev/null || true)"
            spinner_clear
            right+=$'\n'
            right+="$(printf " ${DIM}%s${RESET}" "$wp_name")"
        elif [[ -n "$current_wp" ]] && is_live_file "$current_wp"; then
            local wp_name
            wp_name=$(basename "$current_wp")
            if (( ${#wp_name} > 28 )); then
                wp_name="${wp_name:0:25}..."
            fi
            right="$(printf " ${DIM}now playing${RESET}")"
            right+=$'\n'
            right+="$(printf " ${MAGENTA}[live wallpaper]${RESET}")"
            right+=$'\n'
            right+="$(printf " ${DIM}%s${RESET}" "$wp_name")"
        fi
    fi

    # Merge columns and output
    printf "\n"
    if [[ -n "$right" ]]; then
        merge_columns "$left" "$right" 42 "  "
    else
        printf '%s\n' "$left"
    fi
    printf "\n"

    # Return values for suggested action
    DASH_NEW_COUNT="$new_count"
    DASH_CURRENT_COUNT="$current_count"
    DASH_DUPS="0"
}

suggest_action() {
    local suggestion=""
    if (( DASH_NEW_COUNT > 0 )); then
        suggestion="review $DASH_NEW_COUNT inbox wallpapers"
    elif (( DASH_CURRENT_COUNT > MAX_CURRENT_WARN )); then
        suggestion="archive: current ($DASH_CURRENT_COUNT) is over limit ($MAX_CURRENT_WARN)"
    elif (( DASH_NEW_COUNT == 0 )); then
        suggestion="download new wallpapers"
    fi

    if [[ -n "$suggestion" ]]; then
        printf "  ${CYAN}-> suggested: %s${RESET}\n\n" "$suggestion"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_fetch
# ─────────────────────────────────────────────────────────────────────────────

cmd_fetch() {
    local limit="$FETCH_LIMIT"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit)
                [[ $# -ge 2 ]] || die "--limit requires a numeric value"
                [[ "$2" =~ ^[0-9]+$ ]] || die "--limit must be numeric"
                limit="$2"
                shift 2
                ;;
            *) die "Unknown fetch flag: $1" ;;
        esac
    done

    require_commands curl jq identify sha256sum
    load_config
    draw_screen "download wallpapers"
    if (( ${#GITHUB_SOURCES[@]} > 0 )); then
        TOTAL_STEPS=6
    else
        TOTAL_STEPS=5
    fi
    STEP=0
    print_step "prepare directories and duplicate hash cache"
    purge_seen_hash_log
    purge_trash
    build_hash_cache

    local imported=0 imported_live=0 imported_static=0 processed=0
    local url
    local target="$limit"
    local target_live target_static
    local wallhaven_batch reddit_batch

    target_live=$(( target * LIVE_RATIO / 100 ))
    target_static=$(( target - target_live ))

    if (( target > 0 && target_live == 0 && LIVE_RATIO > 0 )); then
        target_live=1
        target_static=$(( target - 1 ))
    fi

    if (( target_live > target )); then
        target_live=$target
        target_static=0
    fi

    print_step "fetch wallhaven themed wallpapers"
    local q urls
    wallhaven_batch=$(( limit * 3 ))
    (( wallhaven_batch < 15 )) && wallhaven_batch=15 || true
    for q in "${KEYWORDS[@]}"; do
        (( imported >= target )) && break || true
        spinner_cancelled && break
        spinner_tick "wallhaven: $q ($imported/$target)"
        urls=$(curl -A "$USER_AGENT" -sS \
            "https://wallhaven.cc/api/v1/search?q=${q}&categories=111&purity=${WALLHAVEN_PURITY}&sorting=${WALLHAVEN_SORT}&atleast=${MIN_WIDTH}x${MIN_HEIGHT}" \
            | jq -r '.data[].path' | head -n "$wallhaven_batch")
        while IFS= read -r url; do
            (( imported >= target )) && break || true
            spinner_cancelled && break
            [[ -z "$url" ]] && continue
            local live=0
            is_live_url "$url" && live=1
            if (( live == 1 && imported_live >= target_live )); then
                continue
            fi
            if (( live == 0 && imported_static >= target_static )); then
                continue
            fi
            processed=$((processed + 1))
            spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
            if download_image "$url"; then
                imported=$((imported + 1))
                if (( live == 1 )); then
                    imported_live=$((imported_live + 1))
                else
                    imported_static=$((imported_static + 1))
                fi
            fi
        done <<< "$urls"
    done

    print_step "fetch reddit themed wallpapers"
    local sub reddit_urls
    reddit_batch=$(( limit * 3 ))
    (( reddit_batch < 20 )) && reddit_batch=20 || true
    for sub in "${REDDIT_SUBS[@]}"; do
        (( imported >= target )) && break || true
        spinner_cancelled && break
        spinner_tick "reddit: r/$sub ($imported/$target)"
        # Extract image/video URLs from reddit listings
        reddit_urls=$(curl -A "$USER_AGENT" -sS \
            "https://www.reddit.com/r/${sub}/top.json?t=month&limit=${reddit_batch}" \
            | jq -r '
                .data.children[].data |
                (
                    .url_overridden_by_dest // .url,
                    (.media?.reddit_video?.fallback_url // empty),
                    (.preview?.reddit_video_preview?.fallback_url // empty)
                )
            ' 2>/dev/null \
            | grep -Ei '\.(jpg|jpeg|png|webp|gif|gifv|mp4|webm)(\?.*)?$' \
            | sed 's/\?.*$//' \
            || true)
        while IFS= read -r url; do
            (( imported >= target )) && break || true
            spinner_cancelled && break
            [[ -z "$url" ]] && continue
            local live=0
            is_live_url "$url" && live=1
            if (( live == 1 && imported_live >= target_live )); then
                continue
            fi
            if (( live == 0 && imported_static >= target_static )); then
                continue
            fi
            processed=$((processed + 1))
            spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
            if download_image "$url"; then
                imported=$((imported + 1))
                if (( live == 1 )); then
                    imported_live=$((imported_live + 1))
                else
                    imported_static=$((imported_static + 1))
                fi
            fi
        done <<< "$reddit_urls"
    done

    if (( ${#GITHUB_SOURCES[@]} > 0 )); then
        print_step "fetch github wallpaper repos"
        if (( imported >= target )); then
            print_info "github skipped (target already met)"
        else
            local source gh_urls
            for source in "${GITHUB_SOURCES[@]}"; do
                (( imported >= target )) && break || true
                spinner_cancelled && break
                spinner_tick "github: $source ($imported/$target)"
                gh_urls=$(github_urls_for_source "$source" \
                    | grep -Ei '\.(jpg|jpeg|png|webp|gif|mp4|webm)$' || true)
                while IFS= read -r url; do
                    (( imported >= target )) && break || true
                    spinner_cancelled && break
                    [[ -z "$url" ]] && continue
                    local live=0
                    is_live_url "$url" && live=1
                    if (( live == 1 && imported_live >= target_live )); then
                        continue
                    fi
                    if (( live == 0 && imported_static >= target_static )); then
                        continue
                    fi
                    processed=$((processed + 1))
                    spinner_tick "download: $imported/$target (live $imported_live/$target_live, static $imported_static/$target_static)"
                    if download_image "$url"; then
                        imported=$((imported + 1))
                        if (( live == 1 )); then
                            imported_live=$((imported_live + 1))
                        else
                            imported_static=$((imported_static + 1))
                        fi
                    fi
                done <<< "$gh_urls"
            done
        fi
        spinner_clear
    fi

    print_step "fill remaining slots"
    if (( imported < target )); then
        for q in "${KEYWORDS[@]}"; do
            (( imported >= target )) && break || true
            spinner_cancelled && break
            urls=$(curl -A "$USER_AGENT" -sS \
                "https://wallhaven.cc/api/v1/search?q=${q}&categories=111&purity=${WALLHAVEN_PURITY}&sorting=${WALLHAVEN_SORT}&atleast=${MIN_WIDTH}x${MIN_HEIGHT}" \
                | jq -r '.data[].path' | head -n "$wallhaven_batch")
            while IFS= read -r url; do
                (( imported >= target )) && break || true
                spinner_cancelled && break
                [[ -z "$url" ]] && continue
                processed=$((processed + 1))
                spinner_tick "fill: $imported/$target"
                if download_image "$url"; then
                    imported=$((imported + 1))
                    if is_live_url "$url"; then
                        imported_live=$((imported_live + 1))
                    else
                        imported_static=$((imported_static + 1))
                    fi
                fi
            done <<< "$urls"
        done
        spinner_clear
    else
        print_info "fill skipped (target already met)"
    fi

    print_step "report status and warnings"
    print_success "imported $imported/$target wallpaper(s) to inbox (live $imported_live, static $imported_static)"
    if (( imported_live < target_live )); then
        print_warn "live target not fully met (wanted $target_live, got $imported_live)"
    fi
    duplicate_report
    warn_if_over_limit
    log "fetch completed: imported=$imported"
}

# ─────────────────────────────────────────────────────────────────────────────
# cmd_triage (review)
# ─────────────────────────────────────────────────────────────────────────────

triage_undo() {
    if (( ${#UNDO_ACTIONS[@]} == 0 )); then
        print_warn "nothing to undo"
        sleep 1
        return 1
    fi

    local last_idx=$(( ${#UNDO_ACTIONS[@]} - 1 ))
    local action="${UNDO_ACTIONS[$last_idx]}"
    local src="${UNDO_SRC_PATHS[$last_idx]}"
    local dst="${UNDO_DST_PATHS[$last_idx]}"

    case "$action" in
        keep|archive|delete)
            if [[ -f "$dst" ]]; then
                mv "$dst" "$src"
                print_success "undo $action: $(basename "$src") restored"
            else
                print_warn "undo failed: destination file missing"
                sleep 1
                return 1
            fi
            ;;
    esac

    unset 'UNDO_ACTIONS[last_idx]'
    unset 'UNDO_SRC_PATHS[last_idx]'
    unset 'UNDO_DST_PATHS[last_idx]'
    sleep 1
    return 0
}

cmd_triage() {
    require_commands identify kitten
    load_config
    require_tty "review"
    local source_pool="$REVIEW_POOL"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pool)
                [[ $# -ge 2 ]] || die "--pool requires: new|current|old"
                case "$2" in
                    new|n) source_pool="new" ;;
                    current|c) source_pool="current" ;;
                    old|o) source_pool="old" ;;
                    *) die "Invalid review pool: $2" ;;
                esac
                shift 2
                ;;
            *)
                die "Unknown triage flag: $1"
                ;;
        esac
    done
    local source_dir
    source_dir=$(pool_dir "$source_pool") || die "Invalid review pool: $source_pool"

    # Reset undo stack
    UNDO_ACTIONS=()
    UNDO_SRC_PATHS=()
    UNDO_DST_PATHS=()

    draw_screen "review ($source_pool)"

    # Load file list
    triage_refresh_files() {
        shopt -s nullglob
        files=("$source_dir"/*)
        shopt -u nullglob
        total=${#files[@]}
    }

    local -a files=()
    local total=0
    triage_refresh_files

    if (( total == 0 )); then
        print_info "no files in $source_pool"
        return 0
    fi

    local kept=0 moved_old=0 deleted=0 quit_requested=0

    # Marked indices (0-based into files array) stored as pipe-delimited string
    local marked=""

    # Helper: toggle mark on a 0-based index
    triage_toggle_mark() {
        local idx="$1"
        if [[ "|${marked}|" == *"|${idx}|"* ]]; then
            # Remove: rebuild without this index
            local new_marked="" entry
            IFS='|' read -ra _m_arr <<< "$marked"
            for entry in "${_m_arr[@]}"; do
                [[ "$entry" == "$idx" ]] && continue
                [[ -z "$entry" ]] && continue
                new_marked="${new_marked:+${new_marked}|}${entry}"
            done
            marked="$new_marked"
        else
            marked="${marked:+${marked}|}${idx}"
        fi
    }

    # Helper: count marked items
    triage_mark_count() {
        if [[ -z "$marked" ]]; then
            echo 0
            return
        fi
        local count=0
        IFS='|' read -ra _m_arr <<< "$marked"
        for entry in "${_m_arr[@]}"; do
            [[ -n "$entry" ]] && count=$((count + 1)) || true
        done
        echo "$count"
    }

    # Helper: perform action on a single file (0-based index)
    # Returns 0 on success. Caller must refresh files after.
    triage_act_on_file() {
        local action="$1" file="$2"
        local bname
        bname=$(basename "$file")
        case "$action" in
            keep)
                if [[ "$source_pool" != "current" ]]; then
                    mv "$file" "$WALLPAPER_DIR_CURRENT/"
                    UNDO_ACTIONS+=("keep")
                    UNDO_SRC_PATHS+=("$file")
                    UNDO_DST_PATHS+=("$WALLPAPER_DIR_CURRENT/$bname")
                fi
                kept=$((kept + 1))
                ;;
            archive)
                if [[ "$source_pool" != "old" ]]; then
                    mv "$file" "$WALLPAPER_DIR_OLD/"
                    UNDO_ACTIONS+=("archive")
                    UNDO_SRC_PATHS+=("$file")
                    UNDO_DST_PATHS+=("$WALLPAPER_DIR_OLD/$bname")
                fi
                moved_old=$((moved_old + 1))
                ;;
            delete)
                local trash_name="${source_pool}__${bname}"
                mkdir -p "$TRASH_DIR"
                mv "$file" "$TRASH_DIR/$trash_name"
                UNDO_ACTIONS+=("delete")
                UNDO_SRC_PATHS+=("$file")
                UNDO_DST_PATHS+=("$TRASH_DIR/$trash_name")
                deleted=$((deleted + 1))
                ;;
        esac
    }

    # Helper: bulk action on all marked files
    triage_bulk_action() {
        local action="$1"
        local mc
        mc=$(triage_mark_count)
        if (( mc == 0 )); then
            print_warn "no items marked"
            sleep 1
            return
        fi

        # Confirm
        local action_label
        case "$action" in
            keep) action_label="keep (move to current)" ;;
            archive) action_label="archive (move to old)" ;;
            delete) action_label="delete (move to trash)" ;;
        esac
        printf "\n  ${BOLD}%s${RESET} %d marked wallpapers? ${DIM}[y/N]${RESET} " "$action_label" "$mc"
        local yn
        read -rsn1 yn
        printf "\n"
        [[ "$yn" == "y" || "$yn" == "Y" ]] || return

        # Process marked items (iterate in reverse to avoid index shift issues)
        IFS='|' read -ra _m_arr <<< "$marked"
        local -a sorted_indices=()
        for entry in "${_m_arr[@]}"; do
            [[ -n "$entry" ]] && sorted_indices+=("$entry") || true
        done
        # Sort descending so removals don't shift indices
        IFS=$'\n' sorted_indices=($(sort -rn <<< "${sorted_indices[*]}")); unset IFS

        local processed=0
        for idx in "${sorted_indices[@]}"; do
            spinner_cancelled && break
            if (( idx < total )) && [[ -f "${files[$idx]}" ]]; then
                processed=$((processed + 1))
                spinner_tick "$action $processed/$mc"
                triage_act_on_file "$action" "${files[$idx]}"
            fi
        done
        spinner_clear

        marked=""
        triage_refresh_files

        printf "  ${GREEN}done${RESET}: %s %d items\n" "$action" "$mc"
        log "triage: bulk $action $mc items"
        sleep 1
    }

    # ── Grid view (thumbnail-first) ────────────────────────────────────────

    # Helper: check if global index is in marked string (0=marked, 1=not)
    _is_marked() {
        [[ "|${marked}|" == *"|${1}|"* ]]
    }

    # Helper: update labels after cursor moves (avoids full redraw when on same page)
    # Usage: cursor=$new_value; _grid_update_cursor
    # Reads: cursor, old_cursor, page, per_page, page_start, files[], need_full_redraw
    _grid_update_cursor() {
        if (( cursor == old_cursor )); then
            return 0
        fi
        if (( cursor / per_page + 1 == page )); then
            local old_local=$(( old_cursor - page_start ))
            local new_local=$(( cursor - page_start ))
            local old_m=0 new_m=0
            _is_marked "$old_cursor" && old_m=1 || true
            _is_marked "$cursor" && new_m=1 || true
            browse_update_label "$old_local" 0 "$old_m" "$(basename "${files[$old_cursor]}")"
            browse_update_label "$new_local" 1 "$new_m" "$(basename "${files[$cursor]}")"
        else
            need_full_redraw=1
        fi
    }

    # Helper: repaint status line and footer after mark count changes
    _grid_update_mark_ui() {
        local mc
        mc=$(triage_mark_count)
        local status_row=$(( SPINNER_ROW + 1 ))
        local grid_top=$(( SPINNER_ROW + 3 ))
        local cell_h=$(( BROWSE_THUMB_H + 2 ))
        local footer_row=$(( grid_top + BROWSE_ROWS * cell_h + 2 ))

        # Save cursor to restore position after status/footer repaint
        printf '\0337' >/dev/tty 2>/dev/null

        # Repaint status line
        printf '\033[%d;1H\033[2K' "$status_row" >/dev/tty 2>/dev/null
        printf '%b' "${BOLD}${MAGENTA}  review${RESET} ${DIM}($source_pool)${RESET}  " >/dev/tty 2>/dev/null
        printf '%b' "${DIM}page $page/$total_pages  |  $total wallpapers${RESET}" >/dev/tty 2>/dev/null
        if (( mc > 0 )); then
            printf '%b' "  ${BOLD}${CYAN}[$mc marked]${RESET}" >/dev/tty 2>/dev/null
        fi

        # Disable auto-wrap to prevent scroll when writing at bottom of scroll region
        printf '\033[?7l' >/dev/tty 2>/dev/null
        # Repaint footer line
        printf '\033[%d;1H\033[2K' "$footer_row" >/dev/tty 2>/dev/null
        printf '%b' "  ${DIM}hjkl${RESET}/arrows navigate  " >/dev/tty 2>/dev/null
        printf '%b' "${CYAN}space${RESET} mark  " >/dev/tty 2>/dev/null
        printf '%b' "${GREEN}enter${RESET} expand  " >/dev/tty 2>/dev/null
        if (( mc > 0 )); then
            printf '%b' "${GREEN}K${RESET} keep  ${MAGENTA}A${RESET} archive  ${RED}D${RESET} delete  " >/dev/tty 2>/dev/null
        fi
        printf '%b' "${LIGHT_GREEN}u${RESET} undo  " >/dev/tty 2>/dev/null
        printf '%b' "${YELLOW}q${RESET} quit" >/dev/tty 2>/dev/null
        # Re-enable auto-wrap and restore cursor
        printf '\033[?7h' >/dev/tty 2>/dev/null
        printf '\0338' >/dev/tty 2>/dev/null
    }

    local per_page total_pages
    local page=1
    local cursor=0  # global index of cursor position
    local need_full_redraw=1

    while :; do
        # Recalculate layout (handles terminal resize)
        browse_calc_layout
        per_page=$(( BROWSE_COLS * BROWSE_ROWS ))
        total_pages=$(( (total + per_page - 1) / per_page ))
        (( total_pages < 1 )) && total_pages=1 || true
        (( page > total_pages )) && page=$total_pages || true

        if (( total == 0 )); then
            draw_screen "review ($source_pool)"
            print_info "all wallpapers processed"
            break
        fi

        # Clamp cursor
        (( cursor >= total )) && cursor=$((total - 1)) || true
        (( cursor < 0 )) && cursor=0 || true

        # Check if cursor moved to a different page
        local new_page=$(( cursor / per_page + 1 ))
        if (( new_page != page )); then
            page=$new_page
            need_full_redraw=1
        fi

        if (( need_full_redraw )); then
            local cursor_local=$(( cursor - (page - 1) * per_page ))

            draw_screen
            local mc
            mc=$(triage_mark_count)
            printf '%b' "${BOLD}${MAGENTA}  review${RESET} ${DIM}($source_pool)${RESET}  "
            printf '%b' "${DIM}page $page/$total_pages  |  $total wallpapers${RESET}"
            if (( mc > 0 )); then
                printf '%b' "  ${BOLD}${CYAN}[$mc marked]${RESET}"
            fi
            printf "\n\n"

            browse_render_page "$page" "$per_page" "$total" "$total_pages" "$marked" "$cursor_local" "${files[@]}"

            # Position footer using absolute coords to avoid scroll-region scrolling
            local grid_top_r=$(( SPINNER_ROW + 3 ))
            local cell_h_r=$(( BROWSE_THUMB_H + 2 ))
            local footer_row_r=$(( grid_top_r + BROWSE_ROWS * cell_h_r + 2 ))
            # Disable auto-wrap to prevent scroll when writing at bottom of scroll region
            printf '\033[?7l' >/dev/tty 2>/dev/null
            printf '\033[%d;1H\033[2K' "$footer_row_r" >/dev/tty 2>/dev/null
            printf '%b' "  ${DIM}hjkl${RESET}/arrows navigate  " >/dev/tty 2>/dev/null
            printf '%b' "${CYAN}space${RESET} mark  " >/dev/tty 2>/dev/null
            printf '%b' "${GREEN}enter${RESET} expand  " >/dev/tty 2>/dev/null
            if (( mc > 0 )); then
                printf '%b' "${GREEN}K${RESET} keep  ${MAGENTA}A${RESET} archive  ${RED}D${RESET} delete  " >/dev/tty 2>/dev/null
            fi
            printf '%b' "${LIGHT_GREEN}u${RESET} undo  " >/dev/tty 2>/dev/null
            printf '%b' "${YELLOW}q${RESET} quit" >/dev/tty 2>/dev/null
            printf '\033[?7h' >/dev/tty 2>/dev/null
            need_full_redraw=0
        fi

        local key
        IFS= read -rsn1 key

        # Save old cursor for label updates
        local old_cursor=$cursor
        local page_start=$(( (page - 1) * per_page ))

        case "$key" in
            $'\x1b')
                local seq1 seq2
                read -rsn1 -t 0.05 seq1 || true
                read -rsn1 -t 0.05 seq2 || true
                case "$seq1$seq2" in
                    '[A') # Up
                        if (( cursor - BROWSE_COLS >= 0 )); then
                            cursor=$((cursor - BROWSE_COLS))
                        fi
                        ;;
                    '[B') # Down
                        if (( cursor + BROWSE_COLS < total )); then
                            cursor=$((cursor + BROWSE_COLS))
                        fi
                        ;;
                    '[D') # Left
                        (( cursor > 0 )) && cursor=$((cursor - 1)) || true
                        ;;
                    '[C') # Right
                        (( cursor < total - 1 )) && cursor=$((cursor + 1)) || true
                        ;;
                esac
                _grid_update_cursor
                ;;
            h)
                (( cursor > 0 )) && cursor=$((cursor - 1)) || true
                _grid_update_cursor
                ;;
            l)
                (( cursor < total - 1 )) && cursor=$((cursor + 1)) || true
                _grid_update_cursor
                ;;
            k)
                if (( cursor - BROWSE_COLS >= 0 )); then
                    cursor=$((cursor - BROWSE_COLS))
                fi
                _grid_update_cursor
                ;;
            j)
                if (( cursor + BROWSE_COLS < total )); then
                    cursor=$((cursor + BROWSE_COLS))
                fi
                _grid_update_cursor
                ;;
            ' ')
                # Toggle mark on cursor
                triage_toggle_mark "$cursor"
                # Update current label to show mark state
                local cur_local=$(( cursor - page_start ))
                local cur_m=0
                _is_marked "$cursor" && cur_m=1 || true
                # Advance cursor for rapid marking
                if (( cursor < total - 1 )); then
                    # Repaint old position (now not cursor)
                    browse_update_label "$cur_local" 0 "$cur_m" "$(basename "${files[$cursor]}")"
                    cursor=$((cursor + 1))
                    if (( cursor / per_page + 1 == page )); then
                        local new_local=$(( cursor - page_start ))
                        local new_m=0
                        _is_marked "$cursor" && new_m=1 || true
                        browse_update_label "$new_local" 1 "$new_m" "$(basename "${files[$cursor]}")"
                    else
                        need_full_redraw=1
                    fi
                else
                    # Last item, just update in place
                    browse_update_label "$cur_local" 1 "$cur_m" "$(basename "${files[$cursor]}")"
                fi
                # Update status line and footer to reflect mark count change
                if (( ! need_full_redraw )); then
                    _grid_update_mark_ui
                fi
                ;;
            ''|$'\n')
                # Enter: expand detail view for cursor item
                local detail_idx=$cursor
                local detail_back=0
                while (( detail_idx >= 0 && detail_idx < total )); do
                    local file="${files[$detail_idx]}"
                    if [[ ! -f "$file" ]]; then
                        break
                    fi

                    local w h size media_type
                    read -r w h <<< "$(get_media_dimensions "$file")"
                    size=$(du -h "$file" | awk '{print $1}')
                    if is_live_file "$file"; then
                        media_type="live"
                    else
                        media_type="static"
                    fi

                    local is_marked_str=""
                    _is_marked "$detail_idx" && is_marked_str="yes" || true

                    draw_screen
                    printf '%b' "${BOLD}${MAGENTA}[$((detail_idx + 1))/$total]${RESET} $(basename "$file")"
                    if [[ -n "$is_marked_str" ]]; then
                        printf '%b' "  ${BOLD}${CYAN}[MARKED]${RESET}"
                    fi
                    printf "\n"
                    printf "%sx%s | %s | %s\n\n" "$w" "$h" "$size" "$media_type"

                    printf '%b' "  ${DIM}h${RESET} prev  ${DIM}l${RESET} next  "
                    printf '%b' "${CYAN}space${RESET} mark  "
                    printf '%b' "${GREEN}enter/k${RESET} keep  ${MAGENTA}a${RESET} archive  ${RED}d${RESET} delete  "
                    printf '%b' "${DIM}v${RESET} view  ${DIM}i${RESET} info  "
                    printf '%b' "${YELLOW}q${RESET} grid\n\n"

                    # Show preview
                    local thumb
                    spinner_tick "generating thumbnail"
                    thumb=$(get_thumbnail "$file") || true
                    if [[ -n "$thumb" && -f "$thumb" ]]; then
                        spinner_tick "rendering preview"
                        chafa -f "$(detect_chafa_format)" -s 80x24 "$thumb" || true
                        spinner_clear
                    else
                        spinner_clear
                        printf '%b' "  ${DIM}[no preview available]${RESET}\n"
                    fi

                    local action
                    printf "\naction: "
                    read -r -n1 action
                    printf "\n"

                    case "$action" in
                        ""|k|K)
                            triage_act_on_file "keep" "$file"
                            triage_refresh_files
                            (( detail_idx >= total )) && break || true
                            ;;
                        a|A)
                            triage_act_on_file "archive" "$file"
                            triage_refresh_files
                            (( detail_idx >= total )) && break || true
                            ;;
                        d|D|x|X)
                            triage_act_on_file "delete" "$file"
                            triage_refresh_files
                            (( detail_idx >= total )) && break || true
                            ;;
                        l|L)
                            (( detail_idx < total - 1 )) && detail_idx=$((detail_idx + 1)) || true
                            ;;
                        h|H)
                            (( detail_idx > 0 )) && detail_idx=$((detail_idx - 1)) || true
                            ;;
                        ' '|m|M)
                            triage_toggle_mark "$detail_idx"
                            ;;
                        v|V)
                            if is_live_file "$file"; then
                                if command -v mpv >/dev/null 2>&1; then
                                    mpv --loop --no-audio --really-quiet "$file" 2>/dev/null || true
                                else
                                    print_warn "mpv not installed for video preview"
                                    sleep 1
                                fi
                            else
                                open_image_viewer "$file"
                            fi
                            ;;
                        u|U)
                            triage_undo || true
                            triage_refresh_files
                            (( detail_idx >= total )) && break || true
                            ;;
                        i|I)
                            local fhash
                            fhash=$(sha256sum "$file" | awk '{print $1}')
                            printf "\n%b\n" "${BOLD}file info${RESET}"
                            printf "  path: %s\n" "$file"
                            printf "  hash: %s\n" "$fhash"
                            printf "  dims: %sx%s\n" "$w" "$h"
                            printf "  size: %s\n" "$size"
                            printf "  type: %s\n" "$media_type"
                            printf "\nPress Enter..."
                            read -r _
                            ;;
                        q|Q|$'\x1b')
                            detail_back=1
                            break
                            ;;
                        *)
                            ;;
                    esac
                done

                # Return cursor to where detail view ended up
                if (( detail_back )); then
                    cursor=$detail_idx
                fi
                (( cursor >= total )) && cursor=$((total > 0 ? total - 1 : 0)) || true
                need_full_redraw=1
                ;;
            [1-9])
                # Quick-jump: number selects slot on current page
                local slot=$((key))
                local jump_idx=$(( (page - 1) * per_page + slot - 1 ))
                if (( jump_idx < total && jump_idx != cursor )); then
                    cursor=$jump_idx
                    _grid_update_cursor
                fi
                ;;
            a|A)
                triage_bulk_action "archive"
                need_full_redraw=1
                ;;
            d|D)
                triage_bulk_action "delete"
                need_full_redraw=1
                ;;
            K)
                triage_bulk_action "keep"
                need_full_redraw=1
                ;;
            u|U)
                triage_undo || true
                triage_refresh_files
                need_full_redraw=1
                ;;
            \?)
                printf "\n%b\n" "${BOLD}grid keys${RESET}"
                printf "  ${GREEN}hjkl${RESET}/arrows  navigate cursor\n"
                printf "  ${CYAN}space${RESET}        toggle mark on cursor\n"
                printf "  ${GREEN}enter${RESET}        expand detail view\n"
                printf "  ${DIM}1-9${RESET}          jump cursor to slot\n"
                printf "  ${GREEN}K${RESET}            bulk keep marked items\n"
                printf "  ${MAGENTA}A${RESET}            bulk archive marked items\n"
                printf "  ${RED}D${RESET}            bulk delete marked items\n"
                printf "  ${LIGHT_GREEN}u${RESET}            undo last action\n"
                printf "  ${YELLOW}q${RESET}            quit triage\n"
                printf "\nPress Enter..."
                read -r _
                need_full_redraw=1
                ;;
            q|Q)
                quit_requested=1
                break
                ;;
            *)
                # ignore unknown keys
                ;;
        esac
    done

    if (( quit_requested == 1 )); then
        draw_screen "review aborted"
    else
        draw_screen "review summary"
    fi
    print_success "kept: $kept"
    print_info "archived: $moved_old"
    print_info "deleted (in trash): $deleted"
    warn_if_over_limit
    log "triage completed: kept=$kept old=$moved_old deleted=$deleted"
}

