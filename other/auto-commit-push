# Script: auto-commit-push
# Purpose: Automatically commit and push changes in specified repositories
# Features: Batch processing, retry logic, logging, optional AI commit messages
# Author: groot
# Created: 2026-02-14

set -euo pipefail

# Colors
BOLD='\033[1m'
RESET='\033[0m'
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
GRAY='\033[90m'

# Configuration
LOG_FILE="${HOME}/.local/log/auto-commit-push.log"
LOCK_FILE="/run/user/$(id -u)/auto-commit-push.lock"
MAX_RETRIES=3
COMMIT_AI_SCRIPT="${HOME}/.local/bin/git-commit-ai"
USE_AI="${USE_AI_COMMIT:-false}"

# Default repos to auto-commit
declare -A REPOS=(
    [dotfiles]="/home/groot/dotfiles"
    [journal]="/home/groot/projects/journal"
    [notes]="/home/groot/projects/notes"
    [scripts]="/home/groot/projects/scripts"
)

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

error() {
    echo -e "${RED}✗ Error:${RESET} $*" >&2
    log "ERROR: $*"
}

info() {
    echo -e "${BLUE}ℹ${RESET} $*"
    log "INFO: $*"
}

success() {
    echo -e "${GREEN}✓${RESET} $*"
    log "SUCCESS: $*"
}

warn() {
    echo -e "${YELLOW}⚠${RESET} $*"
    log "WARN: $*"
}

usage() {
    cat <<EOF
${BOLD}Usage:${RESET}
  auto-commit-push [options] [repo_name ...]

${BOLD}Options:${RESET}
  -h, --help            Show this help message
  -a, --all             Commit all configured repos
  -l, --list            List configured repos
  -s, --status          Show status of all repos without committing
  --ai                  Use AI to generate commit messages
  --force               Skip confirmation prompts
  -m, --message MSG     Custom commit message template (use %s for repo name)

${BOLD}Default Repos:${RESET}
  dotfiles              - System configuration and dotfiles
  journal               - Personal journal entries
  notes                 - Notes repository
  scripts               - Custom scripts and tools

${BOLD}Examples:${RESET}
  auto-commit-push journal dotfiles          # Commit specific repos
  auto-commit-push --all                     # Commit all configured repos
  auto-commit-push -s                        # Show status without committing
  auto-commit-push --ai journal              # Use AI for commit message
  auto-commit-push --force -m "Update %s"   # Force commit with custom message
EOF
}

# Acquire lock to prevent concurrent execution
acquire_lock() {
    if mkdir "$LOCK_FILE" 2>/dev/null; then
        trap 'rm -rf "$LOCK_FILE"' EXIT
        return 0
    else
        error "Another instance is already running (lock: $LOCK_FILE)"
        exit 1
    fi
}

# List configured repos
list_repos() {
    echo -e "${BOLD}Configured Repositories:${RESET}\n"
    for name in "${!REPOS[@]}"; do
        local path="${REPOS[$name]}"
        if [ -d "$path/.git" ]; then
            printf "${GREEN}✓${RESET} %-15s %s\n" "$name" "$path"
        else
            printf "${RED}✗${RESET} %-15s %s (not a git repo)\n" "$name" "$path"
        fi
    done
}

# Show status of repos
show_status() {
    echo -e "${BOLD}Repository Status:${RESET}\n"
    for name in "${!REPOS[@]}"; do
        local path="${REPOS[$name]}"
        if [ ! -d "$path/.git" ]; then
            printf "${RED}✗${RESET} %-15s Not a git repo\n" "$name"
            continue
        fi

        cd "$path"

        # Get uncommitted changes
        local unstaged=$(git diff --shortstat 2>/dev/null | awk '{print $1}' || echo "0")
        local staged=$(git diff --cached --shortstat 2>/dev/null | awk '{print $1}' || echo "0")
        local untracked=$(git ls-files --others --exclude-standard | wc -l)

        # Get unpushed commits
        local unpushed=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo "0")

        if [ "$staged" != "0" ] || [ "$unstaged" != "0" ] || [ "$untracked" != "0" ] || [ "$unpushed" != "0" ]; then
            printf "${YELLOW}◆${RESET} %-15s" "$name"
            [ "$staged" != "0" ] && printf " [staged: %s]" "$staged"
            [ "$unstaged" != "0" ] && printf " [modified: %s]" "$unstaged"
            [ "$untracked" != "0" ] && printf " [untracked: %s]" "$untracked"
            [ "$unpushed" != "0" ] && printf " [unpushed: %s]" "$unpushed"
            echo
        else
            printf "${GREEN}✓${RESET} %-15s Up to date\n" "$name"
        fi
    done
}

# Process a single repo
process_repo() {
    local name="$1"
    local path="${REPOS[$name]}"
    local message="${2:-}"
    local use_ai="${3:-$USE_AI}"

    if [ ! -d "$path/.git" ]; then
        error "Not a git repository: $path"
        return 1
    fi

    cd "$path"

    # Check if there are changes (including untracked files)
    if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
        info "$name: No changes"
        return 0
    fi

    info "Processing: $name"

    # Stage all changes
    git add -A

    # Generate or use provided commit message
    local commit_msg=""
    if [ "$use_ai" = "true" ] && [ -x "$COMMIT_AI_SCRIPT" ]; then
        info "Generating commit message with AI..."
        if commit_msg=$("$COMMIT_AI_SCRIPT" --no-push --dry-run "$path" 2>&1 | grep "^" | tail -1); then
            [ -z "$commit_msg" ] && commit_msg="Update $name"
        else
            warn "AI commit generation failed, using fallback"
            commit_msg="Update $name"
        fi
    elif [ -n "$message" ]; then
        commit_msg="${message//\%s/$name}"
    else
        commit_msg="Update $name: $(date '+%Y-%m-%d %H:%M:%S')"
    fi

    # Attempt commit with retries
    local attempt=1
    while [ $attempt -le $MAX_RETRIES ]; do
        if git commit -m "$commit_msg"; then
            success "$name: Committed"
            break
        else
            if [ $attempt -lt $MAX_RETRIES ]; then
                warn "$name: Commit attempt $attempt failed, retrying..."
                sleep 2
            else
                error "$name: Commit failed after $MAX_RETRIES attempts"
                return 1
            fi
        fi
        ((attempt++))
    done

    # Push with retries
    attempt=1
    while [ $attempt -le $MAX_RETRIES ]; do
        if git push; then
            success "$name: Pushed"
            log "Successfully committed and pushed: $name"
            return 0
        else
            if [ $attempt -lt $MAX_RETRIES ]; then
                warn "$name: Push attempt $attempt failed, retrying..."
                sleep 2
            else
                warn "$name: Push failed after $MAX_RETRIES attempts (commits are local)"
                log "WARN: Push failed for $name after $MAX_RETRIES attempts"
                return 1
            fi
        fi
        ((attempt++))
    done

    return 0
}

# Main execution
main() {
    local mode="process"
    local target_repos=()
    local message=""
    local force=false
    local use_ai=$USE_AI

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                exit 0
                ;;
            -a|--all)
                target_repos=("${!REPOS[@]}")
                shift
                ;;
            -l|--list)
                list_repos
                exit 0
                ;;
            -s|--status)
                show_status
                exit 0
                ;;
            --ai)
                use_ai=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            -m|--message)
                message="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                usage
                exit 1
                ;;
            *)
                target_repos+=("$1")
                shift
                ;;
        esac
    done

    # If no repos specified, show help
    if [ ${#target_repos[@]} -eq 0 ]; then
        error "No repositories specified"
        echo
        usage
        exit 1
    fi

    acquire_lock

    info "Auto-commit-push started"

    # Show what will be processed
    echo -e "${BOLD}Repositories to process:${RESET}"
    for repo in "${target_repos[@]}"; do
        if [[ -v REPOS[$repo] ]]; then
            echo "  ${REPOS[$repo]}"
        else
            error "Unknown repository: $repo"
            exit 1
        fi
    done
    echo

    # Confirm unless forced
    if [ "$force" != "true" ]; then
        read -p "Continue? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            warn "Cancelled"
            exit 0
        fi
    fi

    # Process each repo
    local success_count=0
    local fail_count=0

    for repo in "${target_repos[@]}"; do
        if process_repo "$repo" "$message" "$use_ai"; then
            ((success_count++))
        else
            ((fail_count++))
        fi
    done

    # Summary
    echo
    echo -e "${BOLD}Summary:${RESET}"
    printf "${GREEN}✓ Success: %d${RESET}\n" "$success_count"
    if [ $fail_count -gt 0 ]; then
        printf "${RED}✗ Failed: %d${RESET}\n" "$fail_count"
    fi

    info "Auto-commit-push completed (success: $success_count, failed: $fail_count)"

    [ $fail_count -eq 0 ] && exit 0 || exit 1
}

main "$@"
