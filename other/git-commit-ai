#
# Script: git-commit-ai
# Purpose: Generate smart commit messages using Claude AI based on git diff
# Dependencies: curl, jq, git, ANTHROPIC_API_KEY environment variable
# Author: groot
# Created: 2026-02-14

set -euo pipefail

# Colors
BOLD='\033[1m'
RESET='\033[0m'
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'

# Configuration
API_KEY="${ANTHROPIC_API_KEY:-}"
MAX_DIFF_LINES=100
LOG_FILE="${HOME}/.local/log/git-commit-ai.log"

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

error() {
    echo -e "${RED}✗ Error:${RESET} $*" >&2
    log "ERROR: $*"
    exit 1
}

info() {
    echo -e "${BLUE}ℹ${RESET} $*"
    log "INFO: $*"
}

success() {
    echo -e "${GREEN}✓${RESET} $*"
    log "SUCCESS: $*"
}

warn() {
    echo -e "${YELLOW}⚠${RESET} $*"
    log "WARN: $*"
}

usage() {
    cat <<EOF
${BOLD}Usage:${RESET}
  git-commit-ai [options] [repo_path]

${BOLD}Options:${RESET}
  -h, --help            Show this help message
  -m, --model MODEL     Use specific Claude model (default: claude-3-5-sonnet-20241022)
  -t, --type TYPE       Commit type: feature, fix, refactor, docs, test, style, chore
  -c, --context TEXT    Additional context for the commit message
  --dry-run             Generate message but don't commit
  --no-push             Commit but don't push

${BOLD}Examples:${RESET}
  git-commit-ai                              # Auto-commit current repo
  git-commit-ai /home/user/projects/myapp   # Auto-commit specific repo
  git-commit-ai -t fix --dry-run             # Show generated message, don't commit
  git-commit-ai -c "Fixes issue #123"        # Add extra context
EOF
}

# Check dependencies
check_dependencies() {
    local deps=("curl" "jq" "git")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            error "Missing dependency: $dep"
        fi
    done

    if [ -z "$API_KEY" ]; then
        error "ANTHROPIC_API_KEY environment variable not set"
    fi
}

# Get staged changes diff
get_diff() {
    local repo_path="$1"
    cd "$repo_path"
    
    # Check if there are staged changes
    if ! git diff --cached --quiet; then
        git diff --cached --no-ext-diff | head -n "$MAX_DIFF_LINES"
    else
        # If nothing staged, show unstaged changes
        if git diff --quiet; then
            echo ""
        else
            git diff --no-ext-diff | head -n "$MAX_DIFF_LINES"
        fi
    fi
}

# Get changed files list
get_changed_files() {
    local repo_path="$1"
    cd "$repo_path"
    git diff --cached --name-only --diff-filter=ACMRU 2>/dev/null || git diff --name-only --diff-filter=ACMRU
}

# Generate commit message using Claude
generate_commit_message() {
    local diff="$1"
    local changed_files="$2"
    local commit_type="${3:-}"
    local context="${4:-}"
    local model="${5:-claude-3-5-sonnet-20241022}"

    if [ -z "$diff" ] && [ -z "$changed_files" ]; then
        error "No changes to commit"
    fi

    local type_instruction=""
    if [ -n "$commit_type" ]; then
        type_instruction="The commit type should be: $commit_type"
    fi

    local prompt="You are a git commit message generator. Analyze the following changes and generate a concise, meaningful commit message.

${type_instruction}
${context:+Additional context: $context}

Changed files:
$changed_files

Diff:
$diff

Generate a commit message that:
1. Starts with a type prefix (feat, fix, docs, test, refactor, style, chore) if not specified
2. Is concise (under 50 characters for subject)
3. Uses imperative mood (e.g., 'Add', 'Fix', not 'Added', 'Fixes')
4. Follows conventional commits format
5. Only includes the subject line, no body or description

Return ONLY the commit message, nothing else."

    local response
    response=$(curl -s -X POST "https://api.anthropic.com/v1/messages" \
        -H "x-api-key: $API_KEY" \
        -H "anthropic-version: 2023-06-01" \
        -H "content-type: application/json" \
        -d "{
            \"model\": \"$model\",
            \"max_tokens\": 100,
            \"messages\": [
                {
                    \"role\": \"user\",
                    \"content\": $(echo -n "$prompt" | jq -Rs .)
                }
            ]
        }" 2>/dev/null)

    # Check for API errors
    if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
        local error_msg=$(echo "$response" | jq -r '.error.message // "Unknown error"')
        error "Claude API error: $error_msg"
    fi

    # Extract the commit message
    local commit_msg=$(echo "$response" | jq -r '.content[0].text' 2>/dev/null | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [ -z "$commit_msg" ]; then
        error "Failed to generate commit message"
    fi

    echo "$commit_msg"
}

# Perform the commit and optional push
perform_commit() {
    local repo_path="$1"
    local commit_msg="$2"
    local no_push="${3:-false}"

    cd "$repo_path"

    # Stage all changes if nothing is staged
    if git diff --cached --quiet; then
        info "No staged changes, staging all changes..."
        git add -A
    fi

    # Commit
    if git commit -m "$commit_msg"; then
        success "Committed: $commit_msg"
        log "Committed in $repo_path: $commit_msg"
    else
        error "Failed to commit"
    fi

    # Push if not disabled
    if [ "$no_push" != "true" ]; then
        if git push; then
            success "Pushed to remote"
            log "Pushed from $repo_path"
        else
            warn "Push failed (this might be expected if remote is not configured)"
            log "WARN: Push failed from $repo_path"
        fi
    fi
}

# Main execution
main() {
    local repo_path="."
    local model="claude-3-5-sonnet-20241022"
    local commit_type=""
    local context=""
    local dry_run=false
    local no_push=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                exit 0
                ;;
            -m|--model)
                model="$2"
                shift 2
                ;;
            -t|--type)
                commit_type="$2"
                shift 2
                ;;
            -c|--context)
                context="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --no-push)
                no_push=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                repo_path="$1"
                shift
                ;;
        esac
    done

    check_dependencies

    info "Analyzing changes in: $repo_path"

    # Get diff and changed files
    local diff=$(get_diff "$repo_path")
    local changed_files=$(get_changed_files "$repo_path")

    if [ -z "$changed_files" ]; then
        warn "No changes detected"
        exit 0
    fi

    info "Generating commit message..."

    # Generate the commit message
    local commit_msg=$(generate_commit_message "$diff" "$changed_files" "$commit_type" "$context" "$model")

    echo -e "\n${BOLD}Generated Commit Message:${RESET}"
    echo -e "${GREEN}$commit_msg${RESET}\n"

    if [ "$dry_run" = true ]; then
        info "Dry-run mode: not committing"
        exit 0
    fi

    read -p "Commit with this message? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        perform_commit "$repo_path" "$commit_msg" "$no_push"
    else
        warn "Commit cancelled"
        exit 1
    fi
}

main "$@"
