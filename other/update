# Script: update
# Purpose: System package updater (yay/apt) with npm, conflict detection, and error reporting
# Dependencies: yay or apt, npm (optional), flock
# Author: groot
# Modified: 2026-02-14

set -euo pipefail

# Colors
BOLD='\033[1m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# State tracking
ERRORS_OCCURRED=0
NPM_ERRORS=""
SYSTEM_ERRORS=""

# Status helpers
header() {
    printf '\n\033[1m%s\033[0m\n' "$1"
    printf '%s\n' "─────────────"
}
info()   { printf '\033[1;34m==>\033[0m %s ' "$1"; }
ok()     { printf '\033[1;32m✓\033[0m\n'; }
fail()   { printf '\033[1;31m✗\033[0m %s\n' "$1"; }
warn()   { printf '\033[1;33m⚠\033[0m %s\n' "$1"; }

# Lock file management
LOCK_DIR="/run/user/$(id -u)"
LOCK_FILE="${LOCK_DIR}/update.lock"
LOCK_FD=200

acquire_lock() {
    mkdir -p "$LOCK_DIR"
    eval "exec $LOCK_FD>'$LOCK_FILE'"
    if ! flock -n "$LOCK_FD" 2>/dev/null; then
        return 1
    fi
    return 0
}

release_lock() {
    flock -u "$LOCK_FD" 2>/dev/null || true
    eval "exec $LOCK_FD>&-" 2>/dev/null || true
}

# Ensure log directory exists
LOG_FILE="$HOME/.local/log/updater.log"
mkdir -p "$(dirname "$LOG_FILE")"

# Detect distro
if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO="$ID"
else
    DISTRO="unknown"
fi

# Function to update npm (before system updates)
update_npm() {
    if ! command -v npm >/dev/null 2>&1; then
        info "npm not installed"
        warn "Skipping npm updates"
        return 0
    fi

    info "npm will be updated via pacman/apt"
    warn "System package manager handles npm updates safely"
}

# Function to check and handle npm conflicts (Arch only)
handle_npm_conflicts() {
    if [[ "$DISTRO" != "arch" ]]; then
        return 0
    fi

    local npm_base="/usr/lib/node_modules/npm"
    local conflict_files=()

    # Check for known conflicting files
    local known_conflicts=(
        "docs/content/commands/npm-get.md"
        "docs/content/commands/npm-ll.md"
        "docs/content/commands/npm-set.md"
        "docs/content/commands/npm-trust.md"
        "docs/output/commands/npm-get.html"
        "docs/output/commands/npm-ll.html"
        "docs/output/commands/npm-set.html"
        "docs/output/commands/npm-trust.html"
        "lib/commands/trust/github.js"
        "lib/commands/trust/gitlab.js"
        "lib/commands/trust/index.js"
        "lib/commands/trust/list.js"
        "lib/commands/trust/revoke.js"
        "lib/trust-cmd.js"
        "node_modules/glob/dist/commonjs/index.min.js"
        "node_modules/glob/dist/esm/index.min.js"
        "node_modules/isexe/LICENSE.md"
        "node_modules/isexe/dist/commonjs/index.js"
        "node_modules/isexe/dist/commonjs/index.min.js"
        "node_modules/isexe/dist/commonjs/options.js"
        "node_modules/isexe/dist/commonjs/package.json"
        "node_modules/isexe/dist/commonjs/posix.js"
        "node_modules/isexe/dist/commonjs/win32.js"
        "node_modules/isexe/dist/esm/index.js"
        "node_modules/isexe/dist/esm/index.min.js"
        "node_modules/isexe/dist/esm/options.js"
        "node_modules/isexe/dist/esm/package.json"
        "node_modules/isexe/dist/esm/posix.js"
        "node_modules/isexe/dist/esm/win32.js"
    )

    for file in "${known_conflicts[@]}"; do
        if [[ -e "$npm_base/$file" ]]; then
            conflict_files+=("$npm_base/$file")
        fi
    done

    if [[ ${#conflict_files[@]} -eq 0 ]]; then
        return 0
    fi

    # Conflicts found - prompt user
    warn "Found ${#conflict_files[@]} conflicting npm files in filesystem"
    printf '\n%s\n' "Conflicting files:"
    printf '  %s\n' "${conflict_files[@]}"
    printf '\n'

    read -p "Remove these files before updating? [Y/n]: " -r response
    response="${response:=y}"

    if [[ "$response" =~ ^[Yy]$ ]]; then
        info "Removing conflicting npm files"
        if sudo rm -f "${conflict_files[@]}" >> "$LOG_FILE" 2>&1; then
            ok
            echo "Removed ${#conflict_files[@]} conflicting files" >> "$LOG_FILE"
        else
            fail "Failed to remove some conflicting files"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}Failed to remove all conflicting npm files\n"
            ERRORS_OCCURRED=1
        fi
    else
        warn "Proceeding with conflicting files present (may cause transaction to fail)"
        echo "User chose to skip npm conflict removal" >> "$LOG_FILE"
    fi
}

# Refresh waybar cache (Arch only)
refresh_waybar() {
    if [[ "$DISTRO" != "arch" ]]; then
        return 0
    fi

    if command -v yay-waybar.sh >/dev/null 2>&1; then
        info "Refreshing Waybar status"
        yay-waybar.sh cache-clear >> "$LOG_FILE" 2>&1 || warn "Failed to refresh Waybar"
        ok
    fi
}

# Main update logic
main() {
    echo -en "\n**** UPDATE START **** \n\n $(date)\n\n" >> "$LOG_FILE"

    clear
    header "Groot System Update"
    printf "Distro: %s\n" "$DISTRO"
    printf "Log:    %s\n\n" "$LOG_FILE"

    # Acquire lock
    if ! acquire_lock; then
        fail "Another update is already running. Please wait or check the lock file: $LOCK_FILE"
        echo "Failed to acquire lock at $(date)" >> "$LOG_FILE"
        exit 1
    fi

    trap release_lock EXIT

    # Pre-flight checks
    case "$DISTRO" in
        arch)
            if ! command -v yay >/dev/null 2>&1; then
                fail "yay not found"
                echo "ERROR: yay not installed at $(date)" >> "$LOG_FILE"
                exit 1
            fi
            ;;
        ubuntu|debian)
            # apt is typically in /usr/bin
            if ! command -v apt >/dev/null 2>&1; then
                fail "apt not found"
                echo "ERROR: apt not found at $(date)" >> "$LOG_FILE"
                exit 1
            fi
            ;;
        *)
            fail "Unsupported distro: $DISTRO"
            echo "ERROR: Unsupported distro '$DISTRO' at $(date)" >> "$LOG_FILE"
            exit 1
            ;;
    esac

    # Phase 1: Global npm updates (before system updates)
    header "Phase 1: Global npm Updates"
    update_npm

    # Phase 2: Check for npm conflicts (Arch only, before pacman touches anything)
    if [[ "$DISTRO" == "arch" ]]; then
        header "Phase 2: npm Conflict Detection"
        handle_npm_conflicts
    fi

    # Phase 3: System updates
    header "Phase 3: System Package Updates"

    if [[ "$DISTRO" == "arch" ]]; then
        info "Updating packages (yay)"
        if yay -Syu --noconfirm >> "$LOG_FILE" 2>&1; then
            ok
        else
            fail "yay update failed"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}System package update (yay -Syu) failed\n"
            ERRORS_OCCURRED=1
        fi

        info "Cleaning up"
        if yay -Yc --noconfirm >> "$LOG_FILE" 2>&1; then
            ok
        else
            warn "yay cleanup had issues (non-blocking)"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}yay cleanup had issues (non-blocking)\n"
        fi
    elif [[ "$DISTRO" == "ubuntu" || "$DISTRO" == "debian" ]]; then
        info "Updating package lists"
        if sudo apt update >> "$LOG_FILE" 2>&1; then
            ok
        else
            fail "apt update failed"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}apt update failed\n"
            ERRORS_OCCURRED=1
        fi

        info "Upgrading packages"
        if sudo apt upgrade -y >> "$LOG_FILE" 2>&1; then
            ok
        else
            fail "apt upgrade failed"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}apt upgrade failed\n"
            ERRORS_OCCURRED=1
        fi

        info "Removing unused packages"
        if sudo apt autoremove -y >> "$LOG_FILE" 2>&1; then
            ok
        else
            warn "apt autoremove had issues (non-blocking)"
            SYSTEM_ERRORS="${SYSTEM_ERRORS}apt autoremove had issues (non-blocking)\n"
        fi
    fi

    # Phase 4: Refresh Waybar
    if [[ "$DISTRO" == "arch" ]]; then
        header "Phase 4: Refresh Status Bar"
        refresh_waybar
    fi

    # Final summary
    echo -en "\n**** UPDATE END **** \n\n $(date)\n\n" >> "$LOG_FILE"

    header "Update Summary"

    if [[ $ERRORS_OCCURRED -eq 0 ]]; then
        printf '\n\033[1;32mAll updates completed successfully!\033[0m\n\n'
        exit 0
    else
        printf '\n\033[1;31mUpdates completed with errors:\033[0m\n'
        if [[ -n "$NPM_ERRORS" ]]; then
            printf '\n\033[1;33mNPM Issues:\033[0m\n'
            printf '%b' "$NPM_ERRORS"
        fi
        if [[ -n "$SYSTEM_ERRORS" ]]; then
            printf '\n\033[1;33mSystem Update Issues:\033[0m\n'
            printf '%b' "$SYSTEM_ERRORS"
        fi
        printf '\nSee full log: %s\n\n' "$LOG_FILE"
        exit 1
    fi
}

main "$@"
