# Script: update
# Purpose: System package updater (yay/apt)
# Dependencies: yay or apt
# Author: groot
# Modified: 2026-01-24

set -euo pipefail

# Colors
BOLD='\033[1m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Status helpers
header() {
    printf '\n\033[1m%s\033[0m\n' "$1"
    printf '%s\n' "─────────────"
}
info()   { printf '\033[1;34m==>\033[0m %s ' "$1"; }
ok()     { printf '\033[1;32m✓\033[0m\n'; }
fail()   { printf '\033[1;31m✗\033[0m %s\n' "$1"; }
warn()   { printf '\033[1;33m⚠\033[0m %s\n' "$1"; }

# Spinner
spin() {
    local pid=$1 msg=$2
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    while kill -0 "$pid" 2>/dev/null; do
        for (( i=0; i<${#frames}; i++ )); do
            printf '\r\033[1;34m%s\033[0m %s' "${frames:$i:1}" "$msg"
            sleep 0.1
        done
    done
    printf '\r'
}

# Ensure log directory exists
LOG_FILE="$HOME/.local/log/updater.log"
mkdir -p "$(dirname "$LOG_FILE")"

# Detect distro
if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO="$ID"
else
    DISTRO="unknown"
fi

echo -en "\n**** UPDATE **** \n\n $(date)\n\n" >> "$LOG_FILE"

clear
header "Groot System Update"
printf "Distro: %s\n" "$DISTRO"
printf "Log:    %s\n\n" "$LOG_FILE"

if [[ "$DISTRO" == "arch" ]]; then
    info "Updating packages"
    yay -Syu --noconfirm >> "$LOG_FILE" 2>&1 &
    spin $! "Updating packages..."
    ok

    info "Cleaning up"
    yay -Yc --noconfirm >> "$LOG_FILE" 2>&1 &
    spin $! "Cleaning up..."
    ok
elif [[ "$DISTRO" == "ubuntu" || "$DISTRO" == "debian" ]]; then
    info "Updating package lists"
    sudo apt update >> "$LOG_FILE" 2>&1 &
    spin $! "Updating package lists..."
    ok

    info "Upgrading packages"
    sudo apt upgrade -y >> "$LOG_FILE" 2>&1 &
    spin $! "Upgrading packages..."
    ok

    info "Removing unused packages"
    sudo apt autoremove -y >> "$LOG_FILE" 2>&1 &
    spin $! "Removing unused packages..."
    ok
else
    fail "Unsupported distro: $DISTRO"
    exit 1
fi

printf '\n\033[1;32mComplete!\033[0m\n'
