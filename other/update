set -euo pipefail

# Colors (Standardized based on wallctl/colors.sh)
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export CYAN='\033[0;36m'
export MAGENTA='\033[0;35m'
export WHITE='\033[0;37m'
export RESET='\033[0m'
export NC='\033[0m'

export LIGHT_RED='\033[1;31m'
export LIGHT_GREEN='\033[1;32m'
export LIGHT_BLUE='\033[1;34m'
export LIGHT_CYAN='\033[1;36m'
export LIGHT_MAGENTA='\033[1;35m'

export BOLD='\033[1m'
export DIM='\033[2m'

# State tracking
ERRORS_OCCURRED=0
NPM_ERRORS=""
PIP_ERRORS=""
SYSTEM_ERRORS=""
NPM_REINSTALL_REQUIRED=0

# Status helpers
print_logo() {
    printf "${BOLD}${BLUE}  ▄████  ██▀███   ▒█████   ▒█████  ▄▄▄█████▓${RESET}\n"
    printf "${BOLD}${CYAN} ██▒ ▀█▒▓██ ▒ ██▒▒██▒  ██▒▒██▒  ██▒▓  ██▒ ▓▒${RESET}\n"
    printf "${CYAN}▒██░▄▄▄░▓██ ░▄█ ▒▒██░  ██▒▒██░  ██▒▒ ▓██░ ▒░${RESET}\n"
    printf "${LIGHT_CYAN}░▓█  ██▓▒██▀▀█▄  ▒██   ██░▒██   ██░░ ▓██▓ ░${RESET}\n"
    printf "${LIGHT_CYAN}░▒▓███▀▒░██▓ ▒██▒░ ████▓▒░░ ████▓▒░  ▒██▒ ░${RESET}\n"
    printf "${LIGHT_BLUE} ░▒   ▒ ░ ▒▓ ░▒▓░░ ▒░▒░▒░ ░ ▒░▒░▒░   ▒ ░░   ${RESET}\n"
    printf "${LIGHT_BLUE}  ░   ░   ░▒ ░ ▒░  ░ ▒ ▒░   ░ ▒ ▒░     ░    ${RESET}\n"
    printf "${LIGHT_MAGENTA}░ ░   ░   ░░   ░ ░ ░ ░ ▒  ░ ░ ░ ▒    ░      ${RESET}\n"
