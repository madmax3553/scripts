}

header() {
    printf '\n%b%s%b\n' "${BOLD}${BLUE}" "$1" "${RESET}"
    printf '%s\n' "─────────────"
}
info()   { printf '%b==>%b %s ' "${BOLD}${BLUE}" "${RESET}" "$1"; }
ok()     { printf '%b✓%b\n' "${BOLD}${GREEN}" "${RESET}"; }
fail()   { printf '%b✗%b %s\n' "${BOLD}${RED}" "${RESET}" "$1"; }
warn()   { printf '%b⚠%b %s\n' "${BOLD}${YELLOW}" "${RESET}" "$1"; }

# Braille Spinner Helper
run_with_spinner() {
    local msg="$1"
    shift
    local pid

    # Run command in background, redirect output to log
    ("$@") >> "$LOG_FILE" 2>&1 &
    pid=$!

    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    printf "%b==>%b %s " "${BOLD}${BLUE}" "${RESET}" "$msg"

    while kill -0 "$pid" 2>/dev/null; do
        for (( i=0; i<${#frames}; i++ )); do
            printf "%b%s%b" "${BOLD}${CYAN}" "${frames:$i:1}" "${RESET}"
            sleep 0.1
            printf "\b"
            if ! kill -0 "$pid" 2>/dev/null; then break; fi
        done
    done

    wait "$pid"
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        ok
    else
        fail "Failed"
    fi
    return $exit_code
}

# Lock file management
LOCK_DIR="/run/user/$(id -u)"
LOCK_FILE="${LOCK_DIR}/update.lock"
LOCK_FD=200

acquire_lock() {
    mkdir -p "$LOCK_DIR"
    eval "exec $LOCK_FD>'$LOCK_FILE'"
    if ! flock -n "$LOCK_FD" 2>/dev/null; then
        return 1
    fi
    return 0
}

release_lock() {
    flock -u "$LOCK_FD" 2>/dev/null || true
    eval "exec $LOCK_FD>&-" 2>/dev/null || true
}

LOG_FILE="$HOME/.local/log/updater.log"
mkdir -p "$(dirname "$LOG_FILE")"

if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO="$ID"
else
    DISTRO="unknown"
fi

# ------------------------------------------------------------------
# Update Functions
# ------------------------------------------------------------------

update_mirrors() {
    if [[ "$DISTRO" != "arch" ]]; then return 0; fi
    header "Phase: Update Mirrors (reflector)"

    if ! command -v reflector >/dev/null 2>&1; then
        warn "reflector not found"
        return 0
    fi

    if find /etc/pacman.d/mirrorlist -mtime +7 | grep -q .; then
        run_with_spinner "Mirrorlist is old. Updating mirrors..." \
            sudo reflector --country 'United States' --latest 20 --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
    else
        info "Mirrorlist is recent, skipping. Use 'update --mirrors' to force.\n"
    fi
}

update_npm() {
    header "Phase: Global npm Packages"
    if ! command -v npm >/dev/null 2>&1; then return 0; fi

    if ! command -v ncu >/dev/null 2>&1; then
        run_with_spinner "Installing npm-check-updates..." sudo npm install -g npm-check-updates
    fi

    local outdated
    info "Checking for outdated global packages... "
    # We use a temp file because capturing output and spinner together is tricky
    local tmp_outdated=$(mktemp)
    (ncu -g --reject "npm,corepack,node-gyp" > "$tmp_outdated" 2>&1) &
    local pid=$!

    # Simple inline spinner for this capture
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    while kill -0 "$pid" 2>/dev/null; do
        for (( i=0; i<${#frames}; i++ )); do
            printf "%b%s%b\b" "${BOLD}${CYAN}" "${frames:$i:1}" "${RESET}"; sleep 0.1
        done
    done
    wait "$pid"
    outdated=$(cat "$tmp_outdated")
    rm "$tmp_outdated"

    if [[ "$outdated" == *"All global packages are up-to-date"* ]] || [[ -z "$outdated" ]]; then
        ok
        return 0
    fi

    printf "\n%s\n" "$outdated"

    local packages
    packages=$(ncu -g --reject "npm,corepack,node-gyp" --jsonUpgraded | jq -r 'keys[]' 2>/dev/null || true)

    for pkg in $packages; do
        run_with_spinner "Updating $pkg..." sudo npm install -g "$pkg@latest" || {
            NPM_ERRORS="${NPM_ERRORS}Failed to update $pkg\n"
            ERRORS_OCCURRED=1
        }
    done
}

handle_npm_conflicts() {
    if [[ "$DISTRO" != "arch" ]]; then return 0; fi
    header "Phase: npm Conflict Detection"
    local npm_base="/usr/lib/node_modules/npm"
    local conflict_files=()
    local known_conflicts=(
        "docs/content/commands/npm-get.md" "docs/content/commands/npm-ll.md" "docs/content/commands/npm-set.md"
        "docs/content/commands/npm-trust.md" "docs/output/commands/npm-get.html" "docs/output/commands/npm-ll.html"
        "docs/output/commands/npm-set.html" "docs/output/commands/npm-trust.html" "lib/commands/trust/github.js"
        "lib/commands/trust/gitlab.js" "lib/commands/trust/index.js" "lib/commands/trust/list.js"
        "lib/commands/trust/revoke.js" "lib/trust-cmd.js" "node_modules/glob/dist/commonjs/index.min.js"
        "node_modules/glob/dist/esm/index.min.js" "node_modules/isexe/LICENSE.md" "node_modules/isexe/dist/commonjs/index.js"
        "node_modules/isexe/dist/commonjs/index.min.js" "node_modules/isexe/dist/commonjs/options.js"
        "node_modules/isexe/dist/commonjs/package.json" "node_modules/isexe/dist/commonjs/posix.js"
        "node_modules/isexe/dist/commonjs/win32.js" "node_modules/isexe/dist/esm/index.js"
        "node_modules/isexe/dist/esm/index.min.js" "node_modules/isexe/dist/esm/options.js"
        "node_modules/isexe/dist/esm/package.json" "node_modules/isexe/dist/esm/posix.js"
        "node_modules/isexe/dist/esm/win32.js"
    )

    for file in "${known_conflicts[@]}"; do
        if [[ -e "$npm_base/$file" ]]; then conflict_files+=("$npm_base/$file"); fi
    done

    if [[ ${#conflict_files[@]} -eq 0 ]]; then return 0; fi

    warn "Found ${#conflict_files[@]} conflicting npm files"
    run_with_spinner "Removing conflicting files..." sudo rm -rf "${conflict_files[@]}" && NPM_REINSTALL_REQUIRED=1 || {
        SYSTEM_ERRORS="${SYSTEM_ERRORS}Failed to remove conflicting npm files\n"
        ERRORS_OCCURRED=1
    }
}

update_python() {
    header "Phase: Python (pip) Packages"
    if ! command -v pip >/dev/null 2>&1; then return 0; fi

    local packages
    info "Checking for outdated pip packages... "
    local tmp_pip=$(mktemp)
    (python -m pip list --outdated --format=json | jq -r '.[].name' > "$tmp_pip" 2>/dev/null) &
    local pid=$!
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    while kill -0 "$pid" 2>/dev/null; do
        for (( i=0; i<${#frames}; i++ )); do
            printf "%b%s%b\b" "${BOLD}${CYAN}" "${frames:$i:1}" "${RESET}"; sleep 0.1
        done
    done
    wait "$pid"
    packages=$(cat "$tmp_pip")
    rm "$tmp_pip"

    if [[ -z "$packages" ]]; then ok; printf "All pip packages are up-to-date.\n"; return 0; fi
    ok

    for pkg in $packages; do
        # Skip if the package is managed by pacman (prevents externally-managed-environment errors)
        if pacman -Qs "python-$pkg" >/dev/null 2>&1 || pacman -Qs "$pkg" | grep -q "local/python-$pkg"; then
            echo "Skipping system-managed package: $pkg" >> "$LOG_FILE"
            continue
        fi

        run_with_spinner "Updating $pkg..." python -m pip install -U --user "$pkg" || \
            PIP_ERRORS="${PIP_ERRORS}Failed to update pip package: $pkg\n"
    done
}

update_rust() {
    header "Phase: Rust (rustup)"
    if command -v rustup >/dev/null 2>&1; then
        run_with_spinner "Updating rust toolchain..." rustup update
    fi
}

update_flatpak() {
    header "Phase: Flatpak"
    if command -v flatpak >/dev/null 2>&1; then
        run_with_spinner "Updating flatpaks..." flatpak update -y
        run_with_spinner "Removing unused runtimes..." flatpak uninstall --unused -y
    fi
}

refresh_waybar() {
    if [[ "$DISTRO" != "arch" ]]; then return 0; fi
    header "Phase: Refresh Status Bar"
    if command -v yay-waybar.sh >/dev/null 2>&1; then
        run_with_spinner "Clearing Waybar cache..." yay-waybar.sh cache-clear
    fi
}

# ------------------------------------------------------------------
# Main Logic
# ------------------------------------------------------------------

main() {
    echo -en "\n**** UPDATE START **** \n\n $(date)\n\n" >> "$LOG_FILE"
    clear
    print_logo
    header "Groot System Update"
    printf "Distro: %s\n" "$DISTRO"
    printf "Log:    %s\n" "$LOG_FILE"

    if ! acquire_lock; then fail "Update already running"; exit 1; fi
    trap release_lock EXIT

    if [[ "${1:-}" == "--mirrors" ]]; then
        run_with_spinner "Forcing mirror update..." sudo reflector --country 'United States' --latest 20 --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
    fi

    update_mirrors
    update_npm
    handle_npm_conflicts

    header "Phase: System Package Updates"
    if [[ "$DISTRO" == "arch" ]]; then
        info "Updating system (yay)..."
        # We DON'T use spinner here because yay is interactive
        if yay -Syyu --noconfirm; then
            ok
        else
            fail "System update failed"; SYSTEM_ERRORS="${SYSTEM_ERRORS}yay -Syu failed\n"; ERRORS_OCCURRED=1
        fi

        run_with_spinner "Cleaning up orphans..." yay -Yc --noconfirm
        if [[ $NPM_REINSTALL_REQUIRED -eq 1 ]]; then
            run_with_spinner "Restoring npm integrity..." sudo pacman -S --noconfirm npm
        fi
    fi

    update_python
    update_rust
    update_flatpak
    refresh_waybar

    header "Summary"
    if [[ $ERRORS_OCCURRED -eq 0 && -z "$PIP_ERRORS" ]]; then
        printf '\n%b✓ All systems updated successfully!%b\n\n' "${BOLD}${GREEN}" "${RESET}"
    else
        printf '\n%b✗ Updates completed with issues:%b\n' "${BOLD}${RED}" "${RESET}"
        [[ -n "$NPM_ERRORS" ]] && printf '%bNPM:%b\n%b' "${BOLD}${YELLOW}" "${RESET}" "$NPM_ERRORS"
        [[ -n "$PIP_ERRORS" ]] && printf '%bPython/Pip:%b\n%b' "${BOLD}${YELLOW}" "${RESET}" "$PIP_ERRORS"
        [[ -n "$SYSTEM_ERRORS" ]] && printf '%bSystem:%b\n%b' "${BOLD}${YELLOW}" "${RESET}" "$SYSTEM_ERRORS"
        printf '\nCheck log: %s\n\n' "$LOG_FILE"
        [[ $ERRORS_OCCURRED -eq 1 ]] && exit 1
    fi
}

main "$@"
